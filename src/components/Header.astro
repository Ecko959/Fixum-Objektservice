---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { navItems, site, telUrl } from "../data/site";
import { serviceMenuGroups } from "../data/serviceMenu";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  if (href.startsWith("/#")) return false;
  const clean = href.replace(/\/+$/, "") || "/";
  return clean === currentPath;
};

const navBeforeServices = navItems.filter(
  (item) => item.label === "Startseite",
);
const navAfterServices = navItems.filter(
  (item) => !["Startseite", "Leistungen"].includes(item.label),
);
const servicesActive = serviceMenuGroups.some((group) =>
  group.items.some((item) => isActive(item.href)),
);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} - zur Startseite`}>
      {
        /* Original-Lockup statt nachgebautem Schriftzug - beschnittene Fassung,
          damit sich das Logo an der Höhe der Kopfleiste ausrichten lässt. */
      }
      <img
        src="/logo/fixum-lockup-blue-trim.png"
        alt={site.name}
        width="720"
        height="161"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {
        navBeforeServices.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <div class="mega-wrap" data-mega>
        <span class="mega-head">
          <a
            href="/leistungen/"
            class="nav-link"
            aria-current={servicesActive ? "page" : undefined}>Leistungen</a
          >
          <button
            type="button"
            class="mega-toggle"
            aria-expanded="false"
            aria-controls="leistungsmenue"
            data-mega-toggle
          >
            <span class="sr-only">Leistungsmenü öffnen</span>
            <span class="chevron" aria-hidden="true"></span>
          </button>
        </span>

        <div class="mega-menu" id="leistungsmenue" data-mega-panel>
          <div class="mega-grid">
            {
              serviceMenuGroups.map((group) => (
                <div class="mega-col">
                  <p class="mega-title">{group.title}</p>
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                    >
                      <strong>{item.label}</strong>
                      <span>{item.description}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
          <p class="mega-foot">
            <a href="/leistungen/" class="arrow-link">Alle Leistungen ansehen</a
            >
          </p>
        </div>
      </div>

      {
        navAfterServices.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={telUrl}>
        <Icon name="phone" size={18} />
        <span>{site.phoneDisplay}</span>
      </a>
      <Button href="/kontakt/" class="header-cta">Festpreis anfragen</Button>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="bars" aria-hidden="true"
        ><span></span><span></span><span></span></span
      >
      <span class="sr-only">Menü öffnen</span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <nav class="mobile-nav" aria-label="Mobile Navigation">
      {
        navBeforeServices.map((item) => (
          <a class="mobile-link" href={item.href}>
            {item.label}
          </a>
        ))
      }

      <details class="mobile-services" open>
        <summary>Leistungen</summary>
        <div class="mobile-service-groups">
          {
            serviceMenuGroups.map((group) => (
              <div>
                <p class="mega-title">{group.title}</p>
                {group.items.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
            ))
          }
          <a class="arrow-link mobile-all" href="/leistungen/">
            Alle Leistungen
          </a>
        </div>
      </details>

      {
        navAfterServices.map((item) => (
          <a class="mobile-link" href={item.href}>
            {item.label}
          </a>
        ))
      }

      <div class="mobile-cta">
        <Button href={telUrl} icon="phone">Anrufen</Button>
        <Button href="/kontakt/" variant="secondary">Festpreis anfragen</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const mega = document.querySelector<HTMLElement>("[data-mega]");
  const megaToggle =
    mega?.querySelector<HTMLButtonElement>("[data-mega-toggle]");

  /* Scroll-Zustand über rAF entkoppeln, damit das Scrollen flüssig bleibt. */
  let ticking = false;
  const syncHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
    ticking = false;
  };
  syncHeader();
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(syncHeader);
    },
    { passive: true },
  );

  /* ---- Mobiles Menü ---- */
  const setMenu = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.classList.toggle("is-open", open);
    menu.classList.toggle("is-open", open);
    document.body.classList.toggle("menu-open", open);
    if (open) {
      menu.hidden = false;
    } else {
      // Erst nach der Transition ausblenden, sonst springt das Panel weg.
      window.setTimeout(() => {
        if (!menu.classList.contains("is-open")) menu.hidden = true;
      }, 240);
    }
  };

  toggle?.addEventListener("click", () => {
    setMenu(toggle.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  /* ---- Mega-Menü ---- */
  const setMega = (open: boolean) => {
    if (!mega || !megaToggle) return;
    mega.classList.toggle("is-open", open);
    megaToggle.setAttribute("aria-expanded", String(open));
  };

  megaToggle?.addEventListener("click", () => {
    setMega(megaToggle.getAttribute("aria-expanded") !== "true");
  });

  // Zeigergesteuerte Öffnung nur für Geräte mit echtem Hover.
  if (window.matchMedia("(hover: hover)").matches) {
    mega?.addEventListener("mouseenter", () => setMega(true));
    mega?.addEventListener("mouseleave", () => setMega(false));
  }

  mega?.addEventListener("focusout", (event) => {
    const next = (event as FocusEvent).relatedTarget as Node | null;
    if (!next || !mega.contains(next)) setMega(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (mega?.classList.contains("is-open")) {
      setMega(false);
      megaToggle?.focus();
    }
    if (menu?.classList.contains("is-open")) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--ink);
    padding-top: 18px;
    transition: padding var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled {
    padding-top: 8px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    min-height: 74px;
    padding: 8px 8px 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    transition:
      min-height var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .is-scrolled .header-inner {
    min-height: 64px;
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-lg);
  }

  /* ---- Marke ---- */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur) var(--ease-out);
  }

  /* Höhe führt, Breite folgt dem Seitenverhältnis des Lockups. */
  .brand img {
    width: auto;
    height: 44px;
    transition: height var(--dur) var(--ease-out);
  }

  .is-scrolled .brand img {
    height: 37px;
  }

  .brand:hover {
    opacity: 0.85;
  }

  /* ---- Desktop-Navigation ---- */
  .desktop-nav {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.125rem, 0.8vw, 0.5rem);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 0.7rem;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
    transition: color var(--dur) var(--ease-out);
  }

  /* Unterstreichung wächst aus der Mitte */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--blue);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after,
  .mega-wrap.is-open .nav-link::after {
    transform: scaleX(1);
  }

  .mega-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .mega-head {
    display: inline-flex;
    align-items: center;
  }

  .mega-toggle {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-left: -4px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--navy);
    cursor: pointer;
  }

  .chevron {
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease-out);
  }

  .mega-wrap.is-open .mega-toggle {
    color: var(--blue);
  }

  .mega-wrap.is-open .chevron {
    transform: rotate(-135deg);
    margin-top: 3px;
  }

  .mega-menu {
    position: absolute;
    left: 50%;
    top: calc(100% + 14px);
    width: min(940px, calc(100vw - var(--gutter) * 2));
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(10px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  .mega-wrap.is-open .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .mega-col {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 14px;
    border-radius: var(--radius-lg);
    background: var(--mist-soft);
  }

  .mega-title {
    margin-bottom: 6px;
    font-family: var(--font-utility);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .mega-col a {
    display: grid;
    gap: 2px;
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    transition:
      background var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .mega-col a:hover,
  .mega-col a[aria-current="page"] {
    background: #fff;
    box-shadow: var(--shadow-xs);
    transform: translateX(2px);
  }

  .mega-col strong {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--navy);
  }

  .mega-col span {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .mega-foot {
    margin-top: 12px;
    padding: 0 4px 4px;
    text-align: center;
  }

  /* ---- Aktionen rechts ---- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-utility);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--navy);
    white-space: nowrap;
    transition: color var(--dur) var(--ease-out);
  }

  .header-phone:hover {
    color: var(--blue);
  }

  @media (min-width: 1180px) {
    .header-phone {
      display: inline-flex;
    }
  }

  .header-actions :global(.header-cta) {
    min-height: 46px;
    padding: 0.75rem 1.35rem;
    font-size: 0.875rem;
  }

  /* ---- Burger ---- */
  .menu-toggle {
    display: none;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--navy-deep);
    cursor: pointer;
  }

  .bars {
    display: grid;
    gap: 5px;
  }

  .bars span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .menu-toggle.is-open .bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle.is-open .bars span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.is-open .bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobiles Panel ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: calc(var(--header-h) + 24px) var(--gutter)
      calc(2rem + env(safe-area-inset-bottom));
    background:
      radial-gradient(
        90% 60% at 50% 0%,
        rgba(31, 122, 224, 0.25),
        transparent 70%
      ),
      var(--navy-deep);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: none;
  }

  .mobile-nav {
    display: grid;
    gap: 0.5rem;
  }

  .mobile-link,
  .mobile-services summary {
    display: block;
    padding: 0.85rem 1rem;
    border: 1px solid var(--on-dark-hairline);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .mobile-services {
    border-radius: var(--radius-md);
  }

  .mobile-services summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-services summary::-webkit-details-marker {
    display: none;
  }

  .mobile-services summary::after {
    content: "";
    float: right;
    width: 8px;
    height: 8px;
    margin-top: 10px;
    border-right: 2px solid var(--blue-light);
    border-bottom: 2px solid var(--blue-light);
    transform: rotate(45deg);
  }

  .mobile-services[open] summary::after {
    transform: rotate(-135deg);
    margin-top: 14px;
  }

  .mobile-service-groups {
    display: grid;
    gap: 1rem;
    padding: 1rem 0.5rem 0.25rem;
  }

  .mobile-service-groups .mega-title {
    margin-bottom: 0.4rem;
    color: var(--blue-light);
  }

  .mobile-service-groups a {
    display: block;
    padding: 0.4rem 0;
    color: var(--on-dark-soft);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .mobile-all {
    color: var(--amber) !important;
    margin-top: 0.5rem;
  }

  .mobile-cta {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (max-width: 1024px) {
    .desktop-nav,
    .header-actions {
      display: none;
    }

    .header-inner {
      justify-content: space-between;
      min-height: 66px;
      padding: 8px 8px 8px 12px;
      border-radius: var(--radius-lg);
    }

    .menu-toggle {
      display: grid;
    }
  }
</style>
