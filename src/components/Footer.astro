---
import Icon from "./Icon.astro";
import WhatsAppMark from "./WhatsAppMark.astro";
import { mailUrl, sameAs, site, telUrl, whatsappUrl } from "../data/site";
import { whatsappThema } from "../data/whatsapp";

/* Betreff je Seite - siehe src/data/whatsapp.ts. */
const waThema = whatsappThema(Astro.url.pathname);
import { serviceMenuGroups } from "../data/serviceMenu";
import { findeStadt } from "../data/staedte";

const year = new Date().getFullYear();

const legalLinks = [
  ["Impressum", "/impressum/"],
  ["Datenschutz", "/datenschutz/"],
  ["AGB", "/agb/"],
  ["Widerrufsbelehrung", "/widerruf/"],
  ["Kontakt", "/kontakt/"],
];

const companyLinks = [
  ["Über uns", "/ueber-uns/"],
  ["Alle Leistungen", "/leistungen/"],
  ["Einsatzgebiet", "/einsatzgebiet/"],
  ["Für Hausverwaltungen", "/fuer-hausverwaltungen/"],
  ["Für Bauunternehmen", "/fuer-bauunternehmen/"],
];

/* Alle Leistungen statt der ersten acht: Eine unvollständige Liste im Footer
   lässt fünf Seiten ohne sitewide-Link stehen - genau die, die ihn am
   nötigsten hätten. */
const footerServices = serviceMenuGroups.flatMap((group) => group.items);

/* Nur fünf Orte statt der ganzen Liste.
   Die vollständige Aufstellung steht im Einsatzgebiet-Abschnitt der Seite;
   sie ein zweites Mal in die Fußzeile zu setzen, wiederholt auf jeder Seite
   denselben Block, ohne etwas hinzuzufügen. Der Link auf die Übersicht führt
   zu allen übrigen Orten. */
const hauptorte = ["aurich", "leer", "norden", "moormerland", "krummhoern"];
const gebiet = hauptorte
  .map((slug) => findeStadt(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .map((s) => ({ name: s.kurzName ?? s.name, href: `/einsatzgebiet/${s.slug}/` }));
---

<footer class="footer">
  <div class="footer-glow" aria-hidden="true"></div>

  <div class="container footer-grid">
    <div class="footer-brand">
      <img
        src="/logo/fixum-lockup-white-trim.png"
        alt={site.name}
        width="720"
        height="168"
        loading="lazy"
        decoding="async"
      />
      <p class="script">{site.claim}</p>
      <p class="footer-text">
        Fixum Objektservice verbindet Räumung, Rückbau, Trockenbau und Montage
        zu einem Ablauf - für private Auftraggeber, Hausverwaltungen und
        Bauunternehmen in Emden und Ostfriesland.
      </p>

      {
        /* Adressblock maschinenlesbar: identische NAP-Daten wie im Impressum. */
      }
      <address class="footer-address">
        <strong>{site.name}</strong>
        <span>{site.street}</span>
        <span>{site.zip} {site.city}</span>
      </address>
    </div>

    <nav class="footer-col" aria-labelledby="footer-leistungen">
      <h2 class="footer-title" id="footer-leistungen">Leistungen</h2>
      {footerServices.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <nav class="footer-col" aria-labelledby="footer-unternehmen">
      <h2 class="footer-title" id="footer-unternehmen">Unternehmen</h2>
      {companyLinks.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="footer-col">
      <h2 class="footer-title">Kontakt</h2>
      <a class="footer-contact" href={telUrl}>
        <Icon name="phone" size={18} />
        <span>{site.phoneDisplay}</span>
      </a>
      <a
        class="footer-contact"
        href={whatsappUrl(waThema)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppMark size={20} />
        <span>WhatsApp schreiben</span>
      </a>
      <a class="footer-contact" href={mailUrl}>
        <Icon name="mail" size={18} />
        <span>{site.email}</span>
      </a>
      <p class="footer-contact footer-contact--static">
        <Icon name="clock" size={18} />
        <span>{site.hours}</span>
      </p>
      <p class="footer-contact footer-contact--static">
        <Icon name="pin" size={18} />
        <span>{site.city} + {site.radiusKm} km Umkreis</span>
      </p>

      {
        sameAs.length > 0 && (
          <p class="footer-social">
            {sameAs.map((url) => (
              <a href={url} target="_blank" rel="noopener noreferrer">
                Google Unternehmensprofil
              </a>
            ))}
          </p>
        )
      }
    </div>
  </div>

  <div class="container area-block">
    <h2 class="footer-title">
      <a href="/einsatzgebiet/">Einsatzgebiet</a>
    </h2>
    <ul class="area-list">
      {
        gebiet.map((ort) => (
          <li>
            <a href={ort.href}>{ort.name}</a>
          </li>
        ))
      }
      <li>
        <a href="/einsatzgebiet/">Alle Orte</a>
      </li>
    </ul>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name} · Inhaber {site.owner}</p>
    <nav class="footer-legal" aria-label="Rechtliches">
      {legalLinks.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 2rem;
    color: var(--on-dark-soft);
    background: var(--navy-deep);
  }

  /* Weicher Lichtkegel am oberen Rand */
  .footer-glow {
    position: absolute;
    inset: -40% 0 auto;
    z-index: -1;
    height: 420px;
    background: radial-gradient(
      50% 100% at 50% 0%,
      rgba(31, 122, 224, 0.24),
      transparent 70%
    );
    pointer-events: none;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.15fr;
    gap: clamp(1.75rem, 3.5vw, 3rem);
  }

  .footer-brand img {
    width: min(230px, 100%);
    height: auto;
    margin-bottom: 1rem;
  }

  .footer-text {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .footer-address {
    display: grid;
    gap: 2px;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--on-dark-hairline);
    font-style: normal;
    font-size: 0.9375rem;
  }

  .footer-address strong {
    color: #fff;
  }

  .footer-title {
    margin-bottom: 1rem;
    color: #fff;
    font-family: var(--font-utility);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-col {
    display: grid;
    align-content: start;
    gap: 0.1rem;
  }

  .footer-col a {
    position: relative;
    display: inline-block;
    width: fit-content;
    padding: 0.32rem 0;
    font-size: 0.9375rem;
    transition:
      color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .footer-col a:hover {
    color: #fff;
    transform: translateX(3px);
  }

  .footer-contact {
    display: inline-flex !important;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-contact--static {
    padding: 0.32rem 0;
    font-size: 0.9375rem;
  }

  .footer-contact :global(.icon) {
    color: var(--blue-light);
  }

  .footer-social {
    margin-top: 0.75rem;
  }

  .footer-social a {
    color: var(--amber);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  /* ---- Einsatzgebiet ---- */
  .area-block {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
    border-top: 1px solid var(--on-dark-hairline);
  }

  .area-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .area-list a {
    display: block;
    padding: 0.3rem 0.8rem;
    color: inherit;
  }

  .area-list li {
    overflow: hidden;
    border: 1px solid rgba(79, 160, 245, 0.3);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }

  .area-list li:hover {
    border-color: var(--blue-light);
    background: rgba(79, 160, 245, 0.12);
    color: #fff;
  }

  .footer-title a {
    color: inherit;
  }

  .footer-title a:hover {
    color: var(--blue-light);
  }

  /* ---- Fußzeile ---- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--on-dark-hairline);
    font-size: 0.875rem;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }

  .footer-legal a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
