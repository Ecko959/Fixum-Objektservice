---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { emden, gebiet, ortSeiten } from "../data/orte";

interface Props {
  /** Leistung im Satz, z. B. "Entrümpelung". */
  service?: string;
  title?: string;
}

const { service = "Objektservice", title } = Astro.props;
const heading = title ?? `${service} in Emden und Ostfriesland`;

/* Verlinkt werden nur Orte mit eigener Seite: Emden (Startseite), Leer,
   Norden, Aurich. Alle übrigen Orte stehen als Text - eigene Unterseiten
   für jeden Ort hat Google als Doorway-Muster liegen lassen. */
const alle = gebiet.flatMap((g) => g.orte);
/* Reihenfolge: Emden, dann die Ortsseiten (Leer, Norden, Aurich). */
const mitSeite = [
  { name: emden.name, seite: emden.seite },
  ...ortSeiten.map((o) => ({ name: o.name, seite: `/${o.slug}/` })),
];
const weitere = alle.filter((o) => !o.seite).map((o) => o.name);
const weitereText = `${weitere.slice(0, -1).join(", ")} und ${weitere[weitere.length - 1]}`;
---

<section class="section section--tight area-served">
  <div class="container area-inner">
    <div class="area-copy" data-reveal>
      <p class="eyebrow">Einsatzgebiet</p>
      <h2>{heading}</h2>
      <p class="muted">
        Fixum arbeitet von {site.city} aus in einem Umkreis von bis zu ca. 50 km.
        Anfahrt und Arbeitszeit stehen im Angebot getrennt, damit Sie sehen, was der
        Weg kostet. Größere Projekte fahren wir auf Anfrage auch weiter.
      </p>
      <p class="area-meta">
        <span
          ><Icon name="pin" size={16} />
          {site.street}, {site.zip}
          {site.city}</span
        >
        <span><Icon name="clock" size={16} /> {site.hours}</span>
      </p>
    </div>

    <div class="area-orte" data-reveal>
      <ul class="area-chips">
        {
          mitSeite.map((ort) => (
            <li>
              <a href={ort.seite}>{ort.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="area-weitere">
        Außerdem regelmäßig in {weitereText}.
        <a href="/einsatzgebiet/">Alle Orte im Einsatzgebiet</a>
      </p>
    </div>
  </div>
</section>

<style>
  .area-served {
    background: #fff;
    border-top: 1px solid var(--line);
  }

  /* minmax(0, …): sonst zieht ein langes Kompositum in der Überschrift
     ("Nachunternehmereinsätze") die Spur auf seine min-content-Breite und
     die Sektion laeuft auf schmalen Displays aus dem Viewport. */
  .area-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  .area-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem;
  }

  .area-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.25rem;
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .area-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .area-meta :global(.icon) {
    color: var(--blue);
  }

  .area-orte {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--mist-soft), var(--mist));
  }

  .area-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .area-weitere {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .area-weitere a {
    display: inline-block;
    margin-left: 0.25rem;
    font-weight: 600;
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .area-chips a {
    display: block;
    padding: 0.35rem 0.85rem;
    color: inherit;
  }

  .area-chips li {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--navy);
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .area-chips li:hover {
    transform: translateY(-2px);
    border-color: var(--blue-light);
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .area-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
