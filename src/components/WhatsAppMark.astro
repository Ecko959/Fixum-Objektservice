---
/**
 * WhatsApp-Zeichen als plastische Scheibe.
 *
 * Bewusst das einzige Element auf der Seite mit echter Tiefe: Lichtkante
 * oben, Schattenkante unten, Glanzlicht auf der Wölbung. Der Rest der
 * Oberfläche bleibt flach, sonst wird aus dem Detail eine Spielerei.
 *
 * Das Glyph ist die ausgefüllte Marke - auf einer farbigen Scheibe wirkt
 * der Strich-Umriss aus dem Icon-Satz dünn und verliert die Silhouette.
 */
interface Props {
  /** Durchmesser der Scheibe in Pixeln. */
  size?: number;
  class?: string;
}

const { size = 24, class: className = "" } = Astro.props;

const glyph =
  "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z";
---

<span class={`wa-mark ${className}`.trim()} style={`--wa-size:${size}px`}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d={glyph} fill="currentColor"></path>
  </svg>
</span>

<style>
  .wa-mark {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--wa-size);
    height: var(--wa-size);
    border-radius: var(--radius-pill);
    color: #fff;
    /* Lichtquelle oben links - dieselbe Richtung wie bei den Karten. */
    background: radial-gradient(
      116% 116% at 30% 16%,
      #62ee97 0%,
      #35d066 40%,
      #1cab4d 74%,
      #12833b 100%
    );
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.7),
      inset 0 -1.5px 2px rgba(0, 40, 15, 0.3),
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 2px 6px rgba(18, 131, 59, 0.2);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* Glanzlicht auf der oberen Wölbung */
  .wa-mark::before {
    content: "";
    position: absolute;
    top: 7%;
    left: 12%;
    right: 12%;
    height: 40%;
    border-radius: 50%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.62),
      rgba(255, 255, 255, 0)
    );
    pointer-events: none;
  }

  .wa-mark svg {
    width: 58%;
    height: 58%;
    /* Zeichnet den Umriss leicht in die Scheibe hinein. */
    filter: drop-shadow(0 1px 0.5px rgba(0, 45, 18, 0.35));
  }

  /* Beim Drücken sinkt die Scheibe ein - der einzige Ort auf der Seite,
     an dem sich Tiefe auch anfühlen darf. */
  :global(.btn:active) .wa-mark,
  :global(a:active) > .wa-mark {
    transform: translateY(1px);
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.5),
      inset 0 -1px 1px rgba(0, 40, 15, 0.3),
      0 1px 1px rgba(0, 0, 0, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-mark {
      transition: none;
    }
  }
</style>
