---
/* Fünf gefüllte Sterne, Anteil über `wert` (0–5). Rein dekorativ - die
   Bewertung steht immer zusätzlich als Text daneben. */
interface Props {
  wert?: number;
  size?: number;
  class?: string;
}
const { wert = 5, size = 16, class: cls = "" } = Astro.props;
const voll = Math.max(0, Math.min(5, Math.round(wert)));
const pfad =
  "M12 2.8l2.83 5.73 6.32.92-4.57 4.46 1.08 6.3L12 17.24l-5.66 2.97 1.08-6.3L2.85 9.45l6.32-.92L12 2.8z";
---

<span class={`sterne ${cls}`} aria-hidden="true">
  {
    Array.from({ length: 5 }).map((_, i) => (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        class={i < voll ? "an" : "aus"}
      >
        <path d={pfad} />
      </svg>
    ))
  }
</span>

<style>
  .sterne {
    display: inline-flex;
    gap: 0.12em;
    line-height: 0;
  }
  svg {
    fill: currentColor;
  }
  .aus {
    opacity: 0.25;
  }
</style>
