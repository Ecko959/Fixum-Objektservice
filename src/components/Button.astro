---
import Icon from "./Icon.astro";
import WhatsAppMark from "./WhatsAppMark.astro";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  icon?: "phone" | "whatsapp" | "mail" | "arrow" | "check" | "pin";
  class?: string;
  /** Für externe Ziele (WhatsApp) - setzt rel und target. */
  external?: boolean;
  "aria-label"?: string;
  /** Messpunkt für die Klickmessung, siehe Base.astro (z. B. "angebot"). */
  "data-track"?: string;
  /** Springt zum Anfrageformular (#anfrage) und wählt die Leistung vor,
      z. B. "umzug". Leerer Text: Formular ohne Vorauswahl. */
  cta?: string;
  /** Text, mit dem die Beschreibung im Formular vorbelegt wird. */
  ctaText?: string;
}

const {
  href,
  variant = "primary",
  icon,
  class: className = "",
  external,
  "aria-label": ariaLabel,
  "data-track": track,
  cta,
  ctaText,
} = Astro.props;

const variantClass =
  variant === "secondary"
    ? "btn btn--secondary"
    : variant === "ghost"
      ? "btn btn--ghost"
      : "btn";

/* WhatsApp bekommt die plastische Marke statt des Strich-Icons. */
const isWhatsApp = icon === "whatsapp";

/* WhatsApp-Links öffnen extern; noopener verhindert Zugriff auf window.opener. */
const isExternal = external ?? /^https?:/.test(href);
---

<a
  class={`${variantClass} ${isWhatsApp ? "btn--wa" : ""} ${className}`
    .replace(/\s+/g, " ")
    .trim()}
  href={href}
  aria-label={ariaLabel}
  data-track={track}
  data-cta={cta}
  data-cta-text={ctaText}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  {isWhatsApp && <WhatsAppMark size={24} />}
  {icon && !isWhatsApp && <Icon name={icon} size={18} />}
  <span><slot /></span>
</a>
