---
import Photo from "./Photo.astro";

interface Props {
  title: string;
  text: string;
  href?: string;
  image?: string;
  bullets?: string[];
  large?: boolean;
  /** Erste Reihe eager laden, alles darunter lazy. */
  eager?: boolean;
}

const {
  title,
  text,
  href = "/kontakt/",
  image,
  bullets = [],
  large = false,
  eager = false,
} = Astro.props;
---

<article class={`service-card card card--hover ${large ? "is-large" : ""}`}>
  {
    image && (
      <Photo
        src={image}
        alt={`${title} - Fixum Objektservice in Emden`}
        width={960}
        height={600}
        eager={eager}
        sizes="(max-width: 900px) 100vw, (max-width: 1220px) 45vw, 380px"
        ratio={large ? "16 / 10" : "16 / 9"}
        class="service-photo"
      />
    )
  }

  <div class="service-body">
    <h3>
      {
        /* Stretched Link: die ganze Karte ist klickbar, im DOM bleibt es ein Link. */
      }
      <a href={href} class="service-link">{title}</a>
    </h3>
    <p>{text}</p>

    {
      bullets.length > 0 && (
        <ul class="service-bullets">
          {bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )
    }

    <span class="arrow-link" aria-hidden="true">Mehr erfahren</span>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .service-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .service-card h3 {
    text-wrap: balance;
  }

  /* Der Link deckt die Karte ab, ohne die Semantik zu verändern. */
  .service-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .service-card p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .service-bullets {
    display: grid;
    gap: 0.35rem;
    margin: 0.125rem 0 0;
    padding: 0;
    list-style: none;
  }

  .service-bullets li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    color: var(--navy);
    font-weight: 600;
  }

  .service-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--amber);
  }

  .service-card .arrow-link {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .service-card :global(.photo) {
    border-radius: 0;
  }

  /* Sanftes Heranfahren des Bildes beim Hover der Karte */
  .service-card:hover :global(.photo img) {
    transform: scale(1.04);
  }

  .service-card:hover .arrow-link {
    gap: 0.75rem;
  }

  /* Fokus sichtbar machen, obwohl der Link visuell verdeckt ist */
  .service-card:focus-within {
    outline: 3px solid var(--blue-bright);
    outline-offset: 3px;
  }

  .service-link:focus-visible {
    outline: none;
  }
</style>
