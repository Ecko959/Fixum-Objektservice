---
/* "Was kostet das?" - nur die freigegebenen Ab-Preise aus preise.ts.
   Neben jedem Ab-Preis steht der Hinweis "Richtwert ohne Umsatzsteuer ...".
   Leistungen ohne Ab-Preis zeigen nur "Festpreis nach Besichtigung".

   Eine Position: Text links, Karte rechts. Mehrere Positionen: Karten
   nebeneinander, auf dem Handy untereinander. */
import Button from "./Button.astro";
import {
  festpreisHinweis,
  preise,
  preisHinweis,
  type PreisSchluessel,
  type Preisposition,
} from "../data/preise";

interface Props {
  positionen: PreisSchluessel[];
  /** Einleitung - sachlich, ohne weitere Zahlen. */
  text?: string;
  titel?: string;
  /** Ziel des Rechner-Buttons: "#kalkulator" auf der Seite oder "/preisrechner/". */
  rechner?: string;
  /** Beschriftung des Anfrage-Buttons. */
  anfrageText?: string;
}

const {
  positionen,
  text = "Jedes Objekt ist anders. Deshalb gilt am Ende der Festpreis aus dem Angebot - schriftlich und vor Beginn der Arbeiten.",
  titel = "Was kostet das?",
  rechner,
  anfrageText = "Festpreis anfragen",
} = Astro.props;

const karten = positionen.map((k) => preise[k] as Preisposition);
const mehrere = karten.length > 1;
---

<section
  class:list={["section section--tight preis", mehrere && "preis--karten"]}
  aria-labelledby="preis-title"
>
  <div class="container preis-grid" data-reveal>
    <div class="preis-kopf">
      <p class="eyebrow">Preise</p>
      <h2 id="preis-title">{titel}</h2>
      <p class="muted">{text}</p>
      <div class="btn-row preis-aktionen">
        {
          rechner && (
            <Button href={rechner} icon="arrow" data-track="rechner-link">
              Preis grob berechnen
            </Button>
          )
        }
        <Button
          href="/kontakt/"
          icon="arrow"
          variant={rechner ? "secondary" : "primary"}
          data-track="angebot"
        >
          {anfrageText}
        </Button>
      </div>
    </div>

    <ul class="preis-liste" role="list">
      {
        karten.map((z) => (
          <li class="preis-karte card">
            <p class="preis-leistung">{z.leistung}</p>
            {z.betrag ? (
              <>
                <p class="preis-betrag">{z.betrag}</p>
                <p class="preis-hinweis">{preisHinweis}</p>
              </>
            ) : (
              <p class="preis-fest">{festpreisHinweis}</p>
            )}
            {z.zusatz && <p class="preis-zusatz">{z.zusatz}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .preis-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .preis--karten .preis-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .preis-kopf h2 {
    margin: 0.35rem 0 0.75rem;
  }

  .preis--karten .preis-kopf {
    max-width: var(--measure);
  }

  .preis-aktionen {
    margin-top: 1.25rem;
  }

  .preis-liste {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .preis--karten .preis-liste {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .preis-karte {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 4px solid var(--navy);
  }

  .preis-karte p {
    margin: 0;
  }

  .preis-leistung {
    font-weight: 800;
    color: var(--navy);
  }

  .preis-betrag {
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1.15;
    color: var(--blue);
  }

  .preis-hinweis {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--navy);
  }

  .preis-fest {
    justify-self: start;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-utility);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--navy);
  }

  .preis-zusatz {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .preis-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
