const hinweis: Partial<Record<Leistung, string>> = {
  umzug:
    "Umzugskartons stellen wir auf Wunsch leihweise. Größere Umzüge und Strecken über 100 km kalkulieren wir nach Besichtigung oder Fotos. Küchen ohne Anschlüsse; Steinarbeitsplatten (Granit, Quarz, Keramik) nur montieren, nicht zuschneiden.",
  montage:
    "Ohne Elektro-, Gas- und Wasseranschlüsse. Diese koordinieren wir mit einem Fachbetrieb. Steinarbeitsplatten (Granit, Quarz, Keramik) nur montieren, nicht zuschneiden.",
  boden: "Parkett verlegen, schleifen oder versiegeln bieten wir nicht an.",
};

/* Ohne Grundwerte in der Config wird der Rechner gar nicht ausgegeben. */
const bereit = rechnerBereit(config, leistung);
const paket = bereit ? verpacke(baueModell(config, leistung)) : "";
const p = (name: string) => `${id}-${name}`;
const Tag = eingebettet ? "div" : "section";
---

{
  bereit && (
    <Tag
      id={id}
      class:list={[
        "rechner",
        !eingebettet && "section section--dark section--rechner",
      ]}
      aria-labelledby={`${id}-titel`}
      data-preisrechner={leistung}
      data-m={paket}
      data-thema={thema[leistung]}
      data-wa={site.whatsapp}
    >
      <div class:list={[!eingebettet && "container"]}>
        {!eingebettet && (
          <div class="section-head" data-reveal>
            <p class="eyebrow">Preisrechner</p>
            <h2 id={`${id}-titel`}>{titel}</h2>
            <p class="muted">
              Ein paar Angaben genügen. Sie sehen sofort einen ungefähren Rahmen
              - und können direkt einen Festpreis anfragen.
            </p>
          </div>
        )}
        {eingebettet && (
          <h2 id={`${id}-titel`} class="sr-only">
            {titel}
          </h2>
        )}

        <div class="rechner-grid">
          <form class="rechner-form card" novalidate onsubmit="return false">
            {felder[leistung].map((f) => (
              <div
                class:list={["rf", `rf--${f.typ}`, f.detail && "rf--detail"]}
                data-zeige-wenn={f.zeigeWenn}
                data-feld={f.name}
              >
                {f.typ === "zahl" && (
                  <>
                    <label class="rf-frage" for={p(f.name)}>
                      {f.label}
                      {f.optional && (
                        <span class="rf-optional"> (optional)</span>
                      )}
                    </label>
                    <div class="rf-zahl">
                      <input
                        id={p(f.name)}
                        name={f.name}
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder={f.beispiel}
                        aria-describedby={
                          f.hilfe ? p(`${f.name}-hilfe`) : undefined
                        }
                        data-einheit={f.einheit}
                      />
                      {f.einheit && (
                        <span class="rf-einheit" aria-hidden="true">
                          {f.einheit}
                        </span>
                      )}
                    </div>
                    {f.hilfe && (
                      <p class="rf-hilfe" id={p(`${f.name}-hilfe`)}>
                        {f.hilfe}
                      </p>
                    )}
                  </>
                )}
                {f.typ === "auswahl" && (
                  <fieldset>
                    <legend class="rf-frage">{f.label}</legend>
                    {f.hilfe && <p class="rf-hilfe">{f.hilfe}</p>}
                    <div
                      class:list={[
                        "rf-wahlen",
                        f.kompakt && "rf-wahlen--kompakt",
                      ]}
                    >
                      {f.optionen.map((o) => (
                        <label class="wahl">
                          <input
                            class="wahl-input"
                            type="radio"
                            name={f.name}
                            value={o.wert}
                            checked={o.wert === f.standard}
                          />
                          <span class="wahl-box">
                            <span class="wahl-label">{o.label}</span>
                            {o.hilfe && (
                              <span class="wahl-hilfe">{o.hilfe}</span>
                            )}
                          </span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                )}
                {f.typ === "janein" && (
                  <label class="wahl wahl--check">
                    <input
                      class="wahl-input"
                      type="checkbox"
                      name={f.name}
                      value="ja"
                      checked={f.standard}
                    />
                    <span class="wahl-box">
                      <span class="wahl-haken" aria-hidden="true" />
                      <span>
                        <span class="wahl-label">{f.label}</span>
                        {f.hilfe && <span class="wahl-hilfe">{f.hilfe}</span>}
                      </span>
                    </span>
                  </label>
                )}
              </div>
            ))}
            {hinweis[leistung] && (
              <p class="rechner-hinweis">{hinweis[leistung]}</p>
            )}
          </form>

          <aside class="rechner-ergebnis" aria-label="Ergebnis">
            <p class="re-titel">Ihr Richtwert</p>
            <p class="re-wert" data-ergebnis aria-live="polite">
              Bitte die Angaben links ausfüllen.
            </p>
            <p class="re-zusatz" data-zusatz hidden />
            <p class="re-hinweis">
              <strong>
                Unverbindlicher Richtwert. Verbindlicher Festpreis nach
                kostenloser Besichtigung.
              </strong>
            </p>
            <p class="re-steuer">Ohne Umsatzsteuer (§ 19 UStG).</p>
            <div class="re-aktionen">
              <a class="btn btn--wide" href="/kontakt/" data-anfrage="formular">
                <span>Festpreis anfragen</span>
              </a>
              <a
                class="btn btn--secondary btn--wa btn--wide"
                href={`https://wa.me/${site.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                data-anfrage="whatsapp"
              >
                <span>Per WhatsApp anfragen</span>
              </a>
            </div>
            <p class="re-foto">
              Fotos helfen uns bei der Einschätzung - gern per WhatsApp.
            </p>
            <noscript>
              <p class="re-noscript">
                Der Rechner braucht JavaScript. Rufen Sie uns gern an:
                {site.phoneDisplay}
              </p>
            </noscript>
          </aside>
        </div>
      </div>
    </Tag>
  )
}

<script>
  import {
    entpacke,
    eckenJeForm,
    ergebnisText,
    rechner,
    zusatzText,
    type Ergebnis,
    type Leistung,
  } from "../lib/preisrechner";

  type Eingaben = Record<string, string | boolean>;

  const melde = (event: string, daten: Record<string, string>) => {
    const w = window as unknown as { dataLayer?: unknown[] };
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push({ event, ...daten, page_path: location.pathname });
  };

  document
    .querySelectorAll<HTMLElement>("[data-preisrechner]")
    .forEach((wurzel) => {
      const leistung = wurzel.dataset.preisrechner as Leistung;
      let modell: unknown;
      try {
        modell = entpacke(wurzel.dataset.m || "");
      } catch {
        return;
      }
      const form = wurzel.querySelector<HTMLFormElement>("form")!;
      const ausgabe = wurzel.querySelector<HTMLElement>("[data-ergebnis]")!;
      const formularLink = wurzel.querySelector<HTMLAnchorElement>(
        '[data-anfrage="formular"]',
      )!;
      const waLink = wurzel.querySelector<HTMLAnchorElement>(
        '[data-anfrage="whatsapp"]',
      )!;
      const speicherKey = `fixum-rechner-v3-${leistung}`;
      const zusatzEl = wurzel.querySelector<HTMLElement>("[data-zusatz]")!;
      let reinigungBeruehrt = false;
      let gestartet = false;
      let letztesErgebnis = "";
      let timer: number | undefined;

      const eingaben = (): Eingaben => {
        const e: Eingaben = {};
        form.querySelectorAll<HTMLInputElement>("input").forEach((i) => {
          if (i.closest<HTMLElement>("[data-feld]")?.hidden) return;
          if (i.type === "radio") {
            if (i.checked) e[i.name] = i.value;
          } else if (i.type === "checkbox") {
            e[i.name] = i.checked;
          } else {
            e[i.name] = i.value;
          }
        });
        return e;
      };

      /* Bedingte Fragen: data-zeige-wenn="art=zwischenwand,dachschraege"
         oder bei Ja/Nein-Fragen "keller=ja". */
      const wertVon = (name: string) => {
        /* Ist die Frage selbst ausgeblendet, zählt ihre Antwort nicht -
           so klappen verschachtelte Details mit ihrer Oberfrage zu. */
        const quelle = form
          .querySelector<HTMLInputElement>(`input[name="${name}"]`)
          ?.closest<HTMLElement>("[data-feld]");
        if (quelle?.hidden) return "";
        const box = form.querySelector<HTMLInputElement>(
          `input[type="checkbox"][name="${name}"]`,
        );
        if (box) return box.checked ? "ja" : "nein";
        return (
          form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)
            ?.value ?? ""
        );
      };
      const sichtbarkeit = () => {
        form
          .querySelectorAll<HTMLElement>("[data-zeige-wenn]")
          .forEach((feld) => {
            const [name, werte] = (feld.dataset.zeigeWenn || "").split("=");
            feld.hidden = !werte.split(",").includes(wertVon(name));
          });
      };

      /* Lesbare Zusammenfassung für Formular und WhatsApp - nur die Angaben
         des Kunden und der Richtwert, keine Einzelpreise. */
      const zusammenfassung = (ergebnis: string) => {
        const zeilen: string[] = [];
        const extras: string[] = [];
        form.querySelectorAll<HTMLElement>("[data-feld]").forEach((feld) => {
          if (feld.hidden) return;
          const frage = feld
            .querySelector(".rf-frage")
            ?.textContent?.replace(/\(optional\)/, "")
            .trim();
          const zahl =
            feld.querySelector<HTMLInputElement>('input[type="text"]');
          const radio = feld.querySelector<HTMLInputElement>(
            'input[type="radio"]:checked',
          );
          const check = feld.querySelector<HTMLInputElement>(
            'input[type="checkbox"]',
          );
          if (zahl && zahl.value.trim())
            zeilen.push(
              `${frage} ${zahl.value.trim()} ${zahl.dataset.einheit ?? ""}`.trim(),
            );
          if (radio)
            zeilen.push(
              `${frage} ${radio.closest("label")?.querySelector(".wahl-label")?.textContent?.trim()}`,
            );
          if (check?.checked)
            extras.push(
              feld.querySelector(".wahl-label")?.textContent?.trim() ?? "",
            );
        });
        if (extras.length) zeilen.push(`Dazu: ${extras.join(", ")}`);
        zeilen.push(`Richtwert laut Preisrechner: ${ergebnis}`);
        return zeilen.join("\n");
      };

      /* Eingaben für die Sitzung merken (z. B. beim Wechsel zur
         Kontaktseite und zurück). Nur im Browser des Kunden, sessionStorage
         wird beim Schließen des Tabs gelöscht. */
      const speichere = () => {
        const daten: Record<string, string | boolean> = {};
        form.querySelectorAll<HTMLInputElement>("input").forEach((i) => {
          if (i.type === "radio") {
            if (i.checked) daten[i.name] = i.value;
          } else if (i.type === "checkbox") {
            daten[i.name] = i.checked;
          } else {
            daten[i.name] = i.value;
          }
        });
        try {
          sessionStorage.setItem(speicherKey, JSON.stringify(daten));
        } catch {
          /* Speicher gesperrt (privater Modus) - dann eben ohne. */
        }
      };

      const stelleWiederHer = () => {
        let daten: Record<string, string | boolean> | null = null;
        try {
          daten = JSON.parse(sessionStorage.getItem(speicherKey) || "null");
        } catch {
          return;
        }
        if (!daten || typeof daten !== "object") return;
        form.querySelectorAll<HTMLInputElement>("input").forEach((i) => {
          if (!(i.name in daten!)) return;
          const wert = daten![i.name];
          if (i.type === "radio") i.checked = i.value === wert;
          else if (i.type === "checkbox") i.checked = wert === true;
          else if (typeof wert === "string") i.value = wert.slice(0, 20);
        });
      };

      const aktualisiere = () => {
        sichtbarkeit();
        const fn = rechner[leistung];
        const ergebnis: Ergebnis = fn(modell as never, eingaben());
        const text = ergebnisText(ergebnis);
        ausgabe.textContent = text;
        ausgabe.dataset.art = ergebnis.art;
        const zusaetze =
          "zusatz" in ergebnis && ergebnis.zusatz ? ergebnis.zusatz : [];
        zusatzEl.textContent = zusaetze.map((z) => zusatzText[z]).join(" ");
        zusatzEl.hidden = zusaetze.length === 0;

        const nachricht = zusammenfassung(
          ergebnis.art === "unvollstaendig" ? "noch offen" : text,
        );
        formularLink.href =
          "/kontakt/#rechner=" +
          encodeURIComponent(
            JSON.stringify({ t: wurzel.dataset.thema, n: nachricht }),
          );
        waLink.href =
          `https://wa.me/${wurzel.dataset.wa}?text=` +
          encodeURIComponent(
            `Moin, ich habe den Preisrechner auf fixum-objektservice.de genutzt:\n${nachricht}\n\nBitte um einen Festpreis.`,
          );

        if (ergebnis.art !== "unvollstaendig" && text !== letztesErgebnis) {
          letztesErgebnis = text;
          window.clearTimeout(timer);
          timer = window.setTimeout(
            () =>
              melde("rechner_ergebnis", {
                rechner: leistung,
                ergebnis_art: ergebnis.art,
              }),
            1500,
          );
        }
      };

      /* Vorauswahlen: Küchenform -> Eckverbindungen der Arbeitsplatte.
         Entrümpelung: Bei Messie ist die Grundreinigung vorausgewählt
         (abwählbar); hat der Kunde die Reinigung selbst gewählt, bleibt
         seine Wahl stehen. */
      const vorauswahl = (ziel: EventTarget | null) => {
        const feld = ziel as HTMLInputElement | null;
        if (!feld) return;
        if (feld.name === "kuecheForm") {
          /* Küchenform: Eckverbindungen der Arbeitsplatte vorauswählen */
          const ecken = form.querySelector<HTMLInputElement>(
            `input[name="ecken"][value="${eckenJeForm[feld.value] ?? 0}"]`,
          );
          if (ecken) ecken.checked = true;
        }
        if (leistung !== "entruempelung") return;
        if (feld.name === "reinigung") reinigungBeruehrt = true;
        if (feld.name !== "zustand" || reinigungBeruehrt) return;
        const wert = feld.value === "messie" ? "grund" : "keine";
        const radio = form.querySelector<HTMLInputElement>(
          `input[name="reinigung"][value="${wert}"]`,
        );
        if (radio) radio.checked = true;
      };

      const beiEingabe = (event?: Event) => {
        if (event?.type === "change") vorauswahl(event.target);
        if (!gestartet) {
          gestartet = true;
          melde("rechner_gestartet", { rechner: leistung });
        }
        aktualisiere();
        speichere();
      };

      form.addEventListener("input", beiEingabe);
      form.addEventListener("change", beiEingabe);
      [formularLink, waLink].forEach((a) =>
        a.addEventListener("click", () =>
          melde("rechner_anfrage", {
            rechner: leistung,
            kanal: a.dataset.anfrage || "",
          }),
        ),
      );
      stelleWiederHer();
      aktualisiere();
    });
</script>

<style>
  /* Dunkles Rechner-Design: Die Variablen (--rechner-flaeche, -rahmen,
     -text-leise) kommen von .section--rechner im Designsystem; hier stehen
     Rückfallwerte, falls der Rechner einmal außerhalb steht. Messing
     (--accent) markiert Auswahl, Fokus und den Preis. */
  .rechner {
    --rf-flaeche: var(--rechner-flaeche, rgba(255, 255, 255, 0.04));
    --rf-rahmen: var(--rechner-rahmen, rgba(255, 255, 255, 0.12));
    --rf-leise: var(--rechner-text-leise, rgba(255, 255, 255, 0.7));
  }

  .rechner-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .rechner-form {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--rf-rahmen);
    border-radius: 14px;
    background: var(--rf-flaeche);
    box-shadow: none;
    color: #fff;
  }

  .rf[hidden] {
    display: none;
  }

  /* Aufgeklappte Details unter einer Ja/Nein-Frage */
  .rf--detail {
    margin-top: -0.75rem;
    margin-left: 0.75rem;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 1px solid rgba(176, 141, 87, 0.55);
  }

  .rf--detail .rf-frage {
    font-size: 0.9375rem;
  }

  .rf fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .rf-frage {
    display: block;
    margin-bottom: 0.7rem;
    padding: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #fff;
  }

  .rf-optional {
    font-weight: 400;
    color: var(--rf-leise);
  }

  .rf-hilfe {
    margin: -0.3rem 0 0.7rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--rf-leise);
  }

  .rf--zahl .rf-hilfe {
    margin: 0.55rem 0 0;
  }

  .rf-zahl {
    position: relative;
    max-width: 16rem;
  }

  .rf-zahl input {
    width: 100%;
    min-height: 52px;
    padding: 0.75rem 3.25rem 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
    transition:
      border-color 200ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  .rf-zahl input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .rf-zahl input:hover {
    border-color: rgba(255, 255, 255, 0.32);
  }

  .rf-zahl input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.08);
  }

  .rf-einheit {
    position: absolute;
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
    font-weight: 600;
    color: var(--rf-leise);
  }

  /* ---- Auswahlkarten ---- */
  .rf-wahlen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 0.625rem;
  }

  .rf-wahlen--kompakt {
    grid-template-columns: repeat(auto-fit, minmax(4.25rem, 1fr));
  }

  .wahl {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .wahl-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .wahl-box {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.2rem;
    height: 100%;
    min-height: 52px;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rf-rahmen);
    border-radius: 10px;
    background: var(--rf-flaeche);
    transition:
      border-color 200ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  .rf-wahlen--kompakt .wahl-box {
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.6rem 0.4rem;
  }

  .wahl-label {
    display: block;
    font-weight: 600;
    color: #fff;
  }

  .rf-wahlen--kompakt .wahl-label {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
  }

  .wahl-hilfe {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--rf-leise);
  }

  .wahl:hover .wahl-box {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .wahl-input:checked + .wahl-box {
    border-color: var(--accent);
    background: rgba(176, 141, 87, 0.1);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .wahl-input:focus-visible + .wahl-box {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Ja/Nein als Haken-Karte */
  .wahl--check .wahl-box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
  }

  .wahl-haken {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 5px;
    background: transparent;
    transition:
      background 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }

  .wahl-input:checked + .wahl-box .wahl-haken {
    border-color: var(--accent);
    background: var(--accent);
  }

  .wahl-input:checked + .wahl-box .wahl-haken::after {
    content: "";
    width: 0.4rem;
    height: 0.75rem;
    margin-top: -0.15rem;
    border: solid var(--navy-deep);
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }

  .rechner-hinweis {
    margin: 0;
    padding: 0.85rem 1rem;
    border-left: 2px solid var(--accent);
    border-radius: 0 10px 10px 0;
    font-size: 0.9375rem;
    color: var(--on-dark-soft);
    background: rgba(255, 255, 255, 0.04);
  }

  /* ---- Ergebnis ---- */
  .rechner-ergebnis {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgba(176, 141, 87, 0.45);
    border-radius: 14px;
    color: var(--on-dark-soft);
    background:
      radial-gradient(
        120% 120% at 100% 0%,
        rgba(176, 141, 87, 0.14),
        transparent 55%
      ),
      rgba(7, 19, 38, 0.6);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
  }

  .rechner-ergebnis p {
    margin: 0;
  }

  .re-titel {
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
