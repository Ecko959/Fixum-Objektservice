---
/* Preisrechner - eine Komponente für alle Leistungen.

   Die Fragen stehen hier, die Werte in src/data/preise.config.json, die
   Rechenregeln in src/lib/preisrechner.ts.

   Diskret: Im HTML stehen keine Preise. Das Rechenmodell kommt umcodiert
   als data-Attribut mit, das Ergebnis erscheint nur als gerundete Spanne,
   ohne Einzelpositionen. */
import config from "../data/preise.config.json";
import {
  baueModell,
  rechnerBereit,
  verpacke,
  type Leistung,
} from "../lib/preisrechner";
import { site } from "../data/site";

interface Props {
  leistung: Leistung;
  /** Anker der Sektion - auf Leistungsseiten "kalkulator". */
  id?: string;
  titel?: string;
  /** Auf der Sammelseite ohne eigene Sektion und Überschrift-Ebene. */
  eingebettet?: boolean;
}

const {
  leistung,
  id = "kalkulator",
  titel = "Preis grob berechnen",
  eingebettet = false,
} = Astro.props;

type Option = { wert: string; label: string; hilfe?: string };
type Gemeinsam = {
  name: string;
  label: string;
  hilfe?: string;
  /** Nur zeigen, wenn eine andere Angabe passt: "art=zwischenwand,dachschraege"
      oder bei Ja/Nein-Fragen "keller=ja". */
  zeigeWenn?: string;
  /** Aufgeklappte Detailangabe unter einer Ja/Nein-Frage - eingerückt. */
  detail?: boolean;
};
type Feld =
  | (Gemeinsam & {
      typ: "zahl";
      einheit?: string;
      beispiel?: string;
      optional?: boolean;
    })
  | (Gemeinsam & {
      typ: "auswahl";
      optionen: Option[];
      standard: string;
      kompakt?: boolean;
    })
  | (Gemeinsam & { typ: "janein"; standard?: boolean });

const etagen: Option[] = [
  { wert: "0", label: "EG" },
  { wert: "1", label: "1." },
  { wert: "2", label: "2." },
  { wert: "3", label: "3." },
  { wert: "4", label: "4." },
  { wert: "5", label: "5. +" },
];

const anzahl = (bis: number): Option[] =>
  Array.from({ length: bis + 1 }, (_, i) => ({
    wert: String(i),
    label: i === bis ? `${i} +` : String(i),
  }));

const fuellgrad = (name: string, raum: string, zeigeWenn: string): Feld => ({
  typ: "auswahl",
  name,
  label: `${raum}: wie voll?`,
  standard: "voll",
  kompakt: true,
  detail: true,
  zeigeWenn,
  optionen: [
    { wert: "wenig", label: "Wenig" },
    { wert: "voll", label: "Voll" },
  ],
});

const eilauftrag: Feld = {
  typ: "janein",
  name: "eilig",
  label: "Eilauftrag: innerhalb von 48 Stunden",
};

