---
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  width?: number;
  height?: number;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt = "",
  label = "Foto",
  width = 1200,
  height = 800,
  eager = false,
  class: className = "",
} = Astro.props;
const srcBase = src?.replace(/\.[a-zA-Z0-9]+$/, "");
---

{
  src ? (
    <picture class={`photo ${className}`}>
      <source srcset={`${srcBase}.avif`} type="image/avif" />
      <source srcset={`${srcBase}.webp`} type="image/webp" />
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </picture>
  ) : (
    <div
      class={`photo photo--placeholder ${className}`}
      role="img"
      aria-label={label}
    >
      <span>{label}</span>
    </div>
  )
}

<style>
  .photo {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(220, 229, 242, 0.8);
    border-radius: 18px;
    background: linear-gradient(135deg, #173465, #0e2148);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }

  .photo--placeholder {
    min-height: 260px;
    display: grid;
    place-items: center;
  }

  .photo--placeholder span {
    color: #d8e7fb;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
