---
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  width?: number;
  height?: number;
  /** LCP-Bilder eager laden und priorisieren. */
  eager?: boolean;
  /** Layout-Breite für den Browser, z. B. "(max-width: 900px) 100vw, 50vw". */
  sizes?: string;
  ratio?: string;
  class?: string;
}

const {
  src,
  alt = "",
  label = "Foto",
  width = 1200,
  height = 800,
  eager = false,
  sizes,
  ratio,
  class: className = "",
} = Astro.props;

/* Die Bilder liegen als PNG plus vorgerenderte AVIF- und WebP-Varianten vor. */
const srcBase = src?.replace(/\.[a-zA-Z0-9]+$/, "");
const style = ratio ? `--photo-ratio:${ratio}` : undefined;
---

{
  src ? (
    <picture class={`photo ${className}`.trim()} style={style}>
      <source srcset={`${srcBase}.avif`} type="image/avif" sizes={sizes} />
      <source srcset={`${srcBase}.webp`} type="image/webp" sizes={sizes} />
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding={eager ? "sync" : "async"}
      />
    </picture>
  ) : (
    <div
      class={`photo photo--placeholder ${className}`.trim()}
      style={style}
      role="img"
      aria-label={label}
    >
      <span>{label}</span>
    </div>
  )
}

<style>
  .photo {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #173465, #0e2148);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--photo-ratio, 3 / 2);
    transform: scale(1.001); /* verhindert Kantenflimmern beim Skalieren */
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .photo--placeholder {
    display: grid;
    place-items: center;
    min-height: 260px;
    aspect-ratio: var(--photo-ratio, 3 / 2);
  }

  .photo--placeholder span {
    color: var(--on-dark-soft);
    font-family: var(--font-utility);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
