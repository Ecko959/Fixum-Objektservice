---
import { Picture } from "astro:assets";
import { findeBild } from "../data/bilder";

interface Props {
  src?: string;
  alt?: string;
  label?: string;
  /** Seitenverhältnis des Ausschnitts. astro:assets leitet die tatsächlichen
      Maße aus der Datei ab; diese Angaben bestimmen nur, wie hoch der Platz
      im Layout reserviert wird, damit beim Laden nichts springt. */
  width?: number;
  height?: number;
  /** LCP-Bilder eager laden und priorisieren. */
  eager?: boolean;
  /** Layout-Breite für den Browser, z. B. "(max-width: 900px) 100vw, 50vw". */
  sizes?: string;
  ratio?: string;
  class?: string;
}

const {
  src,
  alt = "",
  label = "Foto",
  width = 1200,
  height = 800,
  eager = false,
  sizes,
  ratio,
  class: className = "",
} = Astro.props;

/* astro:assets erzeugt die Formate beim Bauen. AVIF zuerst, WebP als
   zweite Wahl - der Browser nimmt das erste, das er kann.

   Der Rueckfall im <img> ist JPEG, nicht PNG: Er greift nur bei Browsern,
   die weder AVIF noch WebP koennen, und fuer Fotos ist PNG das falsche
   Format - als Rueckfall in drei Breiten waren das 154 MB im Build. */
const bild = findeBild(src);
/* Ohne ausdrückliches Verhältnis aus den übergebenen Maßen ableiten - die
   reservierte Fläche steht damit schon fest, bevor das Bild geladen ist. */
const style = `--photo-ratio:${ratio ?? `${width} / ${height}`}`;
---

{
  bild ? (
    <Picture
      pictureAttributes={{ class: `photo ${className}`.trim(), style }}
      src={bild}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes={sizes ?? "(max-width: 900px) 100vw, 50vw"}
      formats={["avif", "webp"]}
      fallbackFormat="jpeg"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding={eager ? "sync" : "async"}
    />
  ) : (
    <div
      class={`photo photo--placeholder ${className}`.trim()}
      style={style}
      role="img"
      aria-label={label}
    >
      <span>{label}</span>
    </div>
  )
}

<style>
  .photo {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #173465, #0e2148);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--photo-ratio, 3 / 2);
    transform: scale(1.001); /* verhindert Kantenflimmern beim Skalieren */
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .photo--placeholder {
    display: grid;
    place-items: center;
    min-height: 260px;
    aspect-ratio: var(--photo-ratio, 3 / 2);
  }

  .photo--placeholder span {
    color: var(--on-dark-soft);
    font-family: var(--font-utility);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
