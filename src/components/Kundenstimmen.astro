---
/* Kundenstimmen aus dem Google-Unternehmensprofil.

   Daten: src/data/reviews.json, automatisch aktualisiert durch
   scripts/fetch-reviews.mjs (vor jedem Build) und den täglichen
   Neu-Build (.github/workflows/bewertungen-aktualisieren.yml).
   Logik und Hinweise zum Markup: src/data/bewertungen.ts.

   Auf dem Handy laufen die Karten als wischbare Reihe, ab Tablet als
   Raster. Ohne Bewertungen wird die Sektion nicht ausgegeben. */
import Sterne from "./Sterne.astro";
import {
  anzahl,
  bewertenUrl,
  bewertungen,
  hatBewertungen,
  monatText,
  note,
  noteText,
  profilUrl,
} from "../data/bewertungen";
---

{
  hatBewertungen && bewertungen.length > 0 && (
    <section
      id="bewertungen"
      class="section section--soft kundenstimmen"
      aria-labelledby="stimmen-title"
    >
      <div class="container stimmen-kopf" data-reveal>
        <div class="stimmen-titel">
          <p class="eyebrow">Kundenstimmen</p>
          <h2 id="stimmen-title">
            Was Kunden in Emden und Ostfriesland über Fixum sagen
          </h2>
        </div>

        <a
          class="stimmen-note"
          href={profilUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="bewertungen"
        >
          <span class="note-zahl">{noteText}</span>
          <span class="note-details">
            <Sterne wert={note} size={18} />
            <span>
              {`${anzahl} ${anzahl === 1 ? "Bewertung" : "Bewertungen"} bei Google`}
            </span>
          </span>
        </a>
      </div>

      <ul class="container stimmen-reihe" data-reveal-group>
        {bewertungen.map((r) => (
          <li class="stimme" data-reveal>
            <span class="stimme-zeichen" aria-hidden="true">
              „
            </span>
            {r.sterne && (
              <p class="stimme-sterne">
                <Sterne wert={r.sterne} size={15} />
                <span class="sr-only">{r.sterne} von 5 Sternen</span>
              </p>
            )}
            <blockquote>
              <p>{r.text}</p>
            </blockquote>
            <footer class="stimme-fuss">
              <span class="stimme-avatar" aria-hidden="true">
                {r.name.trim()[0]?.toUpperCase()}
              </span>
              <span class="stimme-wer">
                <strong>{r.name}</strong>
                <span>
                  {[r.ort, monatText(r.datum), r.quelle && `via ${r.quelle}`]
                    .filter(Boolean)
                    .join(" · ")}
                </span>
              </span>
            </footer>
          </li>
        ))}
      </ul>

      <div class="container" data-reveal>
        <div class="btn-row stimmen-aktionen">
          {profilUrl && (
            <a
              class="btn btn--secondary"
              href={profilUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track="bewertungen"
            >
              <span>Alle Bewertungen bei Google</span>
            </a>
          )}
          {bewertenUrl && (
            <a
              class="btn"
              href={bewertenUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track="bewertung-schreiben"
            >
              <span>Eigene Bewertung schreiben</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .stimmen-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .stimmen-titel {
    flex: 1 1 22rem;
  }

  .stimmen-titel > * {
    max-width: 34ch;
  }

  .stimmen-titel h2 {
    margin: 0.35rem 0 0;
  }

  /* Gesamtnote als ruhige Plakette */
  .stimmen-note {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-xs);
    color: var(--ink);
    text-decoration: none;
    transition:
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .stimmen-note:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .note-zahl {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
  }

  .note-details {
    display: grid;
    gap: 0.3rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Karten: Handy = wischbare Reihe, ab Tablet = Raster */
  .stimmen-reihe {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 20rem);
    gap: 1rem;
    margin-block: 0;
    padding: 0.25rem 0 1rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  @media (min-width: 48rem) {
    .stimmen-reihe {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
      gap: clamp(1rem, 2vw, 1.5rem);
      overflow: visible;
    }
  }

  .stimme {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.9rem;
    padding: clamp(1.35rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-xs);
    scroll-snap-align: start;
    overflow: hidden;
  }

  .stimme-zeichen {
    position: absolute;
    top: -0.6rem;
    right: 1rem;
    font-family: var(--font-serif);
    font-size: 6rem;
    line-height: 1;
    color: var(--mist);
    pointer-events: none;
  }

  .stimme-sterne {
    position: relative;
    margin: 0;
  }

  .stimme blockquote {
    position: relative;
    margin: 0;
  }

  .stimme blockquote p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink);
  }

  .stimme-fuss {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .stimme-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-rund);
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .stimme-wer {
    display: grid;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .stimme-wer strong {
    font-size: 0.9375rem;
    color: var(--navy);
  }

  .stimmen-aktionen {
    justify-content: center;
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  /* Handy: untereinander, zentriert, nicht über die volle Breite */
  @media (max-width: 560px) {
    .stimmen-aktionen {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .stimmen-aktionen .btn {
      width: min(100%, 18.5rem);
    }
  }
</style>
