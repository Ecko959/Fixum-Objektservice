---
/**
 * Inline-SVG-Icons. Bewusst ohne Icon-Font oder externes Sprite:
 * kein zusätzlicher Request, volle Kontrolle über Strichstärke und Farbe.
 */

interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
  /** Nur setzen, wenn das Icon allein steht und Bedeutung trägt. */
  label?: string;
}

const paths = {
  phone:
    "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z",
  whatsapp:
    "M21 11.5a8.5 8.5 0 0 1-12.8 7.3L3 20.5l1.8-5.1A8.5 8.5 0 1 1 21 11.5Z",
  mail: "M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-.6.6 8.6 7 8.6-7",
  pin: "M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Zm-8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  clock: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-14v5l3.5 2",
  check: "m4.5 12.5 5 5 10-11",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z",
  clipboard:
    "M9 4h6v3H9V4Zm-2 1.5H5.5A1.5 1.5 0 0 0 4 7v13a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 20 20V7a1.5 1.5 0 0 0-1.5-1.5H17M8.5 12h7M8.5 16h5",
  home: "M3.5 11 12 3.5l8.5 7.5M6 10.5V20a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-9.5",
  hammer:
    "m13 8-8.6 8.6a2 2 0 0 0 0 2.8v0a2 2 0 0 0 2.8 0L15.8 11M11 6l4-4 7 7-4 4-7-7Z",
  truck:
    "M3 6.5h11v11H3v-11Zm11 4h4l3 3.5v3.5h-7v-7ZM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
  euro: "M17 6.5A6 6 0 0 0 8 10m9 7.5a6 6 0 0 1-9-3.5M4 10.5h9M4 14h8",
  spark: "M12 2.5 14 9l6.5 2-6.5 2-2 6.5-2-6.5L3.5 11 10 9l2-6.5Z",
  star: "m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z",
  pen: "M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16v4Zm11-13 3 3",
  arrow: "M5 12h14m-6-6 6 6-6 6",
  layers: "m12 3 9 5-9 5-9-5 9-5Zm9 10-9 5-9-5m18 4-9 5-9-5",
  /* Transportkiste - steht für Räumen und Entrümpelung */
  recycle: "M3 4h18v4H3V4Zm1 4h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8Zm6 4h4",
  users:
    "M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20M9 10.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm13 9.5v-1.5a4 4 0 0 0-3-3.9M16 3.6a4 4 0 0 1 0 7.8",
  snow: "M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9M12 7l-2.2-2M12 7l2.2-2m-2.2 12-2.2 2m2.2-2 2.2 2",
  /* Mauerwerk im Läuferverband - steht für Trockenbau und Ausbau */
  wall: "M3 5h18v14H3V5Zm0 4.7h18M3 14.3h18M9 5v4.7M15 5v4.7M6 9.7v4.6M12 9.7v4.6M18 9.7v4.6M9 14.3V19M15 14.3V19",
} as const;

const { name, size = 22, class: className = "", label } = Astro.props;
const d = paths[name];
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={d}></path>
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
