---
import Icon from "./Icon.astro";
import WhatsAppMark from "./WhatsAppMark.astro";
import { telUrl, whatsappUrl } from "../data/site";
---

{
  /* Setzt das Flag noch während des Parsens, damit die Leiste beim ersten
     Bild gar nicht erst auftaucht und wieder wegspringt. */
}
<script is:inline>
  document.documentElement.dataset.stickyArmed = "";
</script>

<div
  class="sticky-call"
  role="complementary"
  aria-label="Schnellkontakt"
  data-sticky-call
>
  <a class="sticky-primary" href={telUrl}>
    <Icon name="phone" size={18} />
    <span>Anrufen</span>
  </a>
  <a
    class="sticky-secondary"
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
  >
    <WhatsAppMark size={22} />
    <span>WhatsApp</span>
  </a>
</div>

<style>
  /* Deckende Fläche statt Milchglas: Ein backdrop-filter zwingt die fixierte
     Leiste auf eine eigene Compositing-Ebene, und die läuft dem unteren
     Rand hinterher, während Android und iOS ihre Adressleiste ein- und
     ausblenden. Genau dann klafft ein Spalt und Seiteninhalt blitzt durch. */
  .sticky-call {
    position: fixed;
    inset: auto 0 0;
    z-index: 90;
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
    height: calc(66px + env(safe-area-inset-bottom));
    padding: 0.6rem 0.875rem calc(0.6rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--on-dark-hairline);
    background: var(--navy-deep);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.28);
  }

  /* Zieht den Grund der Leiste nach unten weiter. Falls der Browser sie
     während der Toolbar-Animation kurz anhebt, steht darunter trotzdem
     dieselbe Fläche statt der Seite. */
  .sticky-call::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 240px;
    background: var(--navy-deep);
    pointer-events: none;
  }

  .sticky-call a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-utility);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .sticky-call a:active {
    transform: scale(0.97);
  }

  .sticky-primary {
    background: linear-gradient(180deg, var(--blue-bright), var(--blue));
    box-shadow: var(--glow-blue);
  }

  .sticky-secondary {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 767px) {
    .sticky-call {
      display: grid;
    }

    /* Im Hero wäre die Leiste die dritte Aktionsgruppe auf einem Bildschirm.
       Sie fährt erst hoch, wenn der erste Abschnitt durchgescrollt ist.
       Ohne JavaScript greift das Flag nie - dann bleibt sie wie bisher da. */
    :global(html[data-sticky-armed]) .sticky-call {
      transform: translateY(110%);
      visibility: hidden;
      transition:
        transform var(--dur) var(--ease-out),
        visibility var(--dur) var(--ease-out);
    }

    :global(html[data-sticky-armed]) .sticky-call.is-visible {
      transform: none;
      visibility: visible;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-call]");
  const first = document.querySelector<HTMLElement>("#inhalt > section");

  if (bar && first && "IntersectionObserver" in window) {
    /* Sichtbar, sobald der erste Abschnitt oben aus dem Bild gelaufen ist -
       also mit dem Eintritt in den zweiten. Wieder weg, wenn zurückgescrollt
       wird, damit der Hero frei bleibt. */
    new IntersectionObserver(
      ([entry]) => {
        const passed =
          !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.classList.toggle("is-visible", passed);
      },
      { threshold: 0 },
    ).observe(first);
  } else {
    /* Kein Beobachter, keine Steuerung - dann lieber dauerhaft sichtbar. */
    delete document.documentElement.dataset.stickyArmed;
  }
</script>
