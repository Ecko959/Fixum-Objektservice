---
import Icon from "./Icon.astro";
import WhatsAppMark from "./WhatsAppMark.astro";
import { telUrl, whatsappUrl } from "../data/site";
---

<div
  class="sticky-call"
  role="complementary"
  aria-label="Schnellkontakt"
  data-sticky-call
>
  <a class="sticky-primary" href={telUrl}>
    <Icon name="phone" size={18} />
    <span>Anrufen</span>
  </a>
  <a
    class="sticky-secondary"
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
  >
    <WhatsAppMark size={22} />
    <span>WhatsApp</span>
  </a>
</div>

<style>
  /* Diese Leiste darf NIEMALS ein transform, filter, backdrop-filter oder
     will-change bekommen. Jede dieser Eigenschaften hebt ein position: fixed
     auf eine eigene Compositing-Ebene, und iOS führt die nicht synchron mit
     dem Viewport nach, während Safari seine Adressleiste ein- und ausfährt -
     die Leiste bleibt dann mitten im Bild stehen. Aus- und eingeblendet wird
     ausschließlich über opacity.

     Die Höhe steht als --sticky-call-h im Designsystem; global.css baut
     daraus den Innenabstand des body, damit der letzte Inhalt frei bleibt. */
  .sticky-call {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-sticky-call);
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
    height: calc(var(--sticky-call-h) + env(safe-area-inset-bottom));
    padding: 0.6rem calc(0.875rem + env(safe-area-inset-right))
      calc(0.6rem + env(safe-area-inset-bottom))
      calc(0.875rem + env(safe-area-inset-left));
    border-top: 1px solid var(--on-dark-hairline);
    background: var(--navy-deep);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.28);
  }

  /* Zieht den Grund der Leiste nach unten weiter. Hebt der Browser sie
     während der Toolbar-Animation trotzdem kurz an, steht darunter dieselbe
     Fläche statt der Seite. */
  .sticky-call::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 240px;
    background: var(--navy-deep);
    pointer-events: none;
  }

  .sticky-call a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-utility);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .sticky-call a:active {
    transform: scale(0.97);
  }

  .sticky-primary {
    background: linear-gradient(180deg, var(--blue-bright), var(--blue));
    box-shadow: var(--glow-blue);
  }

  .sticky-secondary {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 767px) {
    .sticky-call {
      display: grid;
    }

    /* Im Hero wäre die Leiste die dritte Aktionsgruppe auf einem Bildschirm.
       Sie blendet erst ein, wenn der erste Abschnitt durchgescrollt ist.

       Der Ausgangszustand ist BEWUSST sichtbar: Fällt das Skript aus, ist die
       Leiste einen Bildschirm zu früh da - das ist harmlos. Wäre der
       Ausgangszustand versteckt, wäre sie bei einem Skriptfehler dauerhaft
       weg, und ein fehlender Anrufknopf kostet Aufträge.

       visibility wechselt ohne Dauer und erst nach der Blende. Ein echter
       Übergang auf visibility bleibt auf iOS gelegentlich im Zwischenschritt
       hängen - genau daher kam das "mal verschwindet sie ganz". */
    :global(html[data-sticky-js]) .sticky-call[data-hidden] {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity var(--dur) var(--ease-out),
        visibility 0s linear var(--dur);
    }

    :global(html[data-sticky-js]) .sticky-call {
      opacity: 1;
      visibility: visible;
      transition:
        opacity var(--dur) var(--ease-out),
        visibility 0s;
    }
  }
</style>

{
  /* Bewusst is:inline und direkt hinter der Leiste: Das Skript läuft noch
     während des Parsens, setzt den Anfangszustand ohne sichtbares Springen
     und hängt nicht an einem gebündelten Modul, das später scheitern könnte. */
}
<script is:inline>
  (() => {
    const bar = document.querySelector("[data-sticky-call]");
    const erste = document.querySelector("#inhalt > section");
    if (!bar || !erste) return;

    document.documentElement.dataset.stickyJs = "";

    /* Hysterese: Ohne den Abstand zwischen Ein- und Ausblendpunkt schaltet
       die Leiste am Rand des Hero bei jeder kleinen Bewegung um - das war
       das Springen beim Scrollen. */
    const PUFFER = 90;
    let schwelle = 0;
    let sichtbar = true;
    let geplant = false;

    const messen = () => {
      schwelle = erste.offsetTop + erste.offsetHeight;
    };

    const anwenden = () => {
      geplant = false;
      // Bei geöffnetem Menü liegt die Leiste hinter dem Overlay - dann weg.
      if (document.body.classList.contains("menu-open")) {
        if (sichtbar) {
          sichtbar = false;
          bar.setAttribute("data-hidden", "");
          bar.setAttribute("aria-hidden", "true");
        }
        return;
      }
      const y = window.scrollY;
      const soll = sichtbar ? y > schwelle - PUFFER : y > schwelle;
      if (soll === sichtbar) return;
      sichtbar = soll;
      if (soll) {
        bar.removeAttribute("data-hidden");
        bar.removeAttribute("aria-hidden");
      } else {
        bar.setAttribute("data-hidden", "");
        bar.setAttribute("aria-hidden", "true");
      }
    };

    /* Ein einziger Zeitgeber für alle Auslöser. Der Zustand wird jedes Mal
       neu aus scrollY berechnet, nie fortgeschrieben - deshalb kann er auch
       nach gesperrtem Body-Scroll oder einem Sprung nicht hängen bleiben. */
    const planen = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(anwenden);
    };

    const neuMessen = () => {
      messen();
      planen();
    };

    messen();
    anwenden();

    addEventListener("scroll", planen, { passive: true });
    addEventListener("resize", neuMessen, { passive: true });
    addEventListener("orientationchange", neuMessen, { passive: true });
    // Rückkehr über die Verlaufstasten stellt den Zustand wieder her.
    addEventListener("pageshow", neuMessen);
    if (document.fonts?.ready) document.fonts.ready.then(neuMessen);

    // Menü auf und zu: der Body wechselt die Klasse, danach neu bewerten.
    new MutationObserver(planen).observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
    });
  })();
</script>
