---
import Icon from "./Icon.astro";
import { telUrl, whatsappUrl } from "../data/site";
---

<div class="sticky-call" role="complementary" aria-label="Schnellkontakt">
  <a class="sticky-primary" href={telUrl}>
    <Icon name="phone" size={18} />
    <span>Anrufen</span>
  </a>
  <a
    class="sticky-secondary"
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name="whatsapp" size={18} />
    <span>WhatsApp</span>
  </a>
</div>

<style>
  .sticky-call {
    position: fixed;
    inset: auto 0 0;
    z-index: 90;
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
    height: calc(66px + env(safe-area-inset-bottom));
    padding: 0.6rem 0.875rem calc(0.6rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--on-dark-hairline);
    background: rgba(10, 23, 48, 0.95);
    backdrop-filter: blur(16px);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.28);
  }

  .sticky-call a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-utility);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .sticky-call a:active {
    transform: scale(0.97);
  }

  .sticky-primary {
    background: linear-gradient(180deg, var(--blue-bright), var(--blue));
    box-shadow: var(--glow-blue);
  }

  .sticky-secondary {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 767px) {
    .sticky-call {
      display: grid;
    }
  }
</style>
