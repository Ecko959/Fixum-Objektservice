---
import Base from "../layouts/Base.astro";
import AreaServed from "./AreaServed.astro";
import CtaBand from "./CtaBand.astro";
import FaqAccordion from "./FaqAccordion.astro";
import Icon from "./Icon.astro";
import PageHero from "./PageHero.astro";
import RelatedServices from "./RelatedServices.astro";
import { canonicalPath, serviceSchema } from "../data/seo";

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  eyebrow: string;
  heroText: string;
  image?: string;
  imageAlt?: string;
  lead: string;
  included: string[];
  process: Array<[string, string]>;
  noteTitle?: string;
  noteText?: string;
  /** Kurzer, sichtbarer Vertrauensblock rechts neben dem Leistungsumfang. */
  facts?: Array<[string, string]>;
  /** Seiteneigene Fragen - erzeugen zusätzlich ein FAQ-Rich-Result. */
  faq?: Array<{ question: string; answer: string }>;
  /** Label für die Brotkrumennavigation, sonst wird eyebrow genutzt. */
  crumb?: string;
  serviceType?: string;
  areaTitle?: string;
  current: string;
}

const {
  title,
  metaTitle,
  description,
  eyebrow,
  heroText,
  image = "/images/hero-renovation.png",
  imageAlt = "",
  lead,
  included,
  process,
  noteTitle = "Klarer Umfang statt Ratespiel",
  noteText = "Nach Besichtigung oder aussagekräftigen Fotos bekommen Sie ein Angebot mit Leistungsumfang, Termin und Preis. Was nicht Teil der Leistung ist, steht genauso klar drin.",
  facts = [
    ["Besichtigung", "Kostenlos und unverbindlich, meist in zwei Werktagen."],
    ["Angebot", "Festpreis in Textform, mit klarer Leistungsgrenze."],
    ["Abwicklung", "Ein Ansprechpartner vom Anruf bis zur Übergabe."],
  ],
  faq = [],
  crumb,
  serviceType,
  areaTitle,
  current,
} = Astro.props;

const path = canonicalPath(current);
const breadcrumbs: Array<[string, string]> = [
  ["Leistungen", "/leistungen/"],
  [crumb ?? eyebrow, path],
];

const schema = [serviceSchema({ name: title, description, path, serviceType })];
---

<Base
  title={metaTitle}
  description={description}
  canonical={path}
  breadcrumbs={breadcrumbs}
  schema={schema}
  faqSchema={false}
  preloadImage={image}
  pageType="WebPage"
>
  <PageHero
    eyebrow={eyebrow}
    title={title}
    text={heroText}
    image={image}
    imageAlt={imageAlt}
    breadcrumbs={breadcrumbs}
  />

  {/* Leistungsumfang */}
  <section class="section">
    <div class="container split split--top">
      <div class="stack" data-reveal>
        <p class="eyebrow">Leistungsumfang</p>
        <h2>Was dazugehört</h2>
        <p class="lead">{lead}</p>

        <ul class="check-list detail-check">
          {included.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <aside class="facts card" data-reveal aria-label="Ablauf auf einen Blick">
        <p class="facts-title">So läuft es ab</p>
        <dl>
          {
            facts.map(([term, text]) => (
              <div class="fact">
                <dt>{term}</dt>
                <dd>{text}</dd>
              </div>
            ))
          }
        </dl>
        <a class="arrow-link" href="/kontakt/">Festpreis anfragen</a>
      </aside>
    </div>
  </section>

  {/* Ablauf in drei Schritten */}
  <section class="section section--mist">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Ablauf</p>
      <h2>In drei Schritten zum Ergebnis</h2>
    </div>
    <div class="container grid-3 detail-grid" data-reveal-group>
      {
        process.map(([headline, text], index) => (
          <article class="detail-step card" data-reveal>
            <span class="step-no">{String(index + 1).padStart(2, "0")}</span>
            <h3>{headline}</h3>
            <p>{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* Leistungsgrenzen */}
  <section class="section section--tight">
    <div class="container note-card card card--accent" data-reveal>
      <span class="note-icon"><Icon name="shield" size={24} /></span>
      <div>
        <p class="eyebrow">Wichtig zu wissen</p>
        <h2>{noteTitle}</h2>
        <p class="muted">{noteText}</p>
      </div>
    </div>
  </section>

  {
    faq.length > 0 && (
      <section class="section section--soft">
        <div class="container section-head" data-reveal>
          <p class="eyebrow">Häufige Fragen</p>
          <h2>Was Auftraggeber vorher wissen wollen</h2>
        </div>
        <div class="container container--narrow faq-wrap" data-reveal>
          <FaqAccordion items={faq} />
        </div>
      </section>
    )
  }

  <AreaServed service={crumb ?? eyebrow} title={areaTitle} />
  <RelatedServices current={current} />
  <CtaBand />
</Base>

{
  /* FAQ-Rich-Result nur, wenn die Fragen tatsächlich auf der Seite stehen. */
  faq.length > 0 && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      })}
    />
  )
}

<style>
  .detail-check {
    padding-left: clamp(1.5rem, 3vw, 2rem);
    padding-right: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--mist-soft);
  }

  /* ---- Faktenkarte ---- */
  .facts {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  .facts-title {
    margin-bottom: 1.125rem;
    font-family: var(--font-utility);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .facts dl {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.25rem;
  }

  .fact {
    display: grid;
    gap: 0.2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--line);
  }

  .fact dt {
    font-weight: 800;
    font-size: 1rem;
    color: var(--navy);
  }

  .fact dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ---- Ablaufkarten ---- */
  .detail-step {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .step-no {
    font-family: var(--font-utility);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--amber);
  }

  .detail-step p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* ---- Hinweisblock ---- */
  .note-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--mist-soft);
  }

  .note-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    color: var(--navy-deep);
    background: var(--amber);
  }

  .note-card h2 {
    margin: 0.35rem 0 0.75rem;
    font-size: var(--step-3);
  }

  @media (max-width: 900px) {
    .facts {
      position: static;
    }

    .note-card {
      grid-template-columns: 1fr;
    }
  }
</style>
