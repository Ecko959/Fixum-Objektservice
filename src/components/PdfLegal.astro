---
import Breadcrumbs from "./Breadcrumbs.astro";
import Icon from "./Icon.astro";
import { mailUrl, site, telUrl } from "../data/site";

interface Props {
  title: string;
  intro: string;
  pdf: string;
  breadcrumbs: Array<[string, string]>;
  /** Kurze Zusammenfassung als HTML-Text - sonst hätte die Seite keinen indexierbaren Inhalt. */
  summary?: string[];
}

const { title, intro, pdf, breadcrumbs, summary = [] } = Astro.props;
---

<section class="section legal-page page-top section--mist">
  <div class="container container--narrow">
    <Breadcrumbs trail={breadcrumbs} class="legal-crumbs" />

    <div class="legal-card card">
      <p class="eyebrow">Rechtliches</p>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>

      {
        summary.length > 0 && (
          <ul class="check-list legal-summary">
            {summary.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }

      <div class="legal-actions">
        <a class="btn" href={pdf} download>
          <Icon name="clipboard" size={18} />
          <span>PDF herunterladen</span>
        </a>
        <a class="btn btn--secondary" href={pdf} target="_blank" rel="noopener">
          <span>In neuem Tab öffnen</span>
        </a>
      </div>

      <object data={pdf} type="application/pdf" class="pdf-view">
        <p class="pdf-fallback">
          Dieses PDF kann in Ihrem Browser nicht eingebettet angezeigt werden.
          Bitte nutzen Sie den Download-Link oben.
        </p>
      </object>

      <p class="legal-contact">
        Fragen zu diesem Dokument? <a href={telUrl}>{site.phoneDisplay}</a> oder
        <a href={mailUrl}>{site.email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .legal-crumbs {
    margin-bottom: 1.25rem;
  }

  .legal-card {
    display: grid;
    gap: 1.125rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: var(--shadow-md);
  }

  .legal-summary {
    padding: clamp(1.125rem, 2.5vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--mist-soft);
  }

  .legal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pdf-view {
    width: 100%;
    min-height: min(760px, 85vh);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fff;
  }

  .pdf-fallback {
    padding: 1.5rem;
    color: var(--muted);
  }

  .legal-contact {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .legal-contact a {
    color: var(--blue);
    font-weight: 700;
  }
</style>
