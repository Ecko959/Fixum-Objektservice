---
import { mailUrl, site, telUrl, whatsappUrl } from "../data/site";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const topics = [
  "Entrümpelung / Haushaltsauflösung",
  "Entkernung & Rückbau",
  "Trockenbau & Innenausbau",
  "Montage & Bodenverlegung",
  "Hausmeisterservice / Rahmenvertrag",
  "Anfrage als Bauunternehmen",
];
---

{
  endpoint ? (
    <form
      class="contact-form"
      method="post"
      action={endpoint}
      data-contact-form
    >
      <input type="hidden" name="_redirect" value="/danke" />
      <p class="form-title">Kostenlose Besichtigung anfragen</p>
      <p class="muted">Wir melden uns am selben Werktag zurück.</p>
      <div class="honeypot" aria-hidden="true">
        <label>
          Bitte leer lassen{" "}
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <label>
        Name / Firma
        <input
          name="name"
          type="text"
          required
          autocomplete="name"
          data-message="Bitte geben Sie Ihren Namen ein."
        />
        <span class="error" />
      </label>
      <label>
        Telefon
        <input
          name="telefon"
          type="tel"
          required
          autocomplete="tel"
          data-message="Bitte geben Sie Ihre Telefonnummer ein."
        />
        <span class="error" />
      </label>
      <label>
        E-Mail
        <input
          name="email"
          type="email"
          autocomplete="email"
          data-message="Bitte geben Sie eine gültige E-Mail-Adresse ein."
        />
        <span class="error" />
      </label>
      <label>
        Worum geht es?
        <select
          name="thema"
          required
          data-message="Bitte wählen Sie ein Thema aus."
        >
          <option value="">Bitte auswählen</option>
          {topics.map((topic) => (
            <option>{topic}</option>
          ))}
        </select>
        <span class="error" />
      </label>
      <label>
        Objekt & Ort
        <input name="objekt_ort" type="text" autocomplete="street-address" />
      </label>
      <label>
        Ihre Nachricht
        <textarea name="nachricht" rows="4" />
      </label>
      <label class="checkbox">
        <input
          name="datenschutz"
          type="checkbox"
          required
          data-message="Bitte bestätigen Sie den Datenschutzhinweis."
        />
        <span>Ich habe die Datenschutzerklärung gelesen.</span>
        <span class="error" />
      </label>
      <button class="btn" type="submit">
        Anfrage senden
      </button>
      <small>Unverbindlich. Ohne Kosten. Ohne Vertreterbesuch.</small>
    </form>
  ) : (
    <div class="contact-fallback card">
      <p class="form-title">Kostenlose Besichtigung anfragen</p>
      <p class="muted">
        Das Online-Formular wird aktiviert, sobald der Formspree-Endpunkt
        gesetzt ist. Bis dahin erreichen Sie Fixum direkt per Telefon, WhatsApp
        oder E-Mail.
      </p>
      <a class="btn" href={telUrl}>
        Anrufen - {site.phoneDisplay}
      </a>
      <a class="btn btn--secondary" href={whatsappUrl()}>
        Foto per WhatsApp schicken
      </a>
      <a href={mailUrl}>{site.email}</a>
    </div>
  )
}

<script>
  document.querySelectorAll("[data-contact-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      let valid = true;
      form.querySelectorAll("input, select, textarea").forEach((field) => {
        const input = field;
        const error = input.parentElement?.querySelector(".error");
        if (!(
          input instanceof HTMLInputElement ||
          input instanceof HTMLSelectElement ||
          input instanceof HTMLTextAreaElement
        ))
          return;
        if (!input.checkValidity()) {
          valid = false;
          const message =
            input.dataset.message || "Bitte prüfen Sie dieses Feld.";
          input.setAttribute("aria-invalid", "true");
          if (error) error.textContent = message;
        } else {
          input.removeAttribute("aria-invalid");
          if (error) error.textContent = "";
        }
      });
      if (!valid) event.preventDefault();
    });
  });
</script>

<style>
  .contact-form,
  .contact-fallback {
    display: grid;
    gap: 14px;
    padding: 28px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 14px 40px rgba(16, 36, 78, 0.16);
  }

  .form-title {
    color: var(--navy);
    font-family: "Outfit", sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
  }

  label {
    display: grid;
    gap: 6px;
    color: var(--navy);
    font-weight: 500;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    color: var(--ink);
    background: #fff;
  }

  textarea {
    resize: vertical;
  }

  .checkbox {
    grid-template-columns: 20px 1fr;
    align-items: start;
  }

  .checkbox .error {
    grid-column: 2;
  }

  .checkbox input {
    width: 20px;
    height: 20px;
    margin-top: 4px;
  }

  .error {
    min-height: 18px;
    color: #9d1c1c;
    font-size: 13px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  small {
    color: var(--muted);
  }

  .contact-fallback .btn {
    width: 100%;
  }
</style>
