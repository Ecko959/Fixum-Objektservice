---
import Icon from "./Icon.astro";
import WhatsAppMark from "./WhatsAppMark.astro";
import { mailUrl, site, telUrl, whatsappUrl } from "../data/site";

interface Props {
  /** Vorbelegtes Thema, z. B. von einer Leistungsseite aus. */
  topic?: string;
  title?: string;
}

const { topic = "", title = "Kostenlose Besichtigung anfragen" } = Astro.props;

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const topics = [
  "Entrümpelung / Haushaltsauflösung",
  "Entkernung & Rückbau",
  "Trockenbau & Innenausbau",
  "Montage & Bodenverlegung",
  "Umzug / Transport",
  "Hausmeisterservice / Rahmenvertrag",
  "Anfrage als Bauunternehmen",
];
---

{
  endpoint ? (
    <form
      class="contact-form"
      method="post"
      action={endpoint}
      novalidate
      data-contact-form
    >
      <input type="hidden" name="_redirect" value="/danke/" />
      <input
        type="hidden"
        name="_subject"
        value="Website-Anfrage Fixum Objektservice"
      />

      <div class="form-head">
        <p class="form-title">{title}</p>
        <p class="form-sub">Wir melden uns am selben Werktag zurück.</p>
      </div>

      {/* Honeypot: für Menschen unsichtbar, für Bots ein Pflichtfeld zum Hineintappen. */}
      <div class="honeypot" aria-hidden="true">
        <label>
          Bitte leer lassen
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="field-row">
        <label class="field">
          <span class="field-label">Name / Firma *</span>
          <input
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Ihr Name"
            data-message="Bitte geben Sie Ihren Namen ein."
          />
          <span class="error" aria-live="polite" />
        </label>

        <label class="field">
          <span class="field-label">Telefon *</span>
          <input
            name="telefon"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            placeholder="Für Rückfragen"
            data-message="Bitte geben Sie Ihre Telefonnummer ein."
          />
          <span class="error" aria-live="polite" />
        </label>
      </div>

      <label class="field">
        <span class="field-label">E-Mail</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder="optional"
          data-message="Bitte geben Sie eine gültige E-Mail-Adresse ein."
        />
        <span class="error" aria-live="polite" />
      </label>

      <label class="field">
        <span class="field-label">Worum geht es? *</span>
        <div class="select-wrap">
          <select
            name="thema"
            required
            data-message="Bitte wählen Sie ein Thema aus."
          >
            <option value="">Bitte auswählen</option>
            {topics.map((item) => (
              <option selected={item === topic}>{item}</option>
            ))}
          </select>
        </div>
        <span class="error" aria-live="polite" />
      </label>

      <label class="field">
        <span class="field-label">Objekt & Ort</span>
        <input
          name="objekt_ort"
          type="text"
          autocomplete="street-address"
          placeholder="z. B. 3-Zimmer-Wohnung, Emden"
        />
      </label>

      <label class="field">
        <span class="field-label">Ihre Nachricht</span>
        <textarea
          name="nachricht"
          rows="4"
          placeholder="Umfang, Wunschtermin, Besonderheiten"
        />
      </label>

      <label class="field checkbox">
        <input
          name="datenschutz"
          type="checkbox"
          required
          data-message="Bitte bestätigen Sie den Datenschutzhinweis."
        />
        <span>
          Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen.
          *
        </span>
        <span class="error" aria-live="polite" />
      </label>

      <button class="btn btn--wide" type="submit">
        <span>Anfrage senden</span>
      </button>

      <p class="form-note">
        <Icon name="shield" size={16} />
        <span>Unverbindlich. Ohne Kosten. Ohne Vertreterbesuch.</span>
      </p>
    </form>
  ) : (
    <div class="contact-fallback">
      <div class="form-head">
        <p class="form-title">{title}</p>
        <p class="form-sub">
          Am schnellsten geht es direkt - Telefon, WhatsApp oder E-Mail.
        </p>
      </div>
      <a class="btn btn--wide" href={telUrl}>
        <Icon name="phone" size={18} />
        <span>Jetzt anrufen</span>
      </a>
      <a
        class="btn btn--secondary btn--wa btn--wide"
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppMark size={24} />
        <span>Foto per WhatsApp schicken</span>
      </a>
      <a class="fallback-mail" href={mailUrl}>
        <Icon name="mail" size={18} />
        <span>{site.email}</span>
      </a>
      <p class="form-note">
        <Icon name="clock" size={16} />
        <span>{site.hours}</span>
      </p>
    </div>
  )
}

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-contact-form]")
    .forEach((form) => {
      const fields = form.querySelectorAll<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >("input, select, textarea");

      const validate = (
        field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      ) => {
        const wrapper = field.closest(".field");
        const error = wrapper?.querySelector(".error");
        const ok = field.checkValidity();

        field.setAttribute("aria-invalid", ok ? "false" : "true");
        wrapper?.classList.toggle("has-error", !ok);
        if (error) {
          error.textContent = ok
            ? ""
            : field.dataset.message || "Bitte prüfen Sie dieses Feld.";
        }
        return ok;
      };

      // Erst nach dem ersten Absendeversuch live prüfen - sonst meckert
      // das Formular schon beim Tippen im ersten Feld.
      let submitted = false;
      fields.forEach((field) => {
        field.addEventListener("blur", () => submitted && validate(field));
        field.addEventListener("input", () => submitted && validate(field));
        field.addEventListener("change", () => submitted && validate(field));
      });

      form.addEventListener("submit", (event) => {
        submitted = true;
        const invalid = [...fields].filter((field) => !validate(field));
        const firstInvalid = invalid[0];

        if (firstInvalid) {
          event.preventDefault();
          firstInvalid.focus();
          firstInvalid.scrollIntoView({ block: "center", behavior: "smooth" });
        }
      });
    });
</script>

<style>
  .contact-form,
  .contact-fallback {
    display: grid;
    gap: 0.875rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }

  .form-head {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .form-title {
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  .form-sub {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  .field-label {
    font-family: var(--font-utility);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--mist-soft);
    color: var(--ink);
    font-size: 1rem;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  input::placeholder,
  textarea::placeholder {
    color: #96a3b8;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--blue-bright);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(31, 122, 224, 0.14);
  }

  textarea {
    resize: vertical;
    min-height: 110px;
  }

  /* Eigener Pfeil, damit das Select in beiden Systemen gleich aussieht */
  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: "";
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 2px solid var(--blue);
    border-bottom: 2px solid var(--blue);
    transform: rotate(45deg);
    pointer-events: none;
  }

  select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .checkbox {
    grid-template-columns: 22px 1fr;
    align-items: start;
    gap: 0.375rem 0.625rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .checkbox input {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    padding: 0;
    accent-color: var(--blue);
    cursor: pointer;
  }

  .checkbox a {
    color: var(--blue);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .checkbox .error {
    grid-column: 2;
  }

  .error {
    min-height: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: #b3261e;
  }

  .has-error input,
  .has-error select,
  .has-error textarea {
    border-color: #b3261e;
    background: #fef5f4;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .form-note :global(.icon) {
    color: var(--blue);
  }

  .fallback-mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem;
    color: var(--blue);
    font-weight: 700;
  }

  @media (max-width: 480px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
