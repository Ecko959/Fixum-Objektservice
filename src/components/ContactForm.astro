---
import Icon from "./Icon.astro";
import WhatsAppMark from "./WhatsAppMark.astro";
import { mailUrl, site, telUrl, whatsappUrl } from "../data/site";
import { whatsappThema } from "../data/whatsapp";

/* Betreff je Seite - siehe src/data/whatsapp.ts. */
const waThema = whatsappThema(Astro.url.pathname);

interface Props {
  /** Vorbelegtes Thema, z. B. von einer Leistungsseite aus. */
  topic?: string;
  title?: string;
}

const { topic = "", title = "Kostenlose Besichtigung anfragen" } = Astro.props;

/* Das Formular schickt an die Pages Function functions/api/anfrage.ts, die
   per Resend eine E-Mail mit den Fotos als Anhang verschickt. Solange in
   Cloudflare kein RESEND_API_KEY hinterlegt ist, zeigt die Seite statt des
   Formulars Telefon, WhatsApp und E-Mail - sonst liefe jede Anfrage ins
   Leere. PUBLIC_FORMULAR_AKTIV schaltet es zusätzlich von Hand an. */
const aktiv = Boolean(
  import.meta.env.RESEND_API_KEY || import.meta.env.PUBLIC_FORMULAR_AKTIV,
);
const seite = Astro.url.pathname;
const topics = [
  "Entrümpelung / Haushaltsauflösung",
  "Entkernung & Rückbau",
  "Trockenbau & Innenausbau",
  "Montage & Bodenverlegung",
  "Umzug / Transport",
  "Hausmeisterservice / Rahmenvertrag",
  "Anfrage als Bauunternehmen",
];
---

{
  aktiv ? (
    <form
      class="contact-form"
      method="post"
      action="/api/anfrage"
      enctype="multipart/form-data"
      novalidate
      data-contact-form
    >
      <input type="hidden" name="seite" value={seite} />

      <div class="form-head">
        <p class="form-title">{title}</p>
        <p class="form-sub">Wir melden uns am selben Werktag zurück.</p>
      </div>

      {/* Honeypot: für Menschen unsichtbar, für Bots ein Pflichtfeld zum Hineintappen. */}
      <div class="honeypot" aria-hidden="true">
        <label>
          Bitte leer lassen
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="field-row">
        <label class="field">
          <span class="field-label">Name / Firma *</span>
          <input
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Ihr Name"
            data-message="Bitte geben Sie Ihren Namen ein."
          />
          <span class="error" aria-live="polite" />
        </label>

        <label class="field">
          <span class="field-label">Telefon *</span>
          <input
            name="telefon"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            placeholder="Für Rückfragen"
            data-message="Bitte geben Sie Ihre Telefonnummer ein."
          />
          <span class="error" aria-live="polite" />
        </label>
      </div>

      <label class="field">
        <span class="field-label">E-Mail</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder="optional"
          data-message="Bitte geben Sie eine gültige E-Mail-Adresse ein."
        />
        <span class="error" aria-live="polite" />
      </label>

      <label class="field">
        <span class="field-label">Worum geht es? *</span>
        <div class="select-wrap">
          <select
            name="thema"
            required
            data-message="Bitte wählen Sie ein Thema aus."
          >
            <option value="">Bitte auswählen</option>
            {topics.map((item) => (
              <option selected={item === topic}>{item}</option>
            ))}
          </select>
        </div>
        <span class="error" aria-live="polite" />
      </label>

      <label class="field">
        <span class="field-label">Objekt & Ort</span>
        <input
          name="objekt_ort"
          type="text"
          autocomplete="street-address"
          placeholder="z. B. 3-Zimmer-Wohnung, Emden"
        />
      </label>

      <label class="field">
        <span class="field-label">Ihre Nachricht</span>
        <textarea
          name="nachricht"
          rows="4"
          placeholder="Umfang, Wunschtermin, Besonderheiten"
        />
      </label>

      <div class="field fotos" data-fotos>
        <span class="field-label">
          Fotos <span class="optional">optional, bis 6</span>
        </span>
        <label class="foto-feld">
          <input
            class="foto-input"
            type="file"
            name="fotos"
            accept="image/*"
            multiple
            data-foto-input
          />
          <span class="foto-icon">
            <Icon name="kamera" size={22} />
          </span>
          <span class="foto-text">
            <strong>Fotos hinzufügen</strong>
            <small>
              Kamera oder Galerie - damit nennen wir schneller einen Preis
            </small>
          </span>
        </label>
        <ul class="foto-liste" data-foto-liste aria-label="Ausgewählte Fotos" />
        <span class="error" aria-live="polite" data-foto-hinweis />
      </div>

      <label class="field checkbox">
        <input
          name="datenschutz"
          type="checkbox"
          required
          data-message="Bitte bestätigen Sie den Datenschutzhinweis."
        />
        <span>
          Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen.
          *
        </span>
        <span class="error" aria-live="polite" />
      </label>

      <button class="btn btn--wide" type="submit" data-senden>
        <span data-senden-text>Anfrage senden</span>
      </button>

      <p
        class="form-status"
        role="status"
        aria-live="polite"
        data-status
        hidden
      >
        Das hat leider nicht geklappt. Bitte rufen Sie uns an unter
        <a href={telUrl}>{site.phoneDisplay}</a> oder schicken Sie die Fotos per{" "}
        <a
          href={whatsappUrl(waThema)}
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
        .
      </p>

      <p class="form-note">
        <Icon name="shield" size={16} />
        <span>Unverbindlich. Ohne Kosten. Ohne Vertreterbesuch.</span>
      </p>
    </form>
  ) : (
    <div class="contact-fallback">
      <div class="form-head">
        <p class="form-title">{title}</p>
        <p class="form-sub">
          Am schnellsten geht es direkt - Telefon, WhatsApp oder E-Mail.
        </p>
      </div>
      <a class="btn btn--wide" href={telUrl}>
        <Icon name="phone" size={18} />
        <span>Jetzt anrufen</span>
      </a>
      <a
        class="btn btn--secondary btn--wa btn--wide"
        href={whatsappUrl(waThema)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppMark size={24} />
        <span>Foto per WhatsApp schicken</span>
      </a>
      <a class="fallback-mail" href={mailUrl}>
        <Icon name="mail" size={18} />
        <span>{site.email}</span>
      </a>
      <p class="form-note">
        <Icon name="clock" size={16} />
        <span>{site.hours}</span>
      </p>
    </div>
  )
}

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-contact-form]")
    .forEach((form) => {
      const fields = form.querySelectorAll<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >("input, select, textarea");

      const validate = (
        field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      ) => {
        const wrapper = field.closest(".field");
        const error = wrapper?.querySelector(".error");
        const ok = field.checkValidity();

        field.setAttribute("aria-invalid", ok ? "false" : "true");
        wrapper?.classList.toggle("has-error", !ok);
        if (error) {
          error.textContent = ok
            ? ""
            : field.dataset.message || "Bitte prüfen Sie dieses Feld.";
        }
        return ok;
      };

      // Erst nach dem ersten Absendeversuch live prüfen - sonst meckert
      // das Formular schon beim Tippen im ersten Feld.
      let submitted = false;
      fields.forEach((field) => {
        field.addEventListener("blur", () => submitted && validate(field));
        field.addEventListener("input", () => submitted && validate(field));
        field.addEventListener("change", () => submitted && validate(field));
      });

      /* ---- Fotos: auswählen, Vorschau, vor dem Senden verkleinern ---- */
      const MAX_FOTOS = 6;
      const input = form.querySelector<HTMLInputElement>("[data-foto-input]");
      const liste = form.querySelector<HTMLUListElement>("[data-foto-liste]");
      const hinweis = form.querySelector<HTMLElement>("[data-foto-hinweis]");
      let auswahl: File[] = [];

      const zeichnen = () => {
        if (!liste) return;
        liste
          .querySelectorAll("img")
          .forEach((img) => URL.revokeObjectURL(img.src));
        liste.replaceChildren(
          ...auswahl.map((datei, i) => {
            const li = document.createElement("li");
            const img = document.createElement("img");
            img.src = URL.createObjectURL(datei);
            img.alt = "";
            const weg = document.createElement("button");
            weg.type = "button";
            weg.className = "foto-weg";
            weg.setAttribute("aria-label", `Foto ${i + 1} entfernen`);
            weg.textContent = "×";
            weg.addEventListener("click", () => {
              auswahl.splice(i, 1);
              zeichnen();
            });
            li.append(img, weg);
            return li;
          }),
        );
      };

      input?.addEventListener("change", () => {
        const neu = [...(input.files ?? [])].filter((f) =>
          f.type.startsWith("image/"),
        );
        const frei = MAX_FOTOS - auswahl.length;
        auswahl = auswahl.concat(neu.slice(0, frei));
        if (hinweis) {
          hinweis.textContent =
            neu.length > frei ? `Es gehen höchstens ${MAX_FOTOS} Fotos.` : "";
        }
        /* Das Feld selbst leeren - gesendet wird die Auswahl oben. So kann
           man mehrmals hintereinander Fotos hinzufügen. */
        input.value = "";
        zeichnen();
      });

      /* Handyfotos haben 3-10 MB. Auf 1920 px Kantenlänge als JPEG reicht
         für die Einschätzung und bleibt unter 1 MB. Klappt es nicht (z. B.
         unbekanntes Format), geht das Original. */
      const verkleinern = async (datei: File): Promise<File> => {
        try {
          const bild = await createImageBitmap(datei);
          const faktor = Math.min(1, 1920 / Math.max(bild.width, bild.height));
          const canvas = document.createElement("canvas");
          canvas.width = Math.round(bild.width * faktor);
          canvas.height = Math.round(bild.height * faktor);
          canvas
            .getContext("2d")
            ?.drawImage(bild, 0, 0, canvas.width, canvas.height);
          bild.close();
          const blob = await new Promise<Blob | null>((ok) =>
            canvas.toBlob(ok, "image/jpeg", 0.82),
          );
          if (!blob || blob.size >= datei.size) return datei;
          const name = datei.name.replace(/\.[^.]+$/, "") || "foto";
          return new File([blob], `${name}.jpg`, { type: "image/jpeg" });
        } catch {
          return datei;
        }
      };

      const status = form.querySelector<HTMLElement>("[data-status]");
      const knopf = form.querySelector<HTMLButtonElement>("[data-senden]");
      const knopfText = form.querySelector<HTMLElement>("[data-senden-text]");
      if (status && new URLSearchParams(location.search).has("fehler")) {
        status.hidden = false;
      }

      form.addEventListener("submit", async (event) => {
        submitted = true;
        const invalid = [...fields].filter((field) => !validate(field));
        const firstInvalid = invalid[0];

        if (firstInvalid) {
          event.preventDefault();
          firstInvalid.focus();
          firstInvalid.scrollIntoView({ block: "center", behavior: "smooth" });
          return;
        }

        /* Mit JavaScript: per fetch senden, damit die Fotos verkleinert
           mitgehen. Ohne JavaScript schickt der Browser das Formular normal. */
        event.preventDefault();
        if (knopf) knopf.disabled = true;
        if (knopfText) {
          knopfText.textContent = auswahl.length
            ? "Fotos werden gesendet …"
            : "Wird gesendet …";
        }
        if (status) status.hidden = true;

        try {
          const daten = new FormData(form);
          daten.delete("fotos");
          for (const datei of await Promise.all(auswahl.map(verkleinern))) {
            daten.append("fotos", datei, datei.name);
          }
          const antwort = await fetch(form.action, {
            method: "POST",
            body: daten,
            headers: { Accept: "application/json" },
          });
          if (!antwort.ok) throw new Error(String(antwort.status));
          location.href = "/danke/";
        } catch {
          if (status) {
            status.hidden = false;
            status.scrollIntoView({ block: "center", behavior: "smooth" });
          }
          if (knopf) knopf.disabled = false;
          if (knopfText) knopfText.textContent = "Erneut senden";
        }
      });
    });
</script>

<style>
  .contact-form,
  .contact-fallback {
    display: grid;
    gap: 0.875rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }

  .form-head {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .form-title {
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  .form-sub {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  .field-label {
    font-family: var(--font-utility);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--mist-soft);
    color: var(--ink);
    font-size: 1rem;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  input::placeholder,
  textarea::placeholder {
    color: #96a3b8;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--blue-bright);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(31, 122, 224, 0.14);
  }

  textarea {
    resize: vertical;
    min-height: 110px;
  }

  /* Eigener Pfeil, damit das Select in beiden Systemen gleich aussieht */
  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: "";
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 2px solid var(--blue);
    border-bottom: 2px solid var(--blue);
    transform: rotate(45deg);
    pointer-events: none;
  }

  select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .checkbox {
    grid-template-columns: 22px 1fr;
    align-items: start;
    gap: 0.375rem 0.625rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .checkbox input {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    padding: 0;
    accent-color: var(--blue);
    cursor: pointer;
  }

  .checkbox a {
    color: var(--blue);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .checkbox .error {
    grid-column: 2;
  }

  .error {
    min-height: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: #b3261e;
  }

  .has-error input,
  .has-error select,
  .has-error textarea {
    border-color: #b3261e;
    background: #fef5f4;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .form-note :global(.icon) {
    color: var(--blue);
  }

  .fallback-mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem;
    color: var(--blue);
    font-weight: 700;
  }

  /* ---- Fotos ---- */
  .optional {
    margin-left: 0.35rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .foto-feld {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--mist-soft);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }

  .foto-feld:hover,
  .foto-feld:focus-within {
    border-color: var(--blue-bright);
    background: #fff;
  }

  /* Das echte Eingabefeld liegt unsichtbar über der ganzen Fläche - so
     bleibt es per Tastatur und Screenreader bedienbar. */
  .foto-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
  }

  .foto-feld:focus-within {
    outline: 3px solid var(--blue-light);
    outline-offset: 2px;
  }

  .foto-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: #fff;
    background: var(--navy);
  }

  .foto-text {
    display: grid;
    gap: 0.1rem;
    line-height: 1.3;
  }

  .foto-text strong {
    color: var(--navy);
  }

  .foto-text small {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .foto-liste {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foto-liste:empty {
    display: none;
  }

  .foto-liste :global(li) {
    position: relative;
    width: 64px;
    height: 64px;
  }

  .foto-liste :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .foto-liste :global(.foto-weg) {
    position: absolute;
    top: -6px;
    right: -6px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 2px solid #fff;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    line-height: 1;
    color: #fff;
    background: var(--navy);
    cursor: pointer;
  }

  .form-status {
    padding: 0.75rem 0.875rem;
    border-left: 3px solid #b3261e;
    background: #fef5f4;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .form-status a {
    color: var(--blue);
    font-weight: 700;
    text-decoration: underline;
  }

  [data-senden]:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  @media (max-width: 480px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
