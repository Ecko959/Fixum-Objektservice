---
import { services } from "../data/services";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
const related = services.filter((service) => service.href !== current);
---

<section class="section related-services">
  <div class="container related-head">
    <p class="eyebrow">Weitere Leistungen</p>
    <h2>Alles sauber verbunden</h2>
  </div>
  <div class="container related-grid">
    {
      related.map((service) => (
        <a href={service.href} class="related-card">
          <span>
            <img src="/logo/fixum-icon.png" alt="" width="34" height="34" />
          </span>
          <strong>{service.title}</strong>
          <small>Mehr erfahren</small>
        </a>
      ))
    }
  </div>
</section>

<style>
  .related-services {
    background: #f7fbff;
  }

  .related-head {
    margin-bottom: 24px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .related-card {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 12px 16px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 18px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(16, 36, 78, 0.08);
  }

  .related-card span {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--navy-deep);
  }

  .related-card img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .related-card strong {
    color: var(--navy);
    font-family: "Manrope", sans-serif;
    line-height: 1.15;
  }

  .related-card small {
    color: var(--blue);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
