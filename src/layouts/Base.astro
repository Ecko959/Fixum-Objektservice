---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StickyCallBar from "../components/StickyCallBar.astro";
import {
  absolute,
  breadcrumbSchema,
  businessSchema,
  canonicalPath,
  faqPageSchema,
  ids,
  logoSchema,
  websiteSchema,
} from "../data/seo";
import { findeBild } from "../data/bilder";
import { heroQuellen } from "../lib/heroBild";
import { site } from "../data/site";
/* Fließtext (400) und Überschriften (800) stehen auf jeder Seite über der
   Falzlinie. Vite hängt denselben Hash an wie in der @font-face-Regel, der
   Preload trifft also genau die Datei, die das CSS später anfordert. */
import manrope400 from "@fontsource/manrope/files/manrope-latin-400-normal.woff2?url";
import manrope800 from "@fontsource/manrope/files/manrope-latin-800-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** FAQ-Rich-Result nur dort ausspielen, wo die Fragen auch auf der Seite stehen. */
  faqSchema?: boolean;
  /** Seiten ohne Suchwert (Danke-Seite, 404) aus dem Index halten. */
  noindex?: boolean;
  /** Social-Preview-Bild, absolut oder als interner Pfad. */
  image?: string;
  imageAlt?: string;
  /** Breadcrumb-Pfad als [Label, Pfad]-Paare ohne Startseite. */
  breadcrumbs?: Array<[string, string]>;
  /** Zusätzliche schema.org-Knoten dieser Seite (Service, ContactPage ...). */
  schema?: Record<string, unknown>[];
  /** Basispfad des LCP-Bildes, damit die AVIF-Variante vorgeladen wird. */
  preloadImage?: string;
  /** Semantischer Seitentyp für den WebPage-Knoten. */
  pageType?: string;
  datePublished?: string;
}

const {
  title,
  description,
  canonical,
  faqSchema = false,
  noindex = false,
  image,
  imageAlt = site.ogImageAlt,
  breadcrumbs = [],
  schema = [],
  preloadImage,
  pageType = "WebPage",
} = Astro.props;

const path = canonicalPath(canonical ?? Astro.url.pathname);
const canonicalUrl = absolute(path);
const socialImage = absolute(image ?? site.ogImage);
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
/* Das Hero-Bild ist das LCP-Element. Der Preload nennt genau die Datei, die
   PageHero als erste Wahl anbietet - beide kommen aus heroQuellen() -,
   sonst lädt der Browser zwei Fassungen statt einer. */
const heroQuelle = findeBild(preloadImage);
const preload = heroQuelle ? await heroQuellen(heroQuelle) : undefined;

const pageNode: Record<string, unknown> = {
  "@type": pageType,
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: "de-DE",
  isPartOf: { "@id": ids.website },
  about: { "@id": ids.business },
  primaryImageOfPage: socialImage,
};

if (breadcrumbs.length) {
  pageNode.breadcrumb = { "@id": `${canonicalUrl}#breadcrumb` };
}

/* Seitenname im Suchergebnis ("Fixum Objektservice" statt der Domain):
   Google liest ihn aus dem WebSite-Knoten der Startseite. Dort steht er
   deshalb als eigener, alleinstehender JSON-LD-Block - so, wie Googles
   Dokumentation es zeigt -, statt im @graph zu stecken. Auf allen anderen
   Seiten bleibt er Teil des Graphen. */
const istStartseite = path === "/";
const websiteJsonLd = istStartseite
  ? JSON.stringify({ "@context": "https://schema.org", ...websiteSchema })
  : undefined;

const graph: Record<string, unknown>[] = [
  logoSchema,
  businessSchema,
  ...(istStartseite ? [] : [websiteSchema]),
  pageNode,
  ...(breadcrumbs.length
    ? [
        {
          ...breadcrumbSchema(breadcrumbs),
          "@id": `${canonicalUrl}#breadcrumb`,
        },
      ]
    : []),
  ...(faqSchema ? [faqPageSchema] : []),
  ...schema,
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
});
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    {
      /* viewport-fit=cover: ohne diesen Wert liefert env(safe-area-inset-*)
         auf iOS immer 0, und die feste Kontaktleiste kann den Bereich um den
         Home-Indicator nicht berücksichtigen. Die Seitenränder gleicht
         .container über dieselben env()-Werte wieder aus. */
    }
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    {
      /* Reveal-Animationen nur aktivieren, wenn JS läuft - sonst bleibt alles sichtbar. */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={manrope400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={manrope800}
      crossorigin
    />

    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.avifGross}
          imagesrcset={preload.avif}
          imagesizes="100vw"
          type="image/avif"
          fetchpriority="high"
        />
      )
    }

    <meta name="author" content={site.legalName} />
    <meta name="publisher" content={site.name} />
    <meta name="format-detection" content="telephone=no" />

    {/* Lokale Signale */}
    <meta name="geo.region" content={site.regionCode} />
    <meta name="geo.placename" content={site.city} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {
      /* Google zeigt im Suchergebnis nur Favicons ab 48x48 - das frühere
         32x32 war zu klein und blieb deshalb leer. Dateinamen bleiben ohne
         Hash, damit die Icon-URLs dauerhaft stabil sind. */
    }
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/favicon/favicon-48x48.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon/favicon-96x96.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicon/icon-192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/favicon/icon-512.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1730" />
    <meta name="color-scheme" content="light" />

    {
      websiteJsonLd && (
        <script is:inline type="application/ld+json" set:html={websiteJsonLd} />
      )
    }
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <StickyCallBar />

    {
      /* Messpunkte für Conversions. Schreibt nur in window.dataLayer - es wird
         KEIN Tracking-Dienst geladen und nichts übertragen. Erst wenn ein
         Dienst (z. B. Google Tag Manager oder GA4) mit Einwilligungs-Banner
         freigegeben und eingebunden ist, liest er diese Ereignisse aus.
         Ereignisse: phone_click, whatsapp_click, email_click,
         offer_request_click; form_submit_success kommt von /danke/. */
    }
    <script is:inline>
      (() => {
        window.dataLayer = window.dataLayer || [];
        document.addEventListener(
          "click",
          (event) => {
            const link = event.target.closest && event.target.closest("a");
            if (!link) return;
            const href = link.getAttribute("href") || "";
            let name = "";
            if (href.startsWith("tel:")) name = "phone_click";
            else if (href.includes("wa.me/")) name = "whatsapp_click";
            else if (href.startsWith("mailto:")) name = "email_click";
            else if (
              link.dataset.track === "angebot" ||
              href === "/kontakt/" ||
              href.startsWith("/kontakt/#")
            )
              name = "offer_request_click";
            if (!name) return;
            window.dataLayer.push({
              event: name,
              link_text: (link.textContent || "").trim().slice(0, 80),
              page_path: location.pathname,
            });
          },
          { capture: true },
        );
      })();
    </script>

    {
      /* Scroll-Reveal: einmalig, entkoppelt vom Scroll-Event, respektiert Reduced Motion. */
    }
    <script is:inline>
      (() => {
        const targets = document.querySelectorAll("[data-reveal]");
        if (!targets.length) return;

        const revealAll = () =>
          targets.forEach((el) => el.classList.add("is-revealed"));

        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        if (reduced || !("IntersectionObserver" in window)) {
          revealAll();
          return;
        }

        // Sicherheitsnetz: Inhalt darf nie dauerhaft unsichtbar bleiben,
        // falls der Observer aus irgendeinem Grund nicht auslöst.
        window.setTimeout(revealAll, 3000);

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
        );

        targets.forEach((el, index) => {
          // Gestaffelter Einsatz innerhalb einer Gruppe, gedeckelt bei 240ms.
          const group = el.closest("[data-reveal-group]");
          if (group) {
            const items = [...group.querySelectorAll("[data-reveal]")];
            el.style.setProperty(
              "--reveal-delay",
              `${Math.min(items.indexOf(el) * 80, 240)}ms`,
            );
          } else if (index === 0) {
            el.style.setProperty("--reveal-delay", "0ms");
          }
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
