---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/haushaltsaufloesung-emden/";
---

<ServiceDetailPage
  current={current}
  crumb="Haushaltsauflösung"
  metaTitle="Haushaltsauflösung & Nachlass in Emden | Fixum Objektservice"
  description="Diskrete Haushaltsauflösung und Nachlassauflösung in Emden und Ostfriesland - im Trauerfall oder beim Umzug ins Heim, auf Wunsch ohne Ihre Anwesenheit."
  eyebrow="Haushaltsauflösung & Nachlass"
  title="Haushaltsauflösung und Nachlassauflösung"
  heroText="Im Trauerfall oder beim Umzug ins Heim braucht es keinen Verkaufstermin, sondern jemanden, der die Sache ruhig und vollständig abwickelt."
  image="/images/categories/haushaltsaufloesung.png"
  imageAlt="Diskrete Haushaltsauflösung in Ostfriesland durch Fixum Objektservice"
  serviceType="Haushaltsauflösung und Nachlassauflösung"
  areaTitle="Haushaltsauflösung in Emden und Ostfriesland"
  lead="Eine Haushaltsauflösung ist selten nur eine Räumung. Meistens hängt eine Frist daran, eine Erbengemeinschaft, ein Übergabetermin - und Angehörige, die weit weg wohnen. Genau darauf ist unser Ablauf ausgelegt."
  included={[
    "Vollständige Auflösung von Wohnung, Haus oder einzelnen Etagen",
    "Aussortieren und Übergabe von Dokumenten, Fotos und persönlichen Unterlagen",
    "Abwicklung nach Schlüsselübergabe - Ihre Anwesenheit ist nicht nötig",
    "Sortenreine Entsorgung mit Nachweis für Nachlassverwaltung oder Erbengemeinschaft",
    "Besenreine Übergabe an Vermieter, Makler oder Käufer",
    "Auf Wunsch Fotodokumentation des gesamten Ablaufs",
  ]}
  process={[
    [
      "Erstes Gespräch",
      "Am Telefon klären wir Umfang, Frist und Besonderheiten. Was behalten werden soll, notieren wir dabei gleich mit.",
    ],
    [
      "Besichtigung und Festpreis",
      "Wir sehen uns das Objekt an und kalkulieren den Preis. Was enthalten ist und was nicht, steht im Angebot - auch für die Erbengemeinschaft nachvollziehbar.",
    ],
    [
      "Auflösung",
      "Wir lösen den Haushalt vollständig auf. Dokumente, Fotos, Schmuck und Erinnerungsstücke werden aussortiert statt entsorgt.",
    ],
    [
      "Übergabe",
      "Gefundene Unterlagen und Wertsachen händigen wir Ihnen aus, das Objekt wird besenrein übergeben - auf Wunsch mit Nachweis für die Nachlassabwicklung.",
    ],
  ]}
  facts={[
    ["Diskretion", "Unbeschriftete Fahrzeuge, keine Gespräche im Haus."],
    [
      "Anwesenheit",
      "Nicht erforderlich - wir arbeiten nach Schlüsselübergabe.",
    ],
    ["Dokumente", "Werden gesammelt und Ihnen übergeben, nie entsorgt."],
    ["Nachweis", "Entsorgungsbelege für die Nachlassabwicklung auf Wunsch."],
  ]}
  noteTitle="Was wir immer aussortieren"
  noteText="Dokumente, Fotoalben, Briefe, Schmuck, Bargeld und alles, was nach Erinnerungsstück aussieht, wird zur Seite gelegt und Ihnen übergeben. Das ist Teil des Auftrags und kostet nicht extra. Im Zweifel fragen wir lieber einmal zu viel nach, als etwas wegzuwerfen, das nicht ersetzbar ist."
  faq={serviceFaq[current]}
/>
