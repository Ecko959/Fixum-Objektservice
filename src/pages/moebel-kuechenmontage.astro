---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/moebel-kuechenmontage/";
---

<ServiceDetailPage
  current={current}
  crumb="Möbel- & Küchenmontage"
  metaTitle="Möbelmontage & Küchenmontage in Emden | Fixum Objektservice"
  description="Möbel- und Küchenmontage in Emden und Ostfriesland: aufgebaut, ausgerichtet und befestigt - ohne Elektro-, Gas- und Wasseranschlüsse. Auch Demontage und Entsorgung alter Möbel."
  eyebrow="Möbel- & Küchenmontage"
  title="Möbel- und Küchenmontage in Emden"
  heroText="Aufgebaut, ausgerichtet, sicher befestigt. Wir übernehmen die Montage - die Anschlüsse bleiben bei den Fachbetrieben, die sie ausführen dürfen."
  image="/images/categories/montage-boden.png"
  imageAlt="Montierte Küchenzeile in einer Wohnung in Ostfriesland"
  serviceType="Möbelmontage und Küchenmontage"
  areaTitle="Möbel- und Küchenmontage in Emden und Ostfriesland"
  lead="Eine Küche steht selten von selbst gerade. Alte Wände, unebene Böden und Leitungen an unerwarteter Stelle machen aus zwei Stunden Aufbau schnell einen Tag - wenn man weiß, was man tut, aus einem Tag wieder zwei Stunden."
  included={[
    "Aufbau und Ausrichtung von Küchenzeilen, Ober- und Unterschränken",
    "Arbeitsplatten zuschneiden, einpassen und abdichten",
    "Fronten, Griffe, Sockelblenden und Auszüge einstellen",
    "Möbelmontage aller gängigen Hersteller nach Aufbauanleitung",
    "Sichere Wandbefestigung inklusive passender Dübeltechnik",
    "Demontage und Entsorgung alter Möbel und Küchen",
    "Koordination des Anschlusstermins mit dem Fachbetrieb",
  ]}
  process={[
    [
      "Anfrage",
      "Sie schicken den Planungsplan oder die Bestellliste. Daraus lässt sich der Aufwand meist ohne Termin einschätzen.",
    ],
    [
      "Vorabklärung und Festpreis",
      "Wir prüfen Maße, Wandbeschaffenheit, Leitungsverläufe und die vorhandene Anschlusssituation. Danach steht der Preis.",
    ],
    [
      "Montage",
      "Korpusse werden aufgebaut, ausgerichtet, verbunden und sicher befestigt, Arbeitsplatte eingepasst, Fronten eingestellt.",
    ],
    [
      "Anschluss und Übergabe",
      "Den Anschlusstermin des Fachbetriebs stimmen wir auf Wunsch direkt mit ab. Altmöbel und Verpackung nehmen wir mit.",
    ],
  ]}
  facts={[
    ["Umfang", "Aufbau, Ausrichtung, Befestigung, Einstellung."],
    ["Grenze", "Keine Elektro-, Gas- und Wasseranschlüsse."],
    ["Altmöbel", "Demontage und Entsorgung im selben Termin."],
    ["Kombination", "Zusammen mit Umzug oder Räumung günstiger."],
  ]}
  noteTitle="Warum wir die Geräte nicht anschließen"
  noteText="Elektro-, Gas- und Wasseranschlüsse dürfen nur zugelassene Fachbetriebe herstellen - das ist keine Formalie, sondern Vorschrift, und im Schadensfall auch eine Versicherungsfrage. Wir bauen die Küche komplett auf und stimmen den Anschlusstermin auf Wunsch direkt mit ab, damit nicht zweimal jemand anrücken muss."
  faq={serviceFaq[current]}
/>
