---
import Base from "../layouts/Base.astro";
import AreaServed from "../components/AreaServed.astro";
import Button from "../components/Button.astro";
import ContactForm from "../components/ContactForm.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import ReferenceGallery from "../components/ReferenceGallery.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/services";
import { site, telUrl, whatsappUrl } from "../data/site";

const title =
  "Entrümpelung, Entkernung & Trockenbau in Emden | Fixum Objektservice";
const description =
  "Entrümpelung, Haushaltsauflösung, Entkernung, Trockenbau und Montage in Emden und Ostfriesland. Ein Ansprechpartner, ein Festpreis nach kostenloser Besichtigung, ein Termin, der hält.";

const heroImage = "/images/hero-renovation.png";

const trust: Array<[string, string, "star" | "euro" | "clock" | "shield"]> = [
  [
    "17+ Jahre Erfahrung",
    "Handwerk und Bau, ein großer Teil davon hier in der Region.",
    "star",
  ],
  [
    "Festpreis nach Besichtigung",
    "Schriftlich. Was drinsteht, gilt - auch wenn der Keller voller ist als gedacht.",
    "euro",
  ],
  [
    "Termin ist Termin",
    "Zugesagte Tage werden gehalten. Kommt etwas dazwischen, hören Sie es von uns zuerst.",
    "clock",
  ],
  [
    "Haftpflichtversichert",
    "Betriebshaftpflicht inklusive Leitungs- und Bearbeitungsschäden.",
    "shield",
  ],
];

const chain: Array<[string, string, "crate" | "hammer" | "wall" | "check"]> = [
  [
    "Räumen",
    "Entrümpelung und Haushaltsauflösung. Getrennt nach Fraktionen entsorgt, besenrein übergeben.",
    "crate",
  ],
  [
    "Rückbauen",
    "Entkernung und nicht-tragender Rückbau. Alte Böden, Wände und Einbauten kommen raus.",
    "hammer",
  ],
  [
    "Ausbauen",
    "Trockenbau, Decken, Dachschrägen, Spachtelung, Boden, Türen und Montage.",
    "wall",
  ],
  [
    "Übergeben",
    "Sauber, termingerecht und vermietbar. Auf Wunsch mit Fotodokumentation und Entsorgungsnachweis.",
    "check",
  ],
];

const reasons: Array<[string, string]> = [
  [
    "Ein Ansprechpartner",
    "Vom ersten Anruf bis zur Übergabe reden Sie mit derselben Person. Keine Weitergabe, keine Rückfragen an drei Gewerke.",
  ],
  [
    "Festpreis nach Besichtigung",
    "Wir schauen uns das Objekt an und nennen danach einen Preis, der schriftlich gilt. Keine Nachberechnung, wenn es länger dauert als gedacht.",
  ],
  [
    "Termin ist Termin",
    "Der zugesagte Tag wird gehalten. Wenn wirklich etwas dazwischenkommt, erfahren Sie es von uns - nicht durch Warten.",
  ],
  [
    "Sortenreine Entsorgung",
    "Wir trennen vor Ort statt alles in einen Mischcontainer zu werfen. Das ist günstiger für Sie und ordentlich dokumentiert.",
  ],
  [
    "Erfahrung statt Lehrjahre",
    "Über 17 Jahre kombinierte Praxis am Bau und im Objektservice. Der Name ist neu, die Leute sind es nicht.",
  ],
  [
    "Klare Grenzen",
    "Strom, Wasser und Heizung führen zugelassene Fachbetriebe aus, die wir koordinieren. Wir sagen Ihnen, was wir nicht machen.",
  ],
];

const serviceChips: Array<[string, string]> = [
  ["Alle Leistungen", "/leistungen/"],
  ["Entrümpelung", "/entruempelung-haushaltsaufloesung/"],
  ["Entkernung", "/entkernung-rueckbau/"],
  ["Trockenbau", "/trockenbau-innenausbau/"],
  ["Boden & Türen", "/montage-boden/"],
  ["Hausmeister", "/hausmeisterservice/"],
];
---

<Base
  title={title}
  description={description}
  canonical="/"
  faqSchema
  preloadImage={heroImage}
>
  {/* ---------------------------------------------------- Hero */}
  <section class="hero section--dark">
    <picture class="hero-media" aria-hidden="true">
      <source srcset="/images/hero-renovation.avif" type="image/avif" />
      <source srcset="/images/hero-renovation.webp" type="image/webp" />
      <img
        src={heroImage}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="pill hero-pill">
          <Icon name="pin" size={15} />
          <span>Emden · Ostfriesland</span>
        </p>
        <p class="script">{site.heroLine}</p>
        <h1>
          Entrümpelt, <span class="blue-word">ausgebaut</span>, übergabefertig.
        </h1>
        <p class="lead">
          Entrümpelung, Haushaltsauflösung, Entkernung, Trockenbau und Montage
          in Emden und Ostfriesland. Ein Ansprechpartner, ein Festpreis, ein
          Termin, der hält.
        </p>

        {
          /* Auf dem Handy steht direkt darunter die Kontaktkarte mit
             denselben beiden Aktionen - deshalb hier nur ab Tablet. */
        }
        <div class="btn-row hero-actions">
          <Button href={telUrl} icon="phone">Jetzt anrufen</Button>
          <Button
            href={whatsappUrl("Moin, ich habe eine Anfrage zu:")}
            variant="secondary"
            icon="whatsapp"
          >
            Foto per WhatsApp schicken
          </Button>
        </div>

        <ul class="hero-proof">
          <li>
            <Icon name="check" size={15} /><span>Besichtigung kostenlos</span>
          </li>
          <li>
            <Icon name="check" size={15} /><span>Festpreis schriftlich</span>
          </li>
          <li>
            <Icon name="check" size={15} /><span>Haftpflichtversichert</span>
          </li>
        </ul>
      </div>

      <div class="hero-form">
        <ContactForm />
      </div>
    </div>

    <nav class="container hero-chips" aria-label="Leistungen im Überblick">
      {
        serviceChips.map(([label, href], index) => (
          <a href={href} class={index === 0 ? "is-primary" : ""}>
            {label}
          </a>
        ))
      }
    </nav>
  </section>

  {/* ---------------------------------------------------- Vertrauensleiste */}
  <section class="trust section--dark" aria-labelledby="trust-title">
    <h2 id="trust-title" class="sr-only">Warum Auftraggeber Fixum wählen</h2>
    <div class="container trust-grid" data-reveal-group>
      {
        trust.map(([headline, text, icon]) => (
          <article class="trust-item" data-reveal>
            <span class="trust-icon">
              <Icon name={icon} size={20} />
            </span>
            <div>
              <h3>{headline}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------- Vorstellung */}
  <section class="section intro-panel" aria-labelledby="intro-title">
    <div class="container intro-grid">
      <div class="intro-copy stack" data-reveal>
        <p class="eyebrow">Über Fixum Objektservice</p>
        <p class="script">Alles aus einer Hand</p>
        <h2 id="intro-title">
          Ihr Objekt, <span class="blue-word">unsere Verantwortung.</span>
        </h2>
        <p class="intro-strong">
          Wir stehen für zuverlässige Arbeit in Emden und Ostfriesland -
          persönlich, sauber und transparent.
        </p>
        <p class="muted">
          Fixum Objektservice unterstützt Privatkunden, Hausverwaltungen und
          Bauunternehmen bei <a href="/entruempelung-haushaltsaufloesung/"
            >Entrümpelung</a
          >, <a href="/entkernung-rueckbau/">Entkernung</a>,
          <a href="/trockenbau-innenausbau/">Trockenbau</a> und
          <a href="/montage-boden/">Montage</a>. Unser Ziel ist nicht nur,
          Arbeit abzunehmen, sondern ein Ergebnis zu liefern, auf das Sie sich
          verlassen können.
        </p>
        <p class="muted">
          Wir arbeiten mit klarer Absprache, einem Blick für Details und
          ehrlichen Grenzen. Was Fachbetriebe ausführen müssen, wird sauber
          koordiniert - Sie müssen niemanden selbst suchen.
        </p>

        <div class="signature">
          <span class="signature-mark"><Icon name="pen" size={22} /></span>
          <p>
            <strong>Eckhard Singer</strong>
            <small>Inhaber · Fixum Objektservice</small>
          </p>
        </div>

        <p>
          <a class="arrow-link" href="/ueber-uns/">Mehr über den Betrieb</a>
        </p>
      </div>

      <div
        class="intro-collage"
        data-reveal
        aria-label="Eindrücke aus Objektservice und Ausbau"
      >
        <Photo
          src="/images/service-clearance.png"
          alt="Sortierte Räumung einer Wohnung durch Fixum Objektservice in Emden"
          width={900}
          height={650}
          sizes="(max-width: 980px) 100vw, 44vw"
          class="collage-main"
        />
        <Photo
          src="/images/service-drywall.png"
          alt="Trockenbauarbeiten an einer Ständerwand in Ostfriesland"
          width={620}
          height={460}
          sizes="(max-width: 980px) 100vw, 20vw"
          class="collage-small top"
        />
        <Photo
          src="/images/team-van.png"
          alt="Fahrzeug und Team von Fixum Objektservice bei der Objektvorbereitung"
          width={620}
          height={460}
          sizes="(max-width: 980px) 100vw, 22vw"
          class="collage-small bottom"
        />
        <div class="collage-logo">
          <img
            src="/logo/fixum-lockup-white-trim.png"
            alt=""
            width="720"
            height="168"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------- Leistungen */}
  <section id="leistungen" class="section services-stage section--dark">
    <div class="container section-head section-head--center" data-reveal>
      <p class="script">Zwei Bereiche, eine Rechnung</p>
      <p class="eyebrow">Leistungen</p>
      <h2>Das machen <span class="blue-word">wir</span></h2>
      <p class="muted">
        Die meisten Betriebe können entweder räumen oder ausbauen. Wir machen
        beides - und genau dazwischen liegt die Arbeit, die sonst liegen bleibt.
      </p>
    </div>

    <div class="container grid-3 service-top" data-reveal-group>
      {
        services.slice(0, 3).map((service) => (
          <div data-reveal>
            <ServiceCard {...service} large />
          </div>
        ))
      }
    </div>

    <div class="container grid-3 service-small" data-reveal-group>
      {
        services.slice(3).map((service) => (
          <div data-reveal>
            <ServiceCard {...service} bullets={undefined} />
          </div>
        ))
      }
    </div>

    <p class="container services-more">
      <a class="arrow-link" href="/leistungen/">Alle Leistungen im Detail</a>
    </p>
  </section>

  {/* ---------------------------------------------------- Ablaufkette */}
  <section class="section section--chain" aria-labelledby="chain-title">
    <div class="container section-head section-head--center" data-reveal>
      <p class="script">So läuft ein Objekt bei uns durch</p>
      <p class="eyebrow">Unser Weg</p>
      <h2 id="chain-title">Vom vollen Haus zur fertigen Wohnung</h2>
      <p class="muted">
        Andere machen einen Schritt. Wir machen alle vier - Sie koordinieren
        niemanden und bekommen eine Rechnung.
      </p>
    </div>

    <ol class="container chain-grid" data-reveal-group>
      {
        chain.map(([headline, text, icon], index) => (
          <li class="chain-item" data-reveal>
            <span class="chain-no">{String(index + 1).padStart(2, "0")}</span>
            <span class="chain-icon">
              <Icon name={icon} size={20} />
            </span>
            <h3>{headline}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>

    <p class="container chain-note">
      Sie brauchen nur einen Teil davon? Auch gut - jeder Schritt ist einzeln
      buchbar.
    </p>
  </section>

  {/* ---------------------------------------------------- Gründe */}
  <section class="section section--mist" aria-labelledby="reasons-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Warum Fixum</p>
      <h2 id="reasons-title">Sechs Gründe, die im Angebot stehen</h2>
      <p class="muted">
        Keine Versprechen, die sich nicht prüfen lassen - jeder Punkt taucht in
        Ihrem Angebot oder auf der Rechnung wieder auf.
      </p>
    </div>

    <div class="container grid-3 reason-grid" data-reveal-group>
      {
        reasons.map(([headline, text], index) => (
          <article class="card reason-card" data-reveal>
            <span class="reason-no">{String(index + 1).padStart(2, "0")}</span>
            <h3>{headline}</h3>
            <p>{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------- Zielgruppen */}
  <section class="section" aria-labelledby="audience-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Auftraggeber</p>
      <h2 id="audience-title">Privat, Verwaltung, Baustelle</h2>
      <p class="muted">
        Drei Ausgangslagen, dieselbe Arbeitsweise: klarer Umfang, fester Preis,
        gehaltene Termine.
      </p>
    </div>

    <div class="container grid-3 audience" data-reveal-group>
      <article class="card audience-card" data-reveal>
        <span class="audience-icon"><Icon name="home" size={22} /></span>
        <h3>Privatkunden</h3>
        <p class="audience-sub">Wenn eine Wohnung leer werden muss</p>
        <p>
          Im Trauerfall, beim Umzug ins Heim oder bei der Übergabe an den
          Vermieter. Wir nehmen Ihnen die Abwicklung ab, von der Besichtigung
          bis zur Schlüsselübergabe - diskret und ohne Zeitdruck.
        </p>
        <ul class="check-list audience-list">
          <li>Festpreis nach kostenloser Besichtigung</li>
          <li>Besenreine Übergabe, auf Wunsch mit Fotodokumentation</li>
        </ul>
        <Button href="/kontakt/">Besichtigung anfragen</Button>
      </article>

      <article class="card audience-card" data-reveal>
        <span class="audience-icon"><Icon name="clipboard" size={22} /></span>
        <h3>Hausverwaltungen</h3>
        <p class="audience-sub">Mieterwechsel in einem Durchgang</p>
        <p>
          Räumen, rückbauen, renovieren, übergeben - ein Ansprechpartner, eine
          Rechnung, weniger Leerstandstage pro Einheit. Auf Wunsch mit
          Fotodokumentation zur Abnahme.
        </p>
        <ul class="check-list audience-list">
          <li>Rahmenvereinbarung mit festen Konditionen möglich</li>
          <li>Feste Reaktionszeit bei Schlüsselübergabe</li>
          <li>Abrechnung pro Objekt oder gesammelt</li>
        </ul>
        <Button href="/fuer-hausverwaltungen/">Konditionen anfordern</Button>
      </article>

      <article class="card audience-card" data-reveal>
        <span class="audience-icon"><Icon name="wall" size={22} /></span>
        <h3>Bauunternehmen</h3>
        <p class="audience-sub">Trockenbau als Nachunternehmer</p>
        <p>
          Zuverlässiger Sub für Ausbaugewerke in Ostfriesland. Wir kommen, wenn
          wir zugesagt haben - das ist im Trockenbau seltener als es sein
          sollte.
        </p>
        <ul class="check-list audience-list">
          <li>Abrechnung nach m² oder Tagessatz</li>
          <li>Betriebshaftpflicht mit Subunternehmer-Klausel</li>
          <li>Freistellungsbescheinigung nach § 48b EStG auf Anfrage</li>
        </ul>
        <Button href="/fuer-bauunternehmen/">Als Sub anfragen</Button>
      </article>
    </div>
  </section>

  {/* ---------------------------------------------------- Referenz */}
  {
    site.showReferences && (
      <section
        class="section section--soft references"
        aria-labelledby="referenzen-title"
      >
        <div class="container section-head" data-reveal>
          <p class="eyebrow">Referenzen</p>
          <h2 id="referenzen-title">Objekte, die wir übergeben haben</h2>
          <p class="muted">
            Echte Baustellen aus Emden und Umgebung - eigene Fotos, keine
            Katalogbilder. Jede Referenz zeigt den Zustand bei Auftragsbeginn
            und das Ergebnis bei der Übergabe.
          </p>
        </div>

        <div class="container">
          <ReferenceGallery />
        </div>

        <p class="container references-note">
          Ihr Objekt sieht anders aus? Bei der Besichtigung sagen wir Ihnen
          ehrlich, was möglich ist - <a href="/kontakt/">Termin anfragen</a>.
        </p>
      </section>
    )
  }

  {/* ---------------------------------------------------- FAQ */}
  <section class="section section--mist" aria-labelledby="faq-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Die häufigsten Fragen</h2>
      <p class="muted">
        Wenn Ihre Frage nicht dabei ist: einmal anrufen reicht.
      </p>
    </div>
    <div class="container container--narrow" data-reveal>
      <FaqAccordion />
    </div>
  </section>

  <AreaServed
    service="Objektservice"
    title="Von Emden aus in ganz Ostfriesland"
  />

  <CtaBand />
</Base>

<style>
  /* ---------------------------------------------------- Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem)) 0
      clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        70% 60% at 15% 40%,
        rgba(7, 19, 38, 0.94),
        transparent 75%
      ),
      linear-gradient(
        100deg,
        rgba(7, 19, 38, 0.93) 0%,
        rgba(10, 23, 48, 0.78) 48%,
        rgba(10, 23, 48, 0.9) 100%
      ),
      linear-gradient(180deg, rgba(7, 19, 38, 0.75), transparent 28%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 430px;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 42rem;
  }

  .hero-pill {
    letter-spacing: 0.1em;
  }

  .hero h1 {
    margin-block: 0.25rem;
  }

  .hero .lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
  }

  .hero .btn-row {
    margin-top: 0.5rem;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.375rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-utility);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }

  .hero-proof :global(.icon) {
    color: var(--amber);
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hero-chips a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(14px);
    font-family: var(--font-utility);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #fff;
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .hero-chips a:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.18);
  }

  .hero-chips a.is-primary {
    color: var(--navy-deep);
    background: #fff;
    border-color: #fff;
  }

  /* ---------------------------------------------------- Vertrauensleiste */
  .trust {
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    border-top: 1px solid var(--on-dark-hairline);
    background: var(--navy-ink);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .trust-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.875rem;
    align-items: start;
  }

  .trust-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    color: var(--amber);
    background: rgba(255, 176, 32, 0.12);
    border: 1px solid rgba(255, 176, 32, 0.24);
  }

  .trust-item h3 {
    margin-bottom: 0.2rem;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .trust-item p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--on-dark-soft);
  }

  /* ---------------------------------------------------- Vorstellung */
  .intro-panel {
    overflow: hidden;
    background:
      radial-gradient(
        60% 50% at 85% 30%,
        rgba(79, 160, 245, 0.16),
        transparent 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--mist-soft) 100%);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .intro-copy a:not(.arrow-link) {
    color: var(--blue);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(22, 104, 196, 0.35);
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  .intro-copy a:not(.arrow-link):hover {
    text-decoration-color: currentColor;
  }

  .intro-strong {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.45;
