---
import { getImage } from "astro:assets";
import AblaufScroll from "../components/AblaufScroll.tsx";
import Base from "../layouts/Base.astro";
import AreaServed from "../components/AreaServed.astro";
import Button from "../components/Button.astro";
import ContactForm from "../components/ContactForm.astro";
import HeroBild from "../components/HeroBild.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Icon from "../components/Icon.astro";
import KetteBand from "../components/KetteBand.astro";
import Kundenstimmen from "../components/Kundenstimmen.astro";
import Photo from "../components/Photo.astro";
import ReferenzMarquee from "../components/ReferenzMarquee.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { bildQualitaet, findeBild } from "../data/bilder";
import { fotos, type Foto } from "../data/referenzen";
import { services } from "../data/services";
import type { IconName } from "../data/icons";
import { site, telUrl, whatsappUrl } from "../data/site";
import { whatsappThema } from "../data/whatsapp";

const waThema = whatsappThema(Astro.url.pathname);

/* Markenname vorn, Leistung dahinter - dasselbe Muster auf allen Seiten.
   Zwei Gründe: Im Suchergebnis steht damit sofort, von wem die Seite ist,
   und Google zieht den Quellennamen über dem Treffer unter anderem aus dem
   Titel der Startseite. Beides zahlt auf denselben Punkt ein. */
const title = "Fixum Objektservice: Entrümpelung & Trockenbau Emden";
const description =
  "Entrümpelung, Entkernung, Trockenbau und Montage in Emden und Ostfriesland. Ein Ansprechpartner, ein Festpreis nach kostenloser Besichtigung.";

const heroFoto = fotos.dachzimmer;
const heroImage = heroFoto.pfad;
const heroBild = findeBild(heroImage);

const trust: Array<[string, string, "star" | "euro" | "clock" | "shield"]> = [
  [
    "17+ Jahre Erfahrung",
    "Handwerk und Bau, ein großer Teil davon hier in der Region.",
    "star",
  ],
  [
    "Festpreis nach Besichtigung",
    "Schriftlich. Was drinsteht, gilt - auch wenn der Keller voller ist als gedacht.",
    "euro",
  ],
  [
    "Termin ist Termin",
    "Zugesagte Tage werden gehalten. Kommt etwas dazwischen, hören Sie es von uns zuerst.",
    "clock",
  ],
  [
    "Haftpflichtversichert",
    "Betriebshaftpflicht inklusive Leitungs- und Bearbeitungsschäden.",
    "shield",
  ],
];

/* Die vier Schritte der Ablauf-Sektion - mit echten Projektfotos aus
   src/data/referenzen.ts. Wo das Original eine Vorher-Nachher-Collage ist,
   steht hier der passende Zuschnitt. */
const ablaufRoh: Array<{ titel: string; text: string; foto: Foto }> = [
  {
    titel: "Räumen",
    text: "Entrümpelung und Haushaltsauflösung. Getrennt nach Fraktionen entsorgt, besenrein übergeben.",
    foto: fotos.wohnungsaufloesungVorher,
  },
  {
    titel: "Rückbauen",
    text: "Entkernung und nicht-tragender Rückbau. Alte Böden, Wände und Einbauten kommen raus.",
    foto: fotos.dachbodenNachher,
  },
  {
    titel: "Ausbauen",
    text: "Trockenbau, Decken, Dachschrägen, Spachtelung, Boden, Türen und Montage.",
    foto: fotos.dachausbauTrockenbau,
  },
  {
    titel: "Übergeben",
    text: "Sauber, termingerecht und vermietbar. Auf Wunsch mit Fotodokumentation und Entsorgungsnachweis.",
    foto: fotos.dachzimmer,
  },
];

/* WebP über astro:assets. Die React-Komponente kann <Picture> nicht nutzen,
   deshalb wird die URL hier erzeugt und als Zeichenkette übergeben.

   Quadratisch zugeschnitten, weil die Sektion die Bilder quadratisch zeigt.
   Der Zuschnitt beim Bauen ist zweimal besser als object-cover allein: Es
   wandert nur ein Achtel der Bytes über die Leitung, und beschnitten wird
   mit sharp statt vom Browser. 680 px reichen für feine Bildschirme und
   liegen unter der Breite der Zuschnitte (695 px) - es wird nichts
   hochgerechnet. */
const ablaufSchritte = await Promise.all(
  ablaufRoh.map(async (s) => {
    const web = await getImage({
      src: findeBild(s.foto.pfad)!,
      width: 680,
      height: 680,
      fit: "cover",
      format: "webp",
      quality: bildQualitaet,
    });
    return {
      titel: s.titel,
      text: s.text,
      bild: web.src,
      alt: s.foto.alt,
    };
  }),
);

const reasons: Array<[string, string]> = [
  [
    "Ein Ansprechpartner",
    "Vom ersten Anruf bis zur Übergabe reden Sie mit derselben Person. Keine Weitergabe, keine Rückfragen an drei Gewerke.",
  ],
  [
    "Festpreis nach Besichtigung",
    "Wir schauen uns das Objekt an und nennen danach einen Preis, der schriftlich gilt. Keine Nachberechnung, wenn es länger dauert als gedacht.",
  ],
  [
    "Termin ist Termin",
    "Der zugesagte Tag wird gehalten. Wenn wirklich etwas dazwischenkommt, erfahren Sie es von uns - nicht durch Warten.",
  ],
  [
    "Sortenreine Entsorgung",
    "Wir trennen vor Ort statt alles in einen Mischcontainer zu werfen. Das ist günstiger für Sie und ordentlich dokumentiert.",
  ],
  [
    "Erfahrung statt Lehrjahre",
    "Über 17 Jahre kombinierte Praxis am Bau und im Objektservice. Der Name ist neu, die Leute sind es nicht.",
  ],
  [
    "Klare Grenzen",
    "Strom, Wasser und Heizung führen zugelassene Fachbetriebe aus, die wir koordinieren. Wir sagen Ihnen, was wir nicht machen.",
  ],
];

/* Unter dem Hero: die drei Bereiche als eigene Kacheln, darunter zwei
   schlichte Links. Eine Farbfamilie (Weiß auf Navy, Blau als Akzent). */
const bereiche: Array<{ label: string; href: string; icon: IconName }> = [
  { label: "Entrümpelung", href: "/entruempelung/", icon: "karton" },
  { label: "Entkernung", href: "/entkernung/", icon: "vorschlaghammer" },
  { label: "Trockenbau", href: "/trockenbau/", icon: "platten" },
];
---

<Base
  title={title}
  description={description}
  canonical="/"
  faqSchema
  preloadImage={heroImage}
>
  {/* ---------------------------------------------------- Hero */}
  <section class="hero section--dark">
    {
      heroBild && (
        <HeroBild bild={heroBild} alt={heroFoto.alt} class="hero-media" />
      )
    }
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="pill hero-pill">
          <Icon name="pin" size={15} />
          <span>Emden · Ostfriesland</span>
        </p>
        <p class="script">{site.heroLine}</p>
        {
          /* Die H1 trägt jetzt Leistung und Ort - das ist die Zeile, die
             Google einer lokalen Suche zuordnet. Der Claim steht als
             Unterzeile darunter und bleibt damit sichtbar. */
        }
        <h1>
          <span class="blue-word">Entrümpelung</span>, Entkernung & Trockenbau
          in Emden
        </h1>
        <p class="hero-claim">Entrümpelt, ausgebaut, übergabefertig.</p>
        <p class="lead">
          Entrümpelung, Haushaltsauflösung, Entkernung, Trockenbau und Montage
          in Emden und Ostfriesland. Ein Ansprechpartner, ein Festpreis, ein
          Termin, der hält.
        </p>

        {
          /* Auf dem Handy steht direkt darunter die Kontaktkarte mit
             denselben beiden Aktionen - deshalb hier nur ab Tablet. */
        }
        <div class="btn-row hero-actions">
          <Button href={telUrl} icon="phone">Jetzt anrufen</Button>
          <Button
            href={whatsappUrl(waThema)}
            variant="secondary"
            icon="whatsapp"
          >
            Foto per WhatsApp schicken
          </Button>
        </div>

        <ul class="hero-proof">
          <li>
            <Icon name="check" size={15} /><span>Besichtigung kostenlos</span>
          </li>
          <li>
            <Icon name="check" size={15} /><span>Festpreis schriftlich</span>
          </li>
          <li>
            <Icon name="check" size={15} /><span>Haftpflichtversichert</span>
          </li>
        </ul>
      </div>

      <div class="hero-form" id="anfrage">
        <ContactForm dunkel />
      </div>
    </div>

    <nav class="hero-bereiche" aria-label="Leistungen im Überblick">
      <div class="container">
        <p class="bereiche-titel">Unsere drei Bereiche</p>
        <ul class="bereiche-liste">
          {
            bereiche.map((b) => (
              <li>
                <a href={b.href} class="bereich">
                  <Icon name={b.icon} size={26} />
                  <span>{b.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="bereiche-links">
          <a href="/leistungen/">Alle Leistungen</a>
          <span aria-hidden="true">·</span>
          <a href="/preisrechner/">Preis berechnen</a>
        </p>
      </div>
    </nav>
  </section>

  {/* ---------------------------------------------------- Vertrauensleiste */}
  <section class="trust section--dark" aria-labelledby="trust-title">
    <h2 id="trust-title" class="sr-only">Warum Auftraggeber Fixum wählen</h2>
    <div class="container trust-grid" data-reveal-group>
      {
        trust.map(([headline, text, icon]) => (
          <article class="trust-item" data-reveal>
            <span class="trust-icon">
              <Icon name={icon} size={20} />
            </span>
            <div>
              <h3>{headline}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------- Vorstellung */}
  <section class="section intro-panel" aria-labelledby="intro-title">
    <div class="container intro-grid">
      <div class="intro-copy stack" data-reveal>
        <p class="eyebrow">Über Fixum Objektservice</p>
        <p class="script">Alles aus einer Hand</p>
        <h2 id="intro-title">
          Ihr Objekt, <span class="blue-word">unsere Verantwortung.</span>
        </h2>
        <p class="intro-strong">
          Wir stehen für zuverlässige Arbeit in Emden und Ostfriesland -
          persönlich, sauber und transparent.
        </p>
        <p class="muted">
          Fixum Objektservice unterstützt Privatkunden, Hausverwaltungen und
          Bauunternehmen bei <a href="/entruempelung/">Entrümpelung</a>, <a
            href="/entkernung/">Entkernung</a
          >,
          <a href="/trockenbau/">Trockenbau</a> und
          <a href="/bodenverlegung/">Montage</a>. Unser Ziel ist nicht nur,
          Arbeit abzunehmen, sondern ein Ergebnis zu liefern, auf das Sie sich
          verlassen können.
        </p>
        <p class="muted">
          Wir arbeiten mit klarer Absprache, einem Blick für Details und
          ehrlichen Grenzen. Was Fachbetriebe ausführen müssen, wird sauber
          koordiniert - Sie müssen niemanden selbst suchen.
        </p>

        <div class="signature">
          <span class="signature-mark"><Icon name="pen" size={22} /></span>
          <p>
            <strong>Eckhard Singer</strong>
            <small>Inhaber · Fixum Objektservice</small>
          </p>
        </div>

        <p>
          <a class="arrow-link" href="/ueber-uns/">Mehr über den Betrieb</a>
        </p>
      </div>

      <div
        class="intro-collage"
        data-reveal
        aria-label="Fotos aus unseren Aufträgen: Räumung, Trockenbau und Umzug"
      >
        <Photo
          src={fotos.wohnungsaufloesung.pfad}
          alt={fotos.wohnungsaufloesung.alt}
          width={900}
          height={650}
          sizes="(max-width: 980px) 100vw, 44vw"
          class="collage-main"
        />
        <Photo
          src={fotos.altbauTrockenbau.pfad}
          alt={fotos.altbauTrockenbau.alt}
          width={620}
          height={460}
          sizes="(max-width: 980px) 100vw, 20vw"
          class="collage-small top"
        />
        <Photo
          src={fotos.umzug.pfad}
          alt={fotos.umzug.alt}
          width={620}
          height={460}
          sizes="(max-width: 980px) 100vw, 22vw"
          class="collage-small bottom"
        />
        <div class="collage-logo">
          <img
            src="/logo/fixum-lockup-white-trim.png"
            alt=""
            width="720"
            height="168"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------- Referenzen */}
  {site.showReferences && <ReferenzMarquee />}

  {/* ---------------------------------------------------- Leistungen */}
  <section id="leistungen" class="section services-stage section--dark">
    <div class="container section-head" data-reveal>
      <p class="script">Drei Bereiche, eine Rechnung</p>
      <p class="eyebrow">Leistungen</p>
      <h2>Das machen <span class="blue-word">wir</span></h2>
      <p class="muted">
        Die meisten Betriebe können entweder räumen oder ausbauen. Wir machen
        beides - und genau dazwischen liegt die Arbeit, die sonst liegen bleibt.
      </p>
    </div>

    <div class="container grid-3 service-top" data-reveal-group>
      {
        services.slice(0, 3).map((service) => (
          <div data-reveal>
            <ServiceCard {...service} large />
          </div>
        ))
      }
    </div>

    {
      /* Nur die drei Hauptbereiche. Umzug, Montage, Boden, Hausmeister und
         die übrigen Leistungen stehen auf /leistungen/ und im Menü. */
    }
    <div class="container services-more" data-reveal>
      <Button href="/leistungen/" variant="secondary" icon="arrow">
        Alle Leistungen ansehen
      </Button>
    </div>
  </section>

  {/* ---------------------------------------------------- Ablaufkette */}
  {
    /* Heller Grund statt des früheren dunklen Verlaufs: Die Sektion zeigt
       jetzt Fotos, und die stehen auf hellem Untergrund besser. Nebenbei
       entfällt der Zwang zu weißer Schrift - .section--chain setzte alle
       Überschriften per :is(h1,h2,h3,h4) auf Weiß und hätte die Farben der
       Komponente überschrieben. */
  }
  <section class="section section--mist" aria-labelledby="chain-title">
    <div class="container section-head" data-reveal>
      <p class="script">So läuft ein Objekt bei uns durch</p>
      <p class="eyebrow">Unser Weg</p>
      <h2 id="chain-title">Vom vollen Haus zur fertigen Wohnung</h2>
      <p class="muted">
        Andere machen einen Schritt. Wir machen alle vier - Sie koordinieren
        niemanden und bekommen eine Rechnung.
      </p>
    </div>

    {
      /* client:visible statt client:load: Die Sektion steht weit unten, das
         React-Bündel wird erst geladen, wenn sie in Sichtweite kommt - der
         erste Bildaufbau bleibt davon unberührt. Ohne JavaScript stehen die
         vier Schritte trotzdem vollständig da, nur ohne Animation. */
    }
    <div class="container">
      <AblaufScroll
        client:visible
        steps={ablaufSchritte}
        telHref={telUrl}
        whatsappHref={whatsappUrl(waThema)}
      />
    </div>

    <p class="container chain-note">
      Sie brauchen nur einen Teil davon? Auch gut - jeder Schritt ist einzeln
      buchbar.
    </p>
  </section>

  <KetteBand />

  {/* ---------------------------------------------------- Gründe */}
  <section class="section section--mist" aria-labelledby="reasons-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Warum Fixum</p>
      <h2 id="reasons-title">Sechs Gründe, die im Angebot stehen</h2>
      <p class="muted">
        Keine Versprechen, die sich nicht prüfen lassen - jeder Punkt taucht in
        Ihrem Angebot oder auf der Rechnung wieder auf.
      </p>
    </div>

    <div class="container grid-3 reason-grid" data-reveal-group>
      {
        reasons.map(([headline, text], index) => (
          <article class="card reason-card" data-reveal>
            <span class="reason-no">{String(index + 1).padStart(2, "0")}</span>
            <h3>{headline}</h3>
            <p>{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------- Zielgruppen */}
  <section class="section" aria-labelledby="audience-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Auftraggeber</p>
      <h2 id="audience-title">Privat, Verwaltung, Baustelle</h2>
      <p class="muted">
        Drei Ausgangslagen, dieselbe Arbeitsweise: klarer Umfang, fester Preis,
        gehaltene Termine.
      </p>
    </div>

    <div class="container grid-3 audience" data-reveal-group>
      <article class="card audience-card" data-reveal>
        <span class="audience-icon"><Icon name="home" size={22} /></span>
        <h3>Privatkunden</h3>
        <p class="audience-sub">Wenn eine Wohnung leer werden muss</p>
        <p>
          Im Trauerfall, beim Umzug ins Heim oder bei der Übergabe an den
          Vermieter. Wir nehmen Ihnen die Abwicklung ab, von der Besichtigung
          bis zur Schlüsselübergabe - diskret und ohne Zeitdruck.
        </p>
        <ul class="check-list audience-list">
          <li>Festpreis nach kostenloser Besichtigung</li>
          <li>Besenreine Übergabe, auf Wunsch mit Fotodokumentation</li>
        </ul>
        <Button href="/kontakt/">Besichtigung anfragen</Button>
      </article>

      <article class="card audience-card" data-reveal>
        <span class="audience-icon"><Icon name="clipboard" size={22} /></span>
        <h3>Hausverwaltungen</h3>
        <p class="audience-sub">Mieterwechsel in einem Durchgang</p>
        <p>
          Räumen, rückbauen, renovieren, übergeben - ein Ansprechpartner, eine
          Rechnung, weniger Leerstandstage pro Einheit. Auf Wunsch mit
          Fotodokumentation zur Abnahme.
        </p>
        <ul class="check-list audience-list">
          <li>Rahmenvereinbarung mit festen Konditionen möglich</li>
          <li>Feste Reaktionszeit bei Schlüsselübergabe</li>
          <li>Abrechnung pro Objekt oder gesammelt</li>
        </ul>
        <Button href="/fuer-hausverwaltungen/">Konditionen anfordern</Button>
      </article>

      <article class="card audience-card" data-reveal>
        <span class="audience-icon"><Icon name="platten" size={22} /></span>
        <h3>Bauunternehmen</h3>
        <p class="audience-sub">Trockenbau als Nachunternehmer</p>
        <p>
          Zuverlässiger Sub für Ausbaugewerke in Ostfriesland. Wir kommen, wenn
          wir zugesagt haben - das ist im Trockenbau seltener als es sein
          sollte.
        </p>
        <ul class="check-list audience-list">
          <li>Abrechnung nach m² oder Tagessatz</li>
          <li>Betriebshaftpflicht mit Subunternehmer-Klausel</li>
          <li>
            Freistellungsbescheinigung nach § 48b EStG {
              site.freistellung48b ? "auf Anfrage" : "beantragt"
            }
          </li>
        </ul>
        <Button href="/fuer-bauunternehmen/">Als Sub anfragen</Button>
      </article>
    </div>
  </section>

  {/* ---------------------------------------------------- Kundenstimmen */}
  {
    /* Erscheint erst, wenn in src/data/reviews.json echte Bewertungen stehen. */
  }
  <Kundenstimmen />

  {/* ---------------------------------------------------- FAQ */}
  <section class="section section--mist" aria-labelledby="faq-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Fragen und Antworten</h2>
      <p class="muted">
        Wenn Ihre Frage nicht dabei ist: einmal anrufen reicht.
      </p>
    </div>
    <div class="container container--narrow" data-reveal>
      <FaqAccordion />
    </div>
  </section>

  <AreaServed
    service="Objektservice"
    title="Von Emden aus in ganz Ostfriesland"
  />

  <CtaBand />
</Base>

<style>
  /* ---------------------------------------------------- Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem)) 0
      clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        70% 60% at 15% 40%,
        rgba(7, 19, 38, 0.94),
        transparent 75%
      ),
      linear-gradient(
        100deg,
        rgba(7, 19, 38, 0.93) 0%,
        rgba(10, 23, 48, 0.78) 48%,
        rgba(10, 23, 48, 0.9) 100%
      ),
      linear-gradient(180deg, rgba(7, 19, 38, 0.75), transparent 28%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 430px;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 42rem;
  }

  .hero-pill {
    letter-spacing: 0.1em;
  }

  .hero h1 {
    margin-block: 0.25rem;
  }

  .hero .lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
  }

  .hero .btn-row {
    margin-top: 0.5rem;
  }

  /* Unterzeile unter der H1 - trägt den bisherigen Claim weiter. */
  .hero-claim {
    margin-top: 0.5rem;
    font-family: var(--font-utility);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--on-dark-soft);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.375rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }

  .hero-proof :global(.icon) {
    color: var(--amber);
  }

  /* ---- Drei Bereiche unter dem Hero ---- */
  .hero-bereiche {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
  }

  /* Dachzeile mit Linien links und rechts */
  .bereiche-titel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 600;
