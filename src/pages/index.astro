---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import ContactForm from "../components/ContactForm.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Photo from "../components/Photo.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/services";
import { site, telUrl, whatsappUrl } from "../data/site";

const title =
  "Fixum Objektservice - Entrümpelung, Entkernung und Trockenbau in Emden";
const description =
  "Entrümpelung, Haushaltsauflösung, Entkernung, Trockenbau und Montage in Emden und Ostfriesland. Ein Ansprechpartner, ein Festpreis, ein Termin.";
const trust = [
  [
    "17+ Jahre Erfahrung im Team",
    "Handwerk und Bau, ein großer Teil davon hier in der Region.",
  ],
  [
    "Festpreis nach Besichtigung",
    "Schriftlich. Was drinsteht, gilt - auch wenn der Keller voller ist als gedacht.",
  ],
  [
    "Termin ist Termin",
    "Zugesagte Tage werden gehalten. Wenn etwas dazwischenkommt, hören Sie es von uns zuerst.",
  ],
  [
    "Haftpflichtversichert",
    "Betriebshaftpflicht inklusive Leitungs- und Bearbeitungsschäden.",
  ],
];
const chain = [
  [
    "Räumen",
    "Entrümpelung und Haushaltsauflösung. Getrennt nach Fraktionen entsorgt, besenrein übergeben.",
  ],
  [
    "Rückbauen",
    "Entkernung und nicht-tragender Rückbau. Alte Böden, Wände und Einbauten kommen raus.",
  ],
  [
    "Ausbauen",
    "Trockenbau, Decken, Dachschrägen, Spachtelung, Boden, Türen und Montage.",
  ],
  [
    "Übergeben",
    "Sauber, termingerecht und vermietbar. Auf Wunsch mit Fotodokumentation und Entsorgungsnachweis.",
  ],
];
const reasons = [
  [
    "Ein Ansprechpartner",
    "Vom ersten Anruf bis zur Übergabe reden Sie mit derselben Person. Keine Weitergabe, keine Rückfragen an drei Gewerke.",
  ],
  [
    "Festpreis nach Besichtigung",
    "Wir schauen uns das Objekt an und nennen danach einen Preis, der schriftlich gilt. Keine Nachberechnung, wenn es länger dauert als gedacht.",
  ],
  [
    "Termin ist Termin",
    "Der zugesagte Tag wird gehalten. Wenn wirklich etwas dazwischenkommt, erfahren Sie es von uns - nicht durch Warten.",
  ],
  [
    "Sortenreine Entsorgung",
    "Wir trennen vor Ort statt alles in einen Mischcontainer zu werfen. Das ist günstiger für Sie und ordentlich dokumentiert.",
  ],
  [
    "Erfahrung statt Lehrjahre",
    "Über 17 Jahre kombinierte Praxis am Bau und im Objektservice. Der Name ist neu, die Leute sind es nicht.",
  ],
  [
    "Klare Grenzen",
    "Strom, Wasser und Heizung führen zugelassene Fachbetriebe aus, die wir koordinieren. Wir sagen Ihnen, was wir nicht machen.",
  ],
];
const serviceChips = [
  ["Übersicht", "/leistungen"],
  ["Entrümpelung", "/entruempelung-haushaltsaufloesung"],
  ["Entkernung", "/entkernung-rueckbau"],
  ["Trockenbau", "/trockenbau-innenausbau"],
  ["Montage", "/montage-boden"],
  ["Hausmeister", "/hausmeisterservice"],
];
---

<Base title={title} description={description} faqSchema>
  <section class="hero section--dark">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-pill">Emden · Ostfriesland</p>
        <p class="script">{site.claim}</p>
        <h1>Entrümpelt, <span>ausgebaut</span>, übergabefertig.</h1>
        <p class="lead">
          Entrümpelung, Haushaltsauflösung, Entkernung, Trockenbau und Montage
          in Emden und Ostfriesland. Ein Ansprechpartner, ein Festpreis, ein
          Termin, der hält.
        </p>
        <div class="hero-actions">
          <Button href={telUrl}>☎ Jetzt anrufen - {site.phoneDisplay}</Button>
          <Button
            href={whatsappUrl("Moin, ich habe eine Anfrage zu:")}
            variant="secondary">Foto per WhatsApp schicken</Button
          >
        </div>
      </div>
      <ContactForm />
    </div>
    <div class="container hero-chips" aria-label="Leistungen im Überblick">
      {
        serviceChips.map(([label, href]) => (
          <a href={href}>
            <span>•</span>
            {label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="trust section--dark">
    <div class="container trust-grid">
      {
        trust.map(([headline, text]) => (
          <article>
            <>
              <span>◆</span>
              <h2>{headline}</h2>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section intro-panel">
    <div class="container intro-grid">
      <div class="intro-copy">
        <p class="eyebrow">Über Fixum Objektservice</p>
        <p class="script">Alles aus einer Hand</p>
        <h2>
          Ihr Objekt, <span class="blue-word">unsere Verantwortung.</span>
        </h2>
        <p class="intro-strong">
          Wir stehen für zuverlässige Arbeit in Emden und Ostfriesland -
          persönlich, sauber und transparent.
        </p>
        <p class="muted">
          Fixum Objektservice unterstützt Privatkunden, Hausverwaltungen und
          Bauunternehmen bei Entrümpelung, Entkernung, Trockenbau und Montage.
          Unser Ziel ist nicht nur, Arbeit abzunehmen, sondern ein Ergebnis zu
          liefern, auf das Sie sich verlassen können.
        </p>
        <p class="muted">
          Wir arbeiten mit klarer Absprache, einem Blick für Details und
          ehrlichen Grenzen. Was Fachbetriebe ausführen müssen, wird sauber
          koordiniert.
        </p>
        <div class="signature">
          <span>✎</span>
          <p>
            <strong>Eckhard Singer</strong><small
              >Inhaber · Fixum Objektservice</small
            >
          </p>
        </div>
      </div>
      <div
        class="intro-collage"
        aria-label="Eindrücke aus Objektservice und Ausbau"
      >
        <Photo
          src="/images/service-clearance.png"
          alt="Sortierte Räumung in einer Wohnung"
          width={900}
          height={650}
          class="collage-main"
        />
        <Photo
          src="/images/service-drywall.png"
          alt="Trockenbauarbeiten in einer Wohnung"
          width={620}
          height={460}
          class="collage-small top"
        />
        <Photo
          src="/images/team-van.png"
          alt="Fixum Team bei der Objektvorbereitung"
          width={620}
          height={460}
          class="collage-small bottom"
        />
        <div class="collage-logo">
          <img
            src="/logo/fixum-lockup-white.png"
            alt="Fixum Objektservice"
            width="260"
            height="96"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="leistungen" class="section services-stage section--dark">
    <div class="container section-head">
      <p class="script">Zwei Bereiche, eine Rechnung</p>
      <p class="eyebrow">Leistungen</p>
      <h2>Das machen <span class="blue-word">wir</span></h2>
      <p class="muted">
        Die meisten Betriebe können entweder räumen oder ausbauen. Wir machen
        beides - und genau dazwischen liegt die Arbeit, die sonst liegen bleibt.
      </p>
    </div>
    <div class="container grid-3 service-top">
      {
        services
          .slice(0, 3)
          .map((service) => <ServiceCard {...service} large />)
      }
    </div>
    <div class="container grid-3 service-small">
      {services.slice(3).map((service) => <ServiceCard {...service} />)}
    </div>
  </section>

  <section class="section section--chain">
    <div class="container section-head">
      <p class="script">So läuft ein Objekt bei uns durch</p>
      <p class="eyebrow">Unser Weg</p>
      <h2>Vom vollen Haus zur fertigen Wohnung</h2>
      <p class="muted">
        Andere machen einen Schritt. Wir machen alle vier - Sie koordinieren
        niemanden und bekommen eine Rechnung.
      </p>
    </div>
    <div class="container chain-grid">
      {
        chain.map(([headline, text], index) => (
          <article>
            <>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <h3>{headline}</h3>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
    <p class="container chain-note">
      Sie brauchen nur einen Teil davon? Auch gut - jeder Schritt ist einzeln
      buchbar.
    </p>
  </section>

  <section class="section section--mist">
    <div class="container section-head">
      <p class="eyebrow">Warum Fixum</p>
      <h2>Sechs Gründe, die im Angebot stehen</h2>
    </div>
    <div class="container grid-3 reason-grid">
      {
        reasons.map(([headline, text]) => (
          <article class="card">
            <>
              <span>✦</span>
              <h3>{headline}</h3>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container section-head">
      <p class="eyebrow">Auftraggeber</p>
      <h2>Privat, Verwaltung, Baustelle</h2>
    </div>
    <div class="container grid-3 audience">
      <article class="card">
        <h3>Privatkunden - Wenn eine Wohnung leer werden muss</h3>
        <p>
          Im Trauerfall, beim Umzug ins Heim oder bei der Übergabe an den
          Vermieter. Wir nehmen Ihnen die Abwicklung ab, von der Besichtigung
          bis zur Schlüsselübergabe - diskret und ohne Zeitdruck.
        </p>
        <ul>
          <li>Festpreis nach kostenloser Besichtigung</li><li>
            Wertanrechnung auf verwertbaren Hausrat
          </li><li>20 % der Arbeitskosten nach § 35a EStG absetzbar</li>
        </ul>
        <Button href="/kontakt">Besichtigung anfragen</Button>
      </article>
      <article class="card">
        <h3>Hausverwaltungen - Mieterwechsel in einem Durchgang</h3>
        <p>
          Räumen, rückbauen, renovieren, übergeben - ein Ansprechpartner, eine
          Rechnung, weniger Leerstandstage pro Einheit. Auf Wunsch mit
          Fotodokumentation zur Abnahme.
        </p>
        <ul>
          <li>Rahmenvereinbarung mit festen Konditionen möglich</li><li>
            Feste Reaktionszeit bei Schlüsselübergabe
          </li><li>Abrechnung pro Objekt oder gesammelt</li>
        </ul>
        <Button href="/fuer-hausverwaltungen">Konditionen anfordern</Button>
      </article>
      <article class="card">
        <h3>Bauunternehmen - Trockenbau als Nachunternehmer</h3>
        <p>
          Zuverlässiger Sub für Ausbaugewerke in Ostfriesland. Wir kommen, wenn
          wir zugesagt haben - das ist im Trockenbau seltener als es sein
          sollte.
        </p>
        <ul>
          <li>Abrechnung nach m² oder Tagessatz</li><li>
            Betriebshaftpflicht mit Subunternehmer-Klausel
          </li><li>Freistellungsbescheinigung nach § 48b EStG auf Anfrage</li>
        </ul>
        <Button href="/fuer-bauunternehmen">Als Sub anfragen</Button>
      </article>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container tax-box">
      <h2>20 % zurück vom Finanzamt</h2>
      <p>
        Für Handwerkerleistungen in der selbst genutzten Wohnung sind 20 % der
        Arbeitskosten direkt von der Steuerschuld absetzbar (§ 35a EStG), bis zu
        1.200 € im Jahr. Wir weisen Arbeits- und Fahrtkosten auf der Rechnung
        getrennt aus, damit Sie das ohne Rückfragen geltend machen können.
        Voraussetzung: Überweisung, keine Barzahlung.
      </p>
    </div>
  </section>

  <section id="ablauf" class="section">
    <div class="container section-head">
      <h2>In drei Schritten zum Festpreis</h2>
    </div>
    <div class="container process">
      <article>
        <span>☎</span><h3>Anrufen oder Fotos schicken</h3><p>
          Kurze Einschätzung sofort am Telefon, ganz ohne Termin.
        </p>
      </article>
      <article>
        <span>⌂</span><h3>Besichtigung vor Ort</h3><p>
          Meist innerhalb von zwei Werktagen. Kostenlos und unverbindlich.
        </p>
      </article>
      <article>
        <span>✓</span><h3>Festpreis schriftlich</h3><p>
          Sie bekommen ein Angebot mit Leistungsumfang und Preis. Danach
          entscheiden Sie in Ruhe.
        </p>
      </article>
    </div>
    <p class="container process-note">
      Kein Vertreterbesuch, kein Abschlussdruck, keine Unterschrift vor Ort
      nötig.
    </p>
  </section>

  {
    site.showReferences && (
      <section class="section references">
        <div class="container section-head">
          <p class="eyebrow">Referenzen</p>
          <h2>Vorher und Nachher</h2>
          <p class="muted">Echte Baustellen aus Emden und Umgebung.</p>
        </div>
        <div class="container">
          <Photo
            src="/images/reference-before-after.png"
            alt="Vorher-Nachher einer Raumrenovierung von Fixum Objektservice"
            width={1600}
            height={1200}
          />
        </div>
      </section>
    )
  }

  <section class="section section--mist">
    <div class="container section-head">
      <p class="eyebrow">FAQ</p>
      <h2>Die häufigsten Fragen</h2>
    </div>
    <div class="container faq-wrap"><FaqAccordion /></div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    min-height: 820px;
    padding: 152px 0 42px;
    background-image:
      linear-gradient(
        90deg,
        rgba(10, 23, 48, 0.9),
        rgba(10, 23, 48, 0.62) 52%,
        rgba(10, 23, 48, 0.85)
      ),
      url("/images/hero-renovation.png");
    background-size: cover;
    background-position: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 430px;
    gap: 48px;
    align-items: center;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero h1 span {
    color: var(--blue-light);
  }

  .hero-pill {
    display: inline-flex;
    border: 1px solid rgba(79, 160, 245, 0.45);
    border-radius: 999px;
    padding: 7px 14px;
    color: #d8e7fb;
    background: rgba(10, 23, 48, 0.52);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .lead {
    max-width: 680px;
    margin: 22px 0 28px;
    color: #d8e7fb;
    font-size: 20px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 44px;
  }

  .hero-chips a {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    gap: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 12px 20px;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(14px);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero-chips a:first-child {
    color: var(--navy-deep);
    background: #fff;
  }

  .hero-chips span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    color: #fff;
    background: var(--blue);
  }

  .trust {
    padding: 30px 0;
    border-top: 1px solid rgba(220, 229, 242, 0.12);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .trust article span,
  .reason-grid span {
    color: var(--amber);
  }

  .trust h2 {
    margin: 8px 0 4px;
    font-size: 18px;
    text-transform: none;
  }

  .trust p {
    color: #d8e7fb;
    font-size: 15px;
    line-height: 1.45;
  }

  .intro-panel {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 80% 35%,
        rgba(79, 160, 245, 0.18),
        transparent 32%
      ),
      linear-gradient(180deg, #fff 0%, #f7fbff 100%);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 54px;
    align-items: center;
  }

  .intro-copy {
    display: grid;
    gap: 18px;
  }

  .intro-strong {
    color: var(--ink);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.45;
  }

  .signature {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--line);
    margin-top: 8px;
    padding-top: 20px;
  }

  .signature > span {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    color: #fff;
    background: var(--navy-deep);
  }

  .signature strong {
    display: block;
    color: var(--blue);
    font-family: "Kaushan Script", cursive;
    font-size: 28px;
    font-weight: 400;
    line-height: 1;
  }

  .signature small {
    color: var(--navy);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .intro-collage {
    position: relative;
    min-height: 540px;
  }

  .intro-collage :global(.photo) {
    position: absolute;
    border: 8px solid #fff;
    border-radius: 28px;
    box-shadow: 0 24px 70px rgba(16, 36, 78, 0.18);
  }

  .intro-collage :global(.photo img) {
    aspect-ratio: 4 / 3;
  }

  .intro-collage :global(.collage-main) {
    inset: 72px 42px auto 128px;
    z-index: 1;
  }

  .intro-collage :global(.collage-small.top) {
    inset: 0 auto auto 24px;
    width: 34%;
    z-index: 2;
  }

  .intro-collage :global(.collage-small.bottom) {
    inset: auto auto 0 76px;
    width: 38%;
    z-index: 3;
  }

  .collage-logo {
    position: absolute;
    right: 22px;
    bottom: 36px;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 220px;
    min-height: 132px;
    border: 1px solid rgba(79, 160, 245, 0.24);
    border-radius: 24px;
    background: var(--navy-deep);
    box-shadow: 0 24px 70px rgba(16, 36, 78, 0.18);
  }

  .collage-logo img {
    width: 170px;
    height: auto;
  }

  .section-head {
    max-width: 820px;
    margin-bottom: 34px;
  }

  .section-head p:last-child {
    margin-top: 14px;
  }

  .service-small {
    margin-top: 22px;
  }

  .services-stage {
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(31, 122, 224, 0.22),
        transparent 34%
      ),
      linear-gradient(180deg, #071326 0%, var(--navy-deep) 54%, #08182f 100%);
  }

  .services-stage .section-head {
    margin-inline: auto;
    text-align: center;
  }

  .services-stage :global(.service-card.card) {
    border-color: rgba(220, 229, 242, 0.16);
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 20px 54px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(10px);
  }

  .services-stage :global(.service-card h3) {
    color: #fff;
  }

  .services-stage :global(.service-card p) {
    color: #d8e7fb;
  }

  .services-stage :global(.service-card a) {
    color: var(--blue-light);
  }

  .chain-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .chain-grid article {
    border: 1px solid rgba(220, 229, 242, 0.18);
    border-radius: 18px;
    padding: 24px;
    background: rgba(255, 255, 255, 0.04);
  }

  .chain-grid strong {
    color: var(--amber);
    font-family: "Outfit", sans-serif;
    font-size: 34px;
  }

  .chain-grid p,
  .chain-note {
    color: #d8e7fb;
  }

  .chain-note {
    margin-top: 24px;
    text-align: center;
  }

  .reason-grid article,
  .audience article {
    padding: 26px;
  }

  .reason-grid h3,
  .audience h3 {
    margin: 10px 0 12px;
  }

  .audience ul {
    padding-left: 20px;
    color: var(--muted);
  }

  .audience .btn {
    margin-top: 10px;
  }

  .tax-box {
    border-left: 4px solid var(--amber);
    border-radius: 18px;
    padding: 34px;
    background: #fff;
  }

  .tax-box h2 {
    margin-bottom: 14px;
  }

  .process {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px;
    text-align: center;
  }

  .process span {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: 0 auto 16px;
    border-radius: 999px;
    color: #fff;
    background: var(--blue);
  }

  .process-note {
    margin-top: 24px;
    text-align: center;
    color: var(--muted);
  }

  .references :global(.photo img) {
    aspect-ratio: 16 / 9;
  }

  .faq-wrap {
    max-width: 880px;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .trust-grid,
    .intro-grid,
    .chain-grid,
    .process {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 118px;
    }

    .hero-chips {
      margin-top: 28px;
    }

    .intro-collage {
      min-height: auto;
      display: grid;
      gap: 16px;
    }

    .intro-collage :global(.photo),
    .intro-collage :global(.collage-main),
    .intro-collage :global(.collage-small.top),
    .intro-collage :global(.collage-small.bottom),
    .collage-logo {
      position: relative;
      inset: auto;
      width: 100%;
    }

    .collage-logo {
      min-height: 120px;
    }
  }
</style>
