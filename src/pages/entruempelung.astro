---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/entruempelung/";
---

<ServiceDetailPage
  current={current}
  crumb="Entrümpelung"
  metaTitle="Fixum Objektservice: Entrümpelung Emden zum Festpreis"
  description="Entrümpelung in Emden und Ostfriesland: Wohnung, Haus, Keller, Nachlass. Ab 15 €/m², Festpreis nach kostenloser Besichtigung, besenreine Übergabe."
  eyebrow="Entrümpelung Emden"
  title="Entrümpelung und Haushaltsauflösung zum Festpreis"
  heroText="Fixum Objektservice aus Emden entrümpelt Wohnungen, Häuser, Keller, Dachböden und Garagen in Emden, Aurich, Leer, Norden und ganz Ostfriesland. Für Privatpersonen, Erben, Vermieter und Hausverwaltungen - sortenrein entsorgt und besenrein übergeben."
  image="/images/categories/haushaltsaufloesung.png"
  imageAlt="Entrümpelung einer Wohnung: Umzugskartons und Hausrat zum Abtransport (Symbolbild)"
  serviceType="Entrümpelung und Haushaltsauflösung"
  areaTitle="Entrümpelung in Emden, Aurich, Leer und Umgebung"
  lead="Wohnungen, Häuser, Keller, Dachböden, Garagen, Nachlässe und Übergaben an Vermieter. Sie zeigen uns, was bleibt. Alles andere wird ordentlich sortiert, getragen und entsorgt - ohne dass Sie dabei sein müssen."
  included={[
    "Kostenlose Besichtigung vor Ort oder erste Einschätzung nach Fotos per WhatsApp",
    "Festpreis mit Leistungsumfang in Textform - ohne Nachberechnung",
    "Räumung von Wohnung, Haus, Keller, Dachboden, Garage und Nebenräumen",
    "Sortenreine Trennung nach Holz, Metall, Elektro, Bauschutt und Restmüll",
    "Fotodokumentation des Objektzustands vor und nach der Räumung",
    "Besenreine Übergabe, auf Wunsch mit Entsorgungsnachweis über die Fraktionen",
    "Demontage von Einbauten, Möbeln und Bodenbelägen nach Absprache",
  ]}
  process={[
    [
      "Anfrage",
      "Sie rufen an oder schicken Fotos per WhatsApp. Für eine erste Preisspanne reichen meist Bilder von Keller, Dachboden und den vollsten Zimmern.",
    ],
    [
      "Besichtigung und Festpreis",
      "Vor Ort prüfen wir Volumen, Etagen, Laufwege, Parkmöglichkeit und Abfallarten. Danach steht der Festpreis schriftlich fest, samt Leistungsgrenzen.",
    ],
    [
      "Räumung",
      "Am vereinbarten Tag räumen wir vollständig, tragen ab und trennen direkt vor Ort nach Holz, Metall, Elektro, Bauschutt und Restmüll.",
    ],
    [
      "Übergabe",
      "Besenreine Übergabe zum zugesagten Termin, auf Wunsch mit Fotodokumentation und Entsorgungsnachweis über die Fraktionen.",
    ],
  ]}
  facts={[
    ["Besichtigung", "Kostenlos, meist innerhalb von zwei Werktagen."],
    [
      "Preis",
      "Festpreis nach Besichtigung, in Textform und ohne Nachberechnung.",
    ],
    ["Entsorgung", "Sortenrein getrennt, Nachweis auf Wunsch."],
    ["Übergabe", "Besenrein, auf Wunsch mit Entsorgungsnachweis."],
  ]}
  noteTitle="Warum der Festpreis erst nach der Besichtigung steht"
  noteText="Der Aufwand hängt vom Volumen, der Zugänglichkeit, den Abfallarten und der Entfernung zum Fahrzeug ab - eine vollgestellte Zweizimmerwohnung im vierten Stock ohne Aufzug ist mehr Arbeit als ein halbleeres Haus mit Hofzufahrt. Der Richtwert pro Quadratmeter gibt eine erste Orientierung. Verbindlich ist der Festpreis nach der Besichtigung - und der gilt dann auch."
  beispiele={[
    [
      "Haushaltsauflösung nach einem Todesfall",
      "Wenn Angehörige weiter weg wohnen, räumen wir nach Schlüsselübergabe. Dokumente, Fotos und Erinnerungsstücke legen wir zur Seite und übergeben sie Ihnen.",
    ],
    [
      "Wohnungsübergabe an den Vermieter",
      "Die Wohnung muss zu einem festen Termin leer sein. Wir planen rückwärts vom Übergabetermin und dokumentieren den Zustand auf Wunsch mit Fotos.",
    ],
    [
      "Keller, Dachboden oder Garage",
      "Einzelne Räume, die über Jahre vollgestellt wurden: räumen, nach Holz, Metall, Elektro und Restmüll trennen, alles mitnehmen.",
    ],
    [
      "Haus entrümpeln vor Verkauf oder Sanierung",
      "Das Haus soll leer sein, bevor Käufer oder Handwerker kommen. Auf Wunsch geht es danach direkt mit Rückbau und Innenausbau weiter.",
    ],
    [
      "Mieterwechsel für Hausverwaltungen",
      "Zurückgelassenes wird geräumt und entsorgt, die Einheit besenrein übergeben - mit Fotodokumentation und Entsorgungsnachweis auf Wunsch.",
    ],
    [
      "Messie-Wohnungen",
      "Mit Ruhe, Schutzausrüstung und ohne Kommentar. Den Mehraufwand nehmen wir bei der Besichtigung auf und nennen ihn vorher.",
    ],
  ]}
  vorteile={[
    [
      "Ein Ansprechpartner",
      "Vom ersten Anruf bis zur Übergabe sprechen Sie mit derselben Person.",
    ],
    [
      "Festpreis in Textform",
      "Nach der Besichtigung steht der Preis schriftlich fest, samt Leistungsgrenzen.",
    ],
    [
      "Sortenreine Entsorgung",
      "Getrennt nach Fraktionen statt Mischcontainer, Nachweis auf Wunsch.",
    ],
    [
      "Räumen und Ausbauen aus einer Hand",
      "Nach der Entrümpelung kann dasselbe Team zurückbauen und den Innenausbau übernehmen.",
    ],
  ]}
  preis={["entruempelung"]}
  preisText="Der Preis richtet sich nach Wohnfläche, Füllgrad, Etage und Entsorgung. Der Richtwert gibt eine erste Orientierung, verbindlich ist der Festpreis nach der kostenlosen Besichtigung."
  kette="raeumen"
  faq={serviceFaq[current]}
/>
