---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/montage-boden/";
---

<ServiceDetailPage
  current={current}
  crumb="Boden & Türen"
  metaTitle="Bodenverlegung & Türmontage in Emden | Fixum Objektservice"
  description="Laminat, Vinyl und Teppich verlegen, Türen und Zargen montieren in Emden und Ostfriesland. Nach Aufmaß, zum Festpreis und direkt im Anschluss an Rückbau oder Trockenbau."
  eyebrow="Boden & Türen"
  title="Bodenverlegung und Türmontage in Emden"
  heroText="Der Schritt, der aus einem leeren Raum wieder einen fertigen macht: Boden verlegt, Türen gesetzt, Übergänge sauber abgeschlossen."
  image="/images/categories/montage-boden.png"
  imageAlt="Verlegter Vinylboden und montierte Zarge in einer Wohnung in Emden"
  serviceType="Bodenverlegung und Türmontage"
  areaTitle="Boden und Türen in Emden und Ostfriesland"
  lead="Bodenbeläge und Türen wirken einfach - bis der Untergrund uneben ist, die Zarge nicht ins Mauerwerk passt oder die Tür nach dem Verlegen schleift. Deshalb nehmen wir beides in einem Aufmaß auf."
  included={[
    "Laminat, Vinyl, Klick-Systeme und Teppich fachgerecht verlegen",
    "Untergrund prüfen, ausgleichen und für den Belag vorbereiten",
    "Alte Beläge aufnehmen und entsorgen",
    "Sockelleisten, Übergangsprofile und Abschlüsse setzen",
    "Türen und Zargen montieren, ausrichten und einstellen",
    "Höhenabstimmung zwischen Boden und Türblatt in einem Arbeitsgang",
    "Verlegung von bauseits gestelltem Material nach Absprache",
  ]}
  process={[
    [
      "Anfrage",
      "Sie nennen Räume, ungefähre Flächen und den gewünschten Belag. Fotos des vorhandenen Bodens helfen bei der Einschätzung.",
    ],
    [
      "Aufmaß und Festpreis",
      "Untergrund, Feuchte, Ebenheit und Türsituation werden geprüft. Vorarbeiten wie Ausgleichsmasse stehen als eigene Position im Angebot.",
    ],
    [
      "Verlegung und Montage",
      "Alter Belag raus, Untergrund vorbereitet, Belag verlegt, Leisten und Übergänge gesetzt, Türen und Zargen montiert.",
    ],
    [
      "Übergabe",
      "Der Raum ist nutzbar, die Türhöhen sitzen. Verschnitt und Verpackung nehmen wir mit.",
    ],
  ]}
  facts={[
    ["Beläge", "Laminat, Vinyl, Klick-Systeme, Teppich."],
    ["Untergrund", "Prüfung und Ausgleich als eigene Position im Angebot."],
    ["Material", "Eigenes Material oder bauseits gestellt."],
    ["Türen", "Zargen und Türblätter auf Bodenhöhe abgestimmt."],
  ]}
  noteTitle="Boden und Türen gehören zusammen"
  noteText="Wer den Boden verlegen lässt und die Türen später separat beauftragt, zahlt die Abstimmung meist doppelt: Entweder schleift die Tür auf dem neuen Belag oder es bleibt eine Fuge, durch die es zieht. Wir nehmen beides in einem Aufmaß auf und stimmen die Höhen vorher ab - das kostet einmal Planung statt zweimal Nacharbeit."
  faq={serviceFaq[current]}
/>
