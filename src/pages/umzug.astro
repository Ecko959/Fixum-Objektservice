---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";
import { site } from "../data/site";

const current = "/umzug/";
---

<ServiceDetailPage
  current={current}
  crumb="Umzüge & Transporte"
  metaTitle="Fixum Objektservice: Umzüge & Transporte Emden"
  description={`Umzug in Emden und Ostfriesland: Privat- und Büroumzüge, Transporte bis ${site.maxTonnage}. 2-Zimmer-Wohnung ab 600 €, Festpreis nach Besichtigung.`}
  eyebrow="Umzüge & Transporte"
  title="Umzüge und Transporte mit festem Termin"
  heroText={`Fixum Objektservice übernimmt Umzüge und Transporte bis ${site.maxTonnage} in Emden und Ostfriesland - für Privathaushalte, kleinere Büros und Objektfahrten. Mit Möbeldemontage, Aufbau und auf Wunsch Entrümpelung im selben Termin.`}
  image="/images/categories/umzuege-transporte.png"
  imageAlt="Umzugshelfer laden ein in Decken gewickeltes Möbelstück in einen Transporter (Symbolbild)"
  serviceType="Umzüge und Transporte"
  areaTitle="Umzüge in Emden, Aurich, Leer und Umgebung"
  lead="Ein Umzug scheitert selten am Tragen, sondern an der Planung: Zu wenig Kartons, kein Parkplatz vor der Tür, ein Schrank, der nicht durchs Treppenhaus passt. Genau das klären wir vorher."
  included={[
    "Privatumzüge innerhalb von Emden und Ostfriesland",
    "Kleinere Büro- und Firmenumzüge mit fester Terminabsprache",
    `Objekt- und Materialtransporte bis ${site.maxTonnage} Fahrzeuggröße`,
    "Demontage und Wiederaufbau von Möbeln nach Absprache",
    "Absicherung von Treppenhaus, Türzargen und Böden",
    "Entsorgungsfahrten für alles, was nicht mitkommt",
    "Kombinierbar mit Entrümpelung, Räumung und Montage",
  ]}
  process={[
    [
      "Anfrage",
      "Sie schildern Umfang, Adressen und Wunschtermin. Für kleinere Umzüge genügt das Telefonat, sonst kommen wir vorbei.",
    ],
    [
      "Planung und Festpreis",
      "Wir klären Etagen, Laufwege, Parkmöglichkeiten, Demontagebedarf und Zieladresse. Danach steht der Preis für Team, Fahrzeug und Fahrten.",
    ],
    [
      "Umzugstag",
      "Treppenhaus und Zargen werden abgesichert, Möbel demontiert, geladen, transportiert und am Ziel wieder aufgestellt.",
    ],
    [
      "Abschluss",
      "Möbel werden wieder aufgebaut. Was zurückbleibt, nehmen wir auf Wunsch direkt zur Entsorgung mit.",
    ],
  ]}
  facts={[
    [
      "Größe",
      `Bis ${site.maxTonnage} Fahrzeuge - Wohnungen, Büros, Objektfahrten.`,
    ],
    ["Preis", "Festpreis nach Planung, keine Stundenüberraschung."],
    ["Extras", "Demontage, Aufbau und Entsorgung kombinierbar."],
    ["Gebiet", "Emden und rund 50 km Umkreis."],
  ]}
  noteTitle="Umzug und Entrümpelung in einem Termin"
  noteText="Oft zieht ein Teil des Hausstands mit um, der Rest muss weg. Wenn beides derselbe Betrieb macht, fährt ein Fahrzeug einmal statt zwei Firmen zweimal. Das ist spürbar günstiger als zwei getrennte Aufträge und spart Ihnen einen kompletten Koordinationstermin."
  beispiele={[
    [
      "Umzug innerhalb von Emden",
      "Kurze Wege, schnell eingeschätzt: Oft reichen ein Telefonat oder ein paar Fotos für den Festpreis.",
    ],
    [
      "Umzug nach Norden, Aurich oder Leer",
      "Umzüge im Nahbereich mit Transporter, Tragen und Fahrt - die Anfahrt steht im Angebot als eigene Position.",
    ],
    [
      "Umzug ins Heim mit Haushaltsauflösung",
      "Was mitkommt, wird transportiert und aufgebaut, der Rest der Wohnung geräumt und besenrein übergeben.",
    ],
    [
      "Kleinere Büroumzüge",
      "Mit fester Terminabsprache, damit der Betrieb so kurz wie möglich ruht.",
    ],
    [
      "Möbel- und Materialtransporte",
      `Einzelne Möbelstücke, Material oder Objektfahrten bis ${site.maxTonnage} Fahrzeuggröße.`,
    ],
    [
      "Umzug mit Küchenmontage",
      "Küche abbauen, transportieren und wieder aufbauen - die Anschlüsse übernimmt ein Fachbetrieb.",
    ],
  ]}
  vorteile={[
    [
      "Festpreis statt Stundensatz",
      "Team, Fahrzeug und Fahrten stehen vorher fest.",
    ],
    [
      "Umzug und Entrümpelung in einem Termin",
      "Ein Fahrzeug, ein Team, eine Rechnung.",
    ],
    ["Demontage und Aufbau", "Möbel werden ab- und am Ziel wieder aufgebaut."],
    [
      "Treppenhaus geschützt",
      "Treppenhaus, Türzargen und Böden werden vorher abgesichert.",
    ],
  ]}
  preis={["umzug"]}
  preisText="Der Preis hängt an Volumen, Etagen, Laufwegen, Parkmöglichkeit und Entfernung. Der Richtwert gilt für eine 2-Zimmer-Wohnung im Nahbereich - verbindlich ist der Festpreis nach Besichtigung oder Fotos."
  faq={serviceFaq[current]}
/>
