---
/* Sammelseite des Preisrechners. Auswahl und Rechner kommen aus
   RechnerWahl.astro. Direktaufruf einer Leistung: /preisrechner/#umzug */
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Anfrage from "../components/Anfrage.astro";
import RechnerWahl from "../components/RechnerWahl.astro";
import { rechnerBereit, type Leistung } from "../lib/preisrechner";
import preisConfig from "../data/preise.config.json";
import { preisHinweis } from "../data/preise";

const path = "/preisrechner/";
const breadcrumbs: Array<[string, string]> = [["Preisrechner", path]];

/* Seitenbeschreibung nennt nur die Rechner, deren Grundwerte in der Config
   stehen - dieselbe Regel wie in RechnerWahl. */
const namen = (
  [
    ["entruempelung", "Entrümpelung"],
    ["umzug", "Umzug"],
    ["trockenbau", "Trockenbau"],
    ["montage", "Montage"],
    ["boden", "Boden"],
  ] as Array<[Leistung, string]>
)
  .filter(([id]) => rechnerBereit(preisConfig, id))
  .map(([, label]) => label);
const namensliste =
  namen.length > 1
    ? `${namen.slice(0, -1).join(", ")} und ${namen[namen.length - 1]}`
    : namen.join("");
---

<Base
  title="Fixum Objektservice: Preisrechner"
  description={`Preisrechner für ${namensliste} in Emden und Ostfriesland: Richtwert in einer Minute, Festpreis nach Besichtigung.`}
  canonical={path}
  breadcrumbs={breadcrumbs}
>
  <section
    class="section page-top section--dark section--rechner rechner-seite"
  >
    <div class="container">
      <Breadcrumbs trail={breadcrumbs} />
      <div class="section-head kopf">
        <p class="eyebrow">Preisrechner</p>
        <h1>Was kostet mein Auftrag ungefähr?</h1>
        <p class="lead">
          Wählen Sie die Leistung und beantworten Sie ein paar einfache Fragen.
          Sie sehen sofort einen ungefähren Rahmen und können direkt einen
          Festpreis anfragen.
        </p>
        <p class="hinweis"><strong>{preisHinweis}</strong></p>
      </div>

      <RechnerWahl hash />
    </div>
  </section>

  <Anfrage
    eyebrow="Lieber persönlich?"
    titel="Festpreis nach kostenloser Besichtigung"
    text="Der Rechner zeigt einen Rahmen. Den verbindlichen Preis nennen wir, nachdem wir das Objekt gesehen haben - oder nach ein paar Fotos per WhatsApp."
  />
</Base>

<style>
  .kopf {
    margin-top: 1.25rem;
  }

  .hinweis {
    font-size: 0.9375rem;
    color: var(--on-dark);
  }
</style>
