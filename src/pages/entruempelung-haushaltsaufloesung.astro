---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/entruempelung-haushaltsaufloesung/";
---

<ServiceDetailPage
  current={current}
  crumb="Entrümpelung"
  metaTitle="Entrümpelung Emden zum Festpreis | Fixum Objektservice"
  description="Entrümpelung und Haushaltsauflösung in Emden und Ostfriesland: kostenlose Besichtigung, Festpreis in Textform, sortenreine Entsorgung und besenreine Übergabe."
  eyebrow="Entrümpelung Emden"
  title="Entrümpelung und Haushaltsauflösung in Emden"
  heroText="Wenn eine Wohnung leer werden muss, zählt ein ruhiger Ablauf. Fixum räumt, trennt sortenrein, entsorgt nachweisbar und übergibt besenrein."
  image="/images/categories/haushaltsaufloesung.png"
  imageAlt="Sortierte Entrümpelung einer Wohnung in Emden durch Fixum Objektservice"
  serviceType="Entrümpelung und Haushaltsauflösung"
  areaTitle="Entrümpelung in Emden, Aurich, Leer und Umgebung"
  lead="Wohnungen, Häuser, Keller, Dachböden, Garagen, Nachlässe und Übergaben an Vermieter. Sie zeigen uns, was bleibt. Alles andere wird ordentlich sortiert, getragen und entsorgt - ohne dass Sie dabei sein müssen."
  included={[
    "Kostenlose Besichtigung vor Ort oder erste Einschätzung nach Fotos per WhatsApp",
    "Festpreis mit Leistungsumfang in Textform - ohne Nachberechnung",
    "Räumung von Wohnung, Haus, Keller, Dachboden, Garage und Nebenräumen",
    "Sortenreine Trennung nach Holz, Metall, Elektro, Bauschutt und Restmüll",
    "Fotodokumentation des Objektzustands vor und nach der Räumung",
    "Besenreine Übergabe, auf Wunsch mit Fotodokumentation und Entsorgungsnachweis",
    "Demontage von Einbauten, Möbeln und Bodenbelägen nach Absprache",
  ]}
  process={[
    [
      "Anfrage",
      "Sie rufen an oder schicken Fotos per WhatsApp. Für eine erste Preisspanne reichen meist Bilder von Keller, Dachboden und den vollsten Zimmern.",
    ],
    [
      "Besichtigung und Festpreis",
      "Vor Ort prüfen wir Volumen, Etagen, Laufwege, Parkmöglichkeit und Abfallarten. Danach steht der Festpreis schriftlich fest, samt Leistungsgrenzen.",
    ],
    [
      "Räumung",
      "Am vereinbarten Tag räumen wir vollständig, tragen ab und trennen direkt vor Ort nach Holz, Metall, Elektro, Bauschutt und Restmüll.",
    ],
    [
      "Übergabe",
      "Besenreine Übergabe zum zugesagten Termin, auf Wunsch mit Fotodokumentation und Entsorgungsnachweis über die Fraktionen.",
    ],
  ]}
  facts={[
    ["Besichtigung", "Kostenlos, meist innerhalb von zwei Werktagen."],
    [
      "Preis",
      "Festpreis nach Besichtigung, in Textform und ohne Nachberechnung.",
    ],
    ["Entsorgung", "Sortenrein getrennt, Nachweis auf Wunsch."],
    ["Übergabe", "Besenrein, auf Wunsch mit Entsorgungsnachweis."],
  ]}
  noteTitle="Warum es keine Preisliste gibt"
  noteText="Der Aufwand hängt vom Volumen, der Zugänglichkeit, den Abfallarten und der Entfernung zum Fahrzeug ab - eine vollgestellte Zweizimmerwohnung im vierten Stock ohne Aufzug ist mehr Arbeit als ein halbleeres Haus mit Hofzufahrt. Ein sauberer Festpreis ist deshalb erst nach Besichtigung fair. Dafür gilt er dann auch."
  faq={serviceFaq[current]}
/>
