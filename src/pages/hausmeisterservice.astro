---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/hausmeisterservice/";
---

<ServiceDetailPage
  current={current}
  crumb="Hausmeisterservice"
  metaTitle="Fixum Objektservice: Hausmeisterservice Emden"
  description="Hausmeisterservice in Emden und Ostfriesland: Kleinreparaturen, Objektkontrolle, Außenanlagen und Winterdienst - einmalig oder als Rahmenvertrag."
  eyebrow="Hausmeisterservice"
  title="Objektbetreuung mit festem Ansprechpartner"
  heroText="Fixum Objektservice betreut Wohn- und Gewerbeobjekte in Emden und Ostfriesland: Objektkontrolle, Kleinreparaturen, Außenanlagen und Winterdienst. Für Eigentümer, Hausverwaltungen und Gewerbe - einmalig oder als Rahmenvertrag."
  image="/images/categories/hausmeister-winterdienst.png"
  imageAlt="Hausmeister mit Besen und Streuwagen vor einem Klinkerhaus (Symbolbild)"
  serviceType="Hausmeisterservice und Objektbetreuung"
  areaTitle="Hausmeisterservice in Emden und Ostfriesland"
  lead="Die meisten Objektprobleme sind klein, wenn man sie früh sieht - und teuer, wenn niemand hinschaut. Genau dafür ist eine laufende Betreuung da: regelmäßig vorbeischauen, kleine Sachen sofort erledigen, große rechtzeitig melden."
  included={[
    "Regelmäßige Objektkontrolle mit kurzer Rückmeldung",
    "Kleinreparaturen an Türen, Schlössern, Beschlägen und Befestigungen",
    "Silikonfugen erneuern und kleine Trockenbauschäden ausbessern",
    "Pflege von Außenanlagen, Wegen und Grünflächen",
    "Winterdienst nach schriftlicher Vereinbarung",
    "Betreuung von Nebenräumen, Kellern und Gemeinschaftsflächen",
    "Rahmenvertrag mit festen Stundensätzen und Reaktionszeiten",
  ]}
  process={[
    [
      "Anfrage",
      "Sie schildern Objekt und Bedarf - einmalige Arbeiten oder laufende Betreuung.",
    ],
    [
      "Objektbegehung",
      "Wir gehen das Objekt einmal gemeinsam durch und halten fest, was regelmäßig anfällt und was auf Abruf erledigt werden soll.",
    ],
    [
      "Vereinbarung",
      "Leistungsumfang, Turnus, Reaktionszeit und Konditionen kommen schriftlich in die Vereinbarung - kein Nachverhandeln bei jedem Einsatz.",
    ],
    [
      "Laufende Betreuung",
      "Wir kommen wie vereinbart, erledigen die Arbeiten und melden zurück. Was Fachbetriebe brauchen, sagen wir rechtzeitig.",
    ],
  ]}
  facts={[
    ["Modell", "Einmalig auf Abruf oder als Rahmenvertrag."],
    ["Reaktionszeit", "Im Rahmenvertrag schriftlich festgelegt."],
    ["Umfang", "Handwerklicher Kleinbereich plus Außenanlagen."],
    ["Grenze", "Keine Arbeiten an Strom, Gas, Wasser und Heizung."],
  ]}
  noteTitle="Für wen sich das rechnet"
  noteText="Für Eigentümer, bei denen kleinere Arbeiten regelmäßig liegen bleiben. Für Verwaltungen, die bei Mieterwechsel, Übergabe und laufender Pflege kurze Wege brauchen. Und für Gewerbe mit Flächen, Nebenräumen und Außenbereichen, die ordentlich aussehen sollen, ohne dass jemand intern dafür abgestellt wird."
  beispiele={[
    [
      "Laufende Objektkontrolle",
      "Regelmäßige Rundgänge mit kurzer Rückmeldung, damit kleine Schäden nicht groß werden.",
    ],
    [
      "Kleinreparaturen auf Abruf",
      "Türen, Schlösser, Beschläge, Silikonfugen und kleine Trockenbauschäden.",
    ],
    [
      "Außenanlagen und Winterdienst",
      "Wege, Grünflächen und Räum- und Streupflicht nach schriftlicher Vereinbarung.",
    ],
    [
      "Unterstützung beim Mieterwechsel",
      "Räumen, kleine Reparaturen und Übergabe aus einer Hand für Verwaltungen.",
    ],
  ]}
  beispieleTitel="Typische Aufgaben in Emden und Ostfriesland"
  vorteile={[
    ["Fester Ansprechpartner", "Kurze Wege statt wechselnder Zuständigkeiten."],
    [
      "Schriftliche Konditionen",
      "Umfang, Turnus und Reaktionszeit stehen in der Vereinbarung.",
    ],
    [
      "Klare Grenzen",
      "Strom, Gas, Wasser und Heizung übernehmen zugelassene Fachbetriebe.",
    ],
    [
      "Mehr als Hausmeister",
      "Bei Bedarf auch Entrümpelung, Rückbau und Innenausbau.",
    ],
  ]}
  preis={["hausmeister"]}
  faq={serviceFaq[current]}
/>
