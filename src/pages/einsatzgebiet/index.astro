---
/* Übersicht Einsatzgebiet: Radius, alle Orte nach Landkreis, schematische
   Karte (eigenes SVG, kein Karten-Embed - keine Daten an Dritte) und Links
   auf die drei Ortsseiten und die Leistungsseiten. Orte ohne eigene Seite
   werden nur genannt. Daten: src/data/orte.ts. */
import Base from "../../layouts/Base.astro";
import { fotos } from "../../data/referenzen";
import Anfrage from "../../components/Anfrage.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import { canonicalPath, serviceSchema } from "../../data/seo";
import { emden, gebiet, ortSeiten, radiusText } from "../../data/orte";
import type { IconName } from "../../data/icons";

const path = "/einsatzgebiet/";
const breadcrumbs: Array<[string, string]> = [["Einsatzgebiet", path]];
const heroBild = fotos.umzug;
const heroImage = heroBild.pfad;

const description =
  "Entrümpelung, Umzug, Trockenbau und Entkernung in Emden und bis ca. 50 km Umkreis: Aurich, Leer, Norden, Krummhörn, Moormerland, Wittmund und mehr.";

const schema = [
  serviceSchema({
    name: "Objektservice in Ostfriesland",
    description,
    path: canonicalPath(path),
    serviceType: "Entrümpelung, Umzug, Trockenbau und Entkernung",
  }),
];

/* ---- Schematische Karte ----
   Flächentreue Näherung um Emden: 1 km = 5 Einheiten. Der Kreis zeigt den
   Radius von 50 km Luftlinie. */
const MASS = 5;
const RADIUS_KM = 50;
const kmProGradLaenge = 111.32 * Math.cos((emden.lat * Math.PI) / 180);
const punkt = (lat: number, lon: number) => ({
  x: (lon - emden.lon) * kmProGradLaenge * MASS,
  y: -(lat - emden.lat) * 110.57 * MASS,
});
const mitLabel = new Set([
  "Emden",
  "Leer",
  "Norden",
  "Aurich",
  "Wittmund",
  "Esens",
  "Papenburg",
  "Wiesmoor",
  "Krummhörn",
]);
const kartenOrte = gebiet.flatMap((g) =>
  g.orte.map((o) => ({
    ...o,
    ...punkt(o.lat, o.lon),
    label: mitLabel.has(o.name),
  })),
);
const halb = (RADIUS_KM + 8) * MASS;
/* Beschriftung links vom Punkt, wo rechts ein Nachbarort sitzt. */
const links = new Set(["Norden", "Krummhörn"]);

const leistungsLinks: Array<[string, string, IconName]> = [
  ["Entrümpelung", "/entruempelung/", "karton"],
  ["Umzug", "/umzug/", "transporter"],
  ["Trockenbau", "/trockenbau/", "platten"],
  ["Entkernung", "/entkernung/", "vorschlaghammer"],
];
---

<Base
  title="Fixum Objektservice: Einsatzgebiet Ostfriesland"
  description={description}
  canonical={path}
  breadcrumbs={breadcrumbs}
  schema={schema}
  preloadImage={heroImage}
>
  <PageHero
    eyebrow="Einsatzgebiet"
    title="Von Emden aus bis ca. 50 km Umkreis"
    text="Wir arbeiten von unserem Standort in Emden aus in einem Umkreis von bis zu ca. 50 km – in Teilen der Landkreise Aurich, Leer und Wittmund und bis Papenburg. Die Anfahrt steht in jedem Angebot als eigene Position, getrennt von der Arbeitszeit."
    image={heroImage}
    imageAlt={heroBild.alt}
    breadcrumbs={breadcrumbs}
    badges={[
      "Besichtigung kostenlos",
      "Anfahrt separat ausgewiesen",
      "Festpreis schriftlich",
    ]}
    anfrage=""
  />

  {/* Orte mit eigener Seite */}
  <section class="section" aria-labelledby="staedte-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Eigene Ortsseiten</p>
      <h2 id="staedte-title">Leer, Norden und Aurich</h2>
      <p class="muted">
        Für die drei größten Orte im Umkreis gibt es eine eigene Seite mit allen
        Leistungen, Ab-Preisen, typischen Aufträgen vor Ort und Fragen von dort.
      </p>
    </div>
    <ul class="container staedte" data-reveal-group>
      {
        ortSeiten.map((o) => (
          <li class="card stadt-karte" data-reveal>
            <p class="stadt-meta">
              {o.landkreis} · {o.fahrzeit} von Emden
            </p>
            <h3>
              <a href={`/${o.slug}/`} class="stadt-link">
                {o.name}
              </a>
            </h3>
            <p class="muted">{o.teaser}</p>
            <span class="arrow-link" aria-hidden="true">
              Zur Seite {o.name}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Alle Orte nach Landkreis + Karte */}
  <section class="section section--soft" aria-labelledby="orte-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Alle Orte</p>
      <h2 id="orte-title">Hier sind wir regelmäßig im Einsatz</h2>
      <p class="muted">
        Alle Orte liegen {radiusText} (Luftlinie). Ihr Ort fehlt? Fragen Sie trotzdem
        – größere Aufträge fahren wir auch weiter.
      </p>
    </div>

    <div class="container gebiet-grid">
      <div class="kreise" data-reveal>
        {
          gebiet.map((g) => (
            <div class="kreis">
              <h3>{g.kreis}</h3>
              <ul>
                {g.orte.map((o) => (
                  <li>
                    {o.seite ? <a href={o.seite}>{o.name}</a> : o.name}
                    {o.zusatz && <span class="zusatz"> {o.zusatz}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <figure class="karte card" data-reveal>
        <svg
          viewBox={`${-halb} ${-halb} ${halb * 2} ${halb * 2}`}
          role="img"
          aria-labelledby="karte-titel"
        >
          <title id="karte-titel">
            Vereinfachte Karte: Emden in der Mitte, Kreis mit 50 km Radius und
            die Orte im Einsatzgebiet
          </title>
          <circle class="k-radius" r={RADIUS_KM * MASS}></circle>
          <circle class="k-radius k-radius--innen" r={25 * MASS}></circle>
          <text
            class="k-km"
            x="0"
            y={-RADIUS_KM * MASS + 18}
            text-anchor="middle"
          >
            50 km
          </text>
          {
            kartenOrte.map((o) => (
              <g
                class:list={[
                  "k-ort",
                  {
                    "k-ort--seite": o.seite && o.name !== "Emden",
                    "k-ort--emden": o.name === "Emden",
                  },
                ]}
              >
                <circle
                  cx={o.x}
                  cy={o.y}
                  r={o.name === "Emden" ? 9 : o.seite ? 7 : 4}
                />
                {o.label && (
                  <text
                    x={links.has(o.name) ? o.x - 11 : o.x + 11}
                    y={o.y + 5}
                    text-anchor={links.has(o.name) ? "end" : "start"}
                  >
                    {o.name}
                  </text>
                )}
              </g>
            ))
          }
        </svg>
        <figcaption>
          Vereinfachte Darstellung, Luftlinie. Größere Punkte: Emden und die
          Orte mit eigener Seite.
        </figcaption>
      </figure>
    </div>
  </section>

  {/* Leistungen */}
  <section class="section" aria-labelledby="leistungen-title">
    <div class="container section-head" data-reveal>
      <p class="eyebrow">Leistungen</p>
      <h2 id="leistungen-title">Im ganzen Einsatzgebiet</h2>
      <p class="muted">
        Alle Leistungen gibt es überall im Umkreis – zum selben Ablauf wie in
        Emden: kostenlose Besichtigung, schriftlicher Festpreis, gehaltener
        Termin.
      </p>
    </div>
    <ul class="container leistungs-links" data-reveal>
      {
        leistungsLinks.map(([label, href, icon]) => (
          <li>
            <a href={href}>
              <Icon name={icon} size={22} />
              <span>{label}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/leistungen/">
          <Icon name="arrow" size={22} />
          <span>Alle Leistungen</span>
        </a>
      </li>
    </ul>
  </section>

  <Anfrage
    eyebrow="Ihr Ort im Umkreis?"
    titel="Kostenlose Besichtigung anfragen"
    text="Sagen Sie uns kurz, wo und worum es geht. Die Besichtigung ist kostenlos, die Anfahrt steht im Angebot als eigene Position."
  />
</Base>

<style>
  .staedte {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 auto;
    list-style: none;
  }

  .stadt-karte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    transition:
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .stadt-karte:hover {
    border-color: var(--blue-light);
    transform: translateY(-2px);
  }

  .stadt-karte h3 {
    margin: 0;
    font-size: var(--step-3);
  }

  .stadt-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .stadt-meta {
    margin: 0;
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .stadt-karte .muted {
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
  }

  .stadt-karte .arrow-link {
    margin-top: auto;
  }

  .gebiet-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* Spalten statt Raster: lange und kurze Listen laufen ohne Lücken
     untereinander. */
  .kreise {
    columns: 2;
    column-gap: 2rem;
  }

  .kreis {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  .kreis h3 {
    margin: 0 0 0.6rem;
    font-size: var(--step-1);
  }

  .kreis ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kreis li {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .kreis a {
    font-weight: 600;
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .zusatz {
    color: var(--muted);
  }

  .karte {
    margin: 0;
    padding: 1rem;
  }

  .karte svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }

  .k-radius {
    fill: rgba(22, 104, 196, 0.05);
    stroke: var(--blue);
    stroke-width: 2;
    stroke-dasharray: 8 6;
  }

  .k-radius--innen {
    fill: none;
    stroke: var(--line-strong);
    stroke-dasharray: 4 6;
  }

  .k-km {
    font-size: 15px;
    font-weight: 600;
    fill: var(--blue);
  }

  .k-ort circle {
    fill: var(--muted);
  }

  .k-ort text {
    font-size: 15px;
    fill: var(--ink);
  }

  .k-ort--seite circle {
    fill: var(--blue);
  }

  .k-ort--seite text,
  .k-ort--emden text {
    font-size: 17px;
    font-weight: 700;
    fill: var(--navy);
  }

  .k-ort--emden circle {
    fill: var(--navy);
  }

  .karte figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .leistungs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 auto;
    list-style: none;
  }

  .leistungs-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--navy);
    background: #fff;
    transition: border-color var(--dur) var(--ease-out);
  }

  .leistungs-links a:hover {
    border-color: var(--blue);
  }

  .leistungs-links :global(.icon) {
    color: var(--blue);
  }

  @media (max-width: 1000px) {
    .staedte {
      grid-template-columns: minmax(0, 1fr);
    }

    .gebiet-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .kreise {
      columns: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stadt-karte,
    .stadt-karte:hover {
      transition: none;
      transform: none;
    }
  }
</style>
