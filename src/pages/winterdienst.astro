---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { fotos } from "../data/referenzen";
import { serviceFaq } from "../data/faq";

const current = "/winterdienst/";
---

<ServiceDetailPage
  current={current}
  crumb="Winterdienst"
  metaTitle="Fixum Objektservice: Winterdienst & Außenanlagen Emden"
  description="Winterdienst in Emden und Ostfriesland: Räum- und Streupflicht zuverlässig erfüllt, mit schriftlich festgelegten Flächen und Einsatzzeiten."
  eyebrow="Winterdienst & Außenanlagen"
  title="Winterdienst und Pflege der Außenanlagen"
  heroText="Fixum Objektservice übernimmt Winterdienst und Pflege der Außenanlagen in Emden und Ostfriesland. Für Eigentümer, Hausverwaltungen und Gewerbe - mit schriftlich festgelegten Flächen, Einsatzzeiten und Streumitteln."
  image={fotos.rasterdecke.pfad}
  imageAlt={fotos.rasterdecke.alt}
  serviceType="Winterdienst und Außenanlagenpflege"
  areaTitle="Winterdienst in Emden und Ostfriesland"
  lead="Als Eigentümer oder Verwaltung haften Sie für geräumte Wege - auch dann, wenn Sie selbst nicht vor Ort sind. Eine schriftliche Vereinbarung überträgt diese Pflicht im festgelegten Umfang und macht sie überprüfbar."
  included={[
    "Räumen und Streuen der vereinbarten Gehwege, Zufahrten und Zugänge",
    "Einsatzzeiten schriftlich festgelegt - werktags und an Sonn- und Feiertagen",
    "Nachräumen bei anhaltendem Schneefall",
    "Bereitstellung und Lagerung der vereinbarten Streumittel",
    "Dokumentation der Einsätze auf Wunsch",
    "Laubbeseitigung, Grünpflege und einfache Außenarbeiten",
    "Kombinierbar mit laufendem Hausmeisterservice",
  ]}
  process={[
    [
      "Anfrage",
      "Sie nennen Objekt, betroffene Flächen und den gewünschten Beginn der Saison.",
    ],
    [
      "Flächen festlegen",
      "Wir gehen das Objekt durch und legen fest, welche Wege, Zufahrten und Zugänge in welchem Umfang betreut werden.",
    ],
    [
      "Vereinbarung",
      "Flächen, Einsatzzeiten, Streumittel und Konditionen kommen schriftlich hinein - das ist die Grundlage der Haftungsübertragung.",
    ],
    [
      "Saisonbetrieb",
      "Wir räumen und streuen wie vereinbart, räumen bei anhaltendem Schneefall nach und dokumentieren die Einsätze auf Wunsch.",
    ],
  ]}
  facts={[
    ["Zeiten", "Werktags bis 7 Uhr, sonn- und feiertags bis 9 Uhr."],
    ["Umfang", "Flächen und Streumittel schriftlich festgelegt."],
    ["Nachweis", "Einsatzdokumentation auf Wunsch."],
    ["Sommer", "Grünpflege und Laubbeseitigung ergänzbar."],
  ]}
  noteTitle="Haftung sauber geregelt"
  noteText="Die Räum- und Streupflicht geht nur in dem Umfang auf uns über, der schriftlich vereinbart ist - deshalb halten wir Flächen, Zeiten und Streumittel so genau fest. Was nicht in der Vereinbarung steht, bleibt in Ihrer Verantwortung. Das klingt kleinlich, ist im Schadensfall aber genau der Punkt, auf den es ankommt."
  beispiele={[
    [
      "Gehweg vor dem Mehrfamilienhaus",
      "Räumen und Streuen der vereinbarten Gehwege und Zugänge, Nachräumen bei anhaltendem Schneefall.",
    ],
    [
      "Zufahrt und Parkplatz",
      "Zufahrten und Stellflächen nach Vereinbarung, damit Mieter, Kunden und Lieferanten sicher ankommen.",
    ],
    [
      "Außenanlagen im Sommer",
      "Laubbeseitigung, Grünpflege und einfache Außenarbeiten als Ergänzung.",
    ],
  ]}
  beispieleTitel="Typische Einsätze im Winterdienst"
  vorteile={[
    [
      "Haftung schriftlich geregelt",
      "Flächen, Zeiten und Streumittel stehen in der Vereinbarung.",
    ],
    ["Einsätze dokumentiert", "Auf Wunsch mit Nachweis über jeden Einsatz."],
    ["Kombinierbar", "Mit laufendem Hausmeisterservice in einer Vereinbarung."],
    ["Fester Ansprechpartner", "Ein Kontakt für Winter und Sommer."],
  ]}
  preis={["hausmeister"]}
  faq={serviceFaq[current]}
/>
