---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/entkernung-trockenbau/";
---

{
  /*
  Kombiseite: bewusst auf das Paket "Rückbau + Ausbau in einem Auftrag"
  ausgerichtet und nicht auf die Einzelkeywords - dafür gibt es
  /entkernung-rueckbau/ und /trockenbau-innenausbau/.
*/
}
<ServiceDetailPage
  current={current}
  crumb="Rückbau + Trockenbau"
  metaTitle="Rückbau und Trockenbau kombiniert | Fixum Objektservice Emden"
  description="Entkernung und Trockenbau in einem Auftrag: ein Betrieb, ein Angebot, keine Wartetage zwischen den Gewerken. Für Modernisierungen in Emden und Ostfriesland."
  eyebrow="Rückbau + Trockenbau"
  title="Rückbau und Trockenbau in einem Durchgang"
  heroText="Der teuerste Teil einer Modernisierung ist selten die Arbeit - es sind die Tage dazwischen. Wenn Rückbau und Ausbau in einer Hand liegen, entfallen sie."
  image="/images/service-drywall.png"
  imageAlt="Rückbau und anschließender Trockenbau in einem Objekt in Emden"
  serviceType="Kombinierter Rückbau und Trockenbau"
  areaTitle="Rückbau und Ausbau in Emden und Ostfriesland"
  lead="Diese Kombination ist der häufigste Fall bei uns: Alte Böden, Wände und Einbauten müssen raus, danach entstehen neue Wände, Decken und Flächen. Beides mit demselben Team, in einem Angebot und ohne Übergabetermin zwischen zwei Firmen."
  included={[
    "Nicht-tragender Rückbau von Wänden, Böden, Decken und Einbauten",
    "Sortenreine Trennung und Entsorgung des Rückbaumaterials",
    "Direkt anschließend Ständerwände, Vorsatzschalen und abgehängte Decken",
    "Dachschrägen, Schallschutzaufbauten und Spachtelung Q1 bis Q3",
    "Ein Angebot mit getrennt ausgewiesenen Positionen für beide Gewerke",
    "Eine Baustelleneinrichtung, ein Staubschutzkonzept, ein Ansprechpartner",
    "Koordination zugelassener Fachbetriebe für Elektro, Sanitär und Heizung",
  ]}
  process={[
    [
      "Gemeinsames Aufmaß",
      "Rückbauumfang und Ausbauziel werden in einem Termin aufgenommen. Dadurch passt der Ausbau exakt auf das, was der Rückbau hinterlässt.",
    ],
    [
      "Rückbau",
      "Alte Bauteile kommen kontrolliert raus, das Material wird direkt getrennt. Die Fläche wird für den Ausbau vorbereitet, nicht nur geräumt.",
    ],
    [
      "Ausbau ohne Wartetag",
      "Sobald der Rückbau steht, beginnt der Trockenbau - dasselbe Team, kein Übergabetermin, keine Diskussion über Vorschäden.",
    ],
  ]}
  facts={[
    ["Vorteil", "Kein Wartetag zwischen Rückbau und Ausbau."],
    ["Angebot", "Ein Dokument, Positionen getrennt ausgewiesen."],
    ["Haftung", "Ein Betrieb - keine Zuständigkeitsfragen bei Schäden."],
    ["Flexibel", "Einzelpositionen streichbar, ohne neu zu kalkulieren."],
  ]}
  noteTitle="Auch einzeln buchbar"
  noteText="Wenn Sie nur den Rückbau brauchen oder nur den Ausbau, ist das genauso in Ordnung - dafür gibt es die Seiten zu Entkernung und Trockenbau. Der Vorteil dieser Kombination liegt in der Schnittstelle, nicht in einem Zwang zum Gesamtpaket. Steht die Modernisierung eines kompletten Objekts an, ist die Seite zur Kernsanierung der passendere Einstieg."
  faq={serviceFaq[current]}
/>
