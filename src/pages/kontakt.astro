---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import WhatsAppMark from "../components/WhatsAppMark.astro";
import { mailUrl, site, telUrl, whatsappUrl } from "../data/site";

const path = "/kontakt/";
const breadcrumbs: Array<[string, string]> = [["Kontakt", path]];

const channels: Array<[string, string, string, "phone" | "whatsapp" | "mail"]> =
  [
    ["Telefon", site.phoneDisplay, telUrl, "phone"],
    [
      "WhatsApp",
      "Fotos direkt schicken",
      whatsappUrl("Moin, ich habe eine Anfrage zu:"),
      "whatsapp",
    ],
    ["E-Mail", site.email, mailUrl, "mail"],
  ];
---

<Base
  title="Kontakt & Besichtigung | Fixum Objektservice Emden"
  description="Kontakt zu Fixum Objektservice in Emden: Telefon, WhatsApp, E-Mail und Anfrageformular. Kostenlose Besichtigung meist innerhalb von zwei Werktagen."
  canonical={path}
  breadcrumbs={breadcrumbs}
  pageType="ContactPage"
>
  <section class="section contact-page page-top section--mist">
    <div class="container">
      <Breadcrumbs trail={breadcrumbs} class="contact-crumbs" />

      <div class="split split--top contact-grid">
        <div class="stack contact-copy" data-reveal>
          <p class="eyebrow">Direkt erreichbar</p>
          <h1>Kontakt und kostenlose Besichtigung</h1>
          <p class="lead">
            Rufen Sie an, schreiben Sie per WhatsApp oder senden Sie eine
            Anfrage. Wenn es eilig ist, ist Telefon der schnellste Weg - meist
            gibt es schon am Telefon eine erste Einschätzung.
          </p>

          <ul class="channels">
            {
              channels.map(([label, value, href, icon]) => (
                <li>
                  <a
                    href={href}
                    {...(href.startsWith("http")
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {icon === "whatsapp" ? (
                      <WhatsAppMark size={44} class="channel-mark" />
                    ) : (
                      <span class="channel-icon">
                        <Icon name={icon} size={20} />
                      </span>
                    )}
                    <span class="channel-text">
                      <small>{label}</small>
                      <strong>{value}</strong>
                    </span>
                    <span class="channel-arrow" aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="card contact-facts">
            <h2>Anfahrt und Erreichbarkeit</h2>
            <address>
              <strong>{site.name}</strong><br />
              {site.street}<br />
              {site.zip}
              {site.city}
            </address>
            <dl>
              <div>
                <dt><Icon name="clock" size={16} /> Zeiten</dt>
                <dd>{site.hours}</dd>
              </div>
              <div>
                <dt><Icon name="pin" size={16} /> Einsatzgebiet</dt>
                <dd>{site.city} und rund {site.radiusKm} km Umkreis</dd>
              </div>
              <div>
                <dt><Icon name="euro" size={16} /> Besichtigung</dt>
                <dd>Kostenlos und unverbindlich, meist in zwei Werktagen</dd>
              </div>
            </dl>
            <p class="facts-note">
              Ein Besuch am Firmensitz ist nur nach Absprache sinnvoll - wir
              sind tagsüber auf den Objekten unterwegs.
            </p>
          </div>
        </div>

        <div class="contact-form-col" data-reveal>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-crumbs {
    margin-bottom: 1.5rem;
  }

  .contact-grid {
    align-items: start;
  }

  .contact-copy {
    gap: 1.25rem;
  }

  /* Das Formular bleibt beim Scrollen sichtbar, solange die linke Spalte läuft. */
  @media (min-width: 901px) {
    .contact-form-col {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  /* ---- Kontaktkanäle ---- */
  .channels {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .channels a:hover {
    transform: translateY(-2px);
    border-color: var(--blue-light);
    box-shadow: var(--shadow-sm);
  }

  .channel-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: #fff;
    background: linear-gradient(160deg, var(--blue-bright), var(--blue));
  }

  .channel-text {
    display: grid;
    gap: 1px;
  }

  .channel-text small {
    font-family: var(--font-utility);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .channel-text strong {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--navy);
  }

  .channel-arrow {
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--blue);
    border-right: 2px solid var(--blue);
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease-out);
  }

  .channels a:hover .channel-arrow {
    transform: rotate(45deg) translate(2px, -2px);
  }

  /* ---- Faktenkarte ---- */
  .contact-facts {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .contact-facts h2 {
    margin-bottom: 1rem;
    font-size: var(--step-2);
    text-transform: none;
  }

  .contact-facts address {
    margin-bottom: 1.25rem;
    font-style: normal;
    line-height: 1.6;
    color: var(--muted);
  }

  .contact-facts address strong {
    color: var(--navy);
  }

  .contact-facts dl {
    display: grid;
    gap: 0.875rem;
    margin: 0 0 1rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--line);
  }

  .contact-facts dt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-utility);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .contact-facts dd {
    margin: 0.15rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .facts-note {
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
