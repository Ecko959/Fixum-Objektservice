---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/entkernung/";
---

<ServiceDetailPage
  current={current}
  crumb="Entkernung"
  metaTitle="Fixum Objektservice: Entkernung & Rückbau Emden"
  description="Entkernung und Rückbau in Emden und Ostfriesland: Böden, Trennwände, Decken, Einbauten raus, sortenrein getrennt. Festpreis nach Besichtigung."
  eyebrow="Entkernung & Rückbau"
  title="Entkernung und nicht-tragender Rückbau"
  heroText="Fixum Objektservice entkernt Wohnungen und Häuser in Emden und Ostfriesland: alte Böden, nicht-tragende Wände, Deckenverkleidungen und Einbauten kommen raus, sortenrein getrennt. Für Eigentümer, Hausverwaltungen und Bauunternehmen vor Sanierung oder Neuausbau."
  image="/images/categories/entkernung-rueckbau.png"
  imageAlt="Rückbau in einem Altbau: alte Dielen und Bodenbelag gestapelt, Staubschutz vor der Tür (Symbolbild)"
  serviceType="Entkernung und nicht-tragender Rückbau"
  areaTitle="Entkernung in Emden und Ostfriesland"
  lead="Entkernung heißt bei Fixum: klare Grenzen, keine Eingriffe in die Statik, keine Schadstoffsanierung und keine Anschlussarbeiten an Strom, Wasser oder Heizung. Alles andere räumen wir kontrolliert zurück."
  included={[
    "Nicht-tragende Trennwände, Vorsatzschalen und Einbauten entfernen",
    "Alte Bodenbeläge, Estrichaufbauten, Paneele und Deckenverkleidungen zurückbauen",
    "Sanitärobjekte und Küchen demontieren (ohne Trennung der Anschlüsse)",
    "Schutt, Holz, Metall und Mischabfälle direkt vor Ort sortenrein trennen",
    "Staubschutz, Abdeckung von Fluchtwegen und Schutz angrenzender Bereiche",
    "Abtransport und Entsorgung mit Nachweis auf Wunsch",
    "Direkte Vorbereitung für Trockenbau, Boden oder Fachbetriebe",
  ]}
  process={[
    [
      "Anfrage",
      "Sie schildern Objekt, Baujahr und geplanten Umfang. Fotos der betroffenen Räume helfen bei der ersten Einschätzung.",
    ],
    [
      "Bestandsaufnahme und Festpreis",
      "Vor Ort ordnen wir Materialien, Leitungsverläufe und tragende Bauteile ein. Das Angebot benennt auch, was ausdrücklich nicht dazugehört.",
    ],
    [
      "Rückbau",
      "Nicht-tragende Bauteile werden kontrolliert entfernt, Staubschutz gestellt und das Material direkt nach Fraktionen getrennt gesammelt.",
    ],
    [
      "Übergabe",
      "Die Fläche wird besenrein und ausbaufertig übergeben. Auf Wunsch folgt Trockenbau, Boden oder Montage durch dasselbe Team.",
    ],
  ]}
  facts={[
    ["Umfang", "Alles nicht-tragende - Statik bleibt unangetastet."],
    ["Entsorgung", "Sortenrein getrennt, Vorteil landet im Angebot."],
    ["Schadstoffe", "Bei Verdacht sofortiger Stopp, Fachbetrieb übernimmt."],
    ["Anschluss", "Ausbau kann direkt weiterlaufen."],
  ]}
  noteTitle="Keine Statik, keine Schadstoffe"
  noteText="Bei Verdacht auf Asbest, KMF, PAK-Kleber oder andere Schadstoffe stoppen wir den betroffenen Bereich sofort - das gilt besonders bei Gebäuden vor 1993. Tragende Bauteile, Elektro, Sanitär und Heizung gehören zugelassenen Fachbetrieben. Beides steht in jedem Angebot, damit es hinterher keine Diskussion gibt."
  beispiele={[
    [
      "Altbau vor der Sanierung",
      "Alte Bodenbeläge, abgehängte Decken und Paneele kommen raus, damit Fachbetriebe und Ausbau auf einer sauberen Fläche starten.",
    ],
    [
      "Grundriss öffnen",
      "Nicht-tragende Trennwände und Vorsatzschalen werden entfernt, wenn Räume zusammengelegt werden sollen. Tragende Wände bleiben unangetastet.",
    ],
    [
      "Bad oder Küche zurückbauen",
      "Sanitärobjekte, Einbauten und Küche werden demontiert - nachdem ein Fachbetrieb die Anschlüsse getrennt hat.",
    ],
    [
      "Haus nach der Entrümpelung entkernen",
      "Ist das Haus geräumt, geht es mit dem Rückbau direkt weiter: dasselbe Team, ein Angebot mit getrennten Positionen.",
    ],
    [
      "Modernisierung beim Mieterwechsel",
      "Für Hausverwaltungen: alte Beläge und Einbauten raus, danach Trockenbau und Boden - ohne Wartezeit zwischen zwei Firmen.",
    ],
    [
      "Rückbau als Nachunternehmer",
      "Für Bauunternehmen nach m²-Preis oder Tagessatz, mit sortenreiner Trennung direkt auf der Baustelle.",
    ],
  ]}
  vorteile={[
    [
      "Klare Grenzen",
      "Keine Eingriffe in die Statik, keine Schadstoffsanierung - bei Verdacht stoppen wir sofort.",
    ],
    [
      "Sortenreine Trennung vor Ort",
      "Holz, Metall, Bauschutt und Restmüll getrennt statt im Mischcontainer.",
    ],
    [
      "Ausbau direkt im Anschluss",
      "Trockenbau, Boden und Montage durch dasselbe Team, ohne Übergabe zwischen Firmen.",
    ],
    [
      "Ein Angebot, getrennte Positionen",
      "Sie sehen, was Rückbau, Entsorgung und Ausbau jeweils kosten.",
    ],
  ]}
  preis={["entkernung"]}
  preisText="Für die Entkernung nennen wir keinen pauschalen Richtwert: Fläche, Bauteile, Bodenaufbau und Entsorgungsmengen unterscheiden sich von Objekt zu Objekt zu stark. Sie bekommen nach der kostenlosen Besichtigung einen Festpreis."
  kette="rueckbauen"
  faq={serviceFaq[current]}
/>
