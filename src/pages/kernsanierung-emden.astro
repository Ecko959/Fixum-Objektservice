---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/kernsanierung-emden/";
---

<ServiceDetailPage
  current={current}
  crumb="Kernsanierung vorbereiten"
  metaTitle="Kernsanierung vorbereiten in Emden | Fixum Objektservice"
  description="Kernsanierung vorbereiten in Emden und Ostfriesland: räumen, zurückbauen, ausbauen - aus einer Hand, inklusive Koordination der Fachbetriebe."
  eyebrow="Kernsanierung vorbereiten"
  title="Kernsanierung in Emden vorbereiten"
  heroText="Wir übernehmen die Vorbereitung einer Kernsanierung komplett: räumen, zurückbauen, ausbauen und die Fachbetriebe so takten, dass niemand wartet."
  image="/images/categories/kernsanierung-vorbereiten.png"
  imageAlt="Objekt in Vorbereitung für eine Kernsanierung in Ostfriesland"
  serviceType="Vorbereitung von Kernsanierungen"
  areaTitle="Kernsanierungen in Emden und Ostfriesland"
  lead="Bei einer Kernsanierung liegt das Risiko selten in den einzelnen Gewerken, sondern zwischen ihnen. Wir übernehmen die Bausteine, die man nicht zulassungspflichtig ausführen muss - und die Terminplanung, die alles zusammenhält."
  included={[
    "Vollständige Räumung des Objekts inklusive Keller und Nebenräume",
    "Nicht-tragender Rückbau bis zur ausbaufertigen Fläche",
    "Sortenreine Trennung und Entsorgung mit Nachweis",
    "Trockenbau: Wände, Decken, Dachschrägen, Spachtelung Q1 bis Q3",
    "Bodenverlegung, Türen, Zargen und Möbelmontage zum Abschluss",
    "Koordination zugelassener Fachbetriebe für Elektro, Sanitär und Heizung",
    "Terminplanung mit definierten Übergabepunkten zwischen den Gewerken",
  ]}
  process={[
    [
      "Anfrage",
      "Sie schildern Objekt, Baujahr und Ziel. Bei ganzen Objekten lohnt der Termin vor Ort früh.",
    ],
    [
      "Objektaufnahme und Ablaufplan",
      "Wir nehmen den Bestand auf, klären Schadstoffrisiken und legen fest, welches Gewerk wann gebraucht wird - mit definierten Übergabepunkten.",
    ],
    [
      "Räumen und Rückbau",
      "Das Objekt wird geräumt und nicht-tragend zurückgebaut. Danach folgen die Fachbetriebe für Leitungen zum abgestimmten Termin.",
    ],
    [
      "Ausbau und Übergabe",
      "Trockenbau, Boden und Montage schließen an. Sie bekommen ein Objekt, das nutzbar oder vermietbar ist.",
    ],
  ]}
  facts={[
    ["Rolle", "Vorbereitung und Ausbau, nicht Generalunternehmer."],
    ["Koordination", "Fachbetriebe getaktet, Übergabepunkte definiert."],
    ["Umfang", "Von der Räumung bis zur montierten Tür."],
    ["Transparenz", "Positionen im Angebot einzeln ausgewiesen."],
  ]}
  noteTitle="Wir sind nicht der Generalunternehmer"
  noteText="Das sagen wir bewusst deutlich: Wir übernehmen die Vorbereitung und den Ausbau, nicht die Gesamtverantwortung für ein schlüsselfertiges Objekt. Strom, Wasser, Heizung, Statik, Fenster, Dach und Schadstoffe liegen bei zugelassenen Fachbetrieben. Wir koordinieren die Termine, damit die Gewerke ineinandergreifen - die Ausführung bleibt aber dort, wo die Zulassung liegt."
  faq={serviceFaq[current]}
/>
