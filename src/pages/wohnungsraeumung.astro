---
import ServiceDetailPage from "../components/ServiceDetailPage.astro";
import { serviceFaq } from "../data/faq";

const current = "/wohnungsraeumung/";
---

<ServiceDetailPage
  current={current}
  crumb="Wohnungsräumung"
  metaTitle="Wohnungsräumung Emden - besenrein zur Übergabe | Fixum"
  description="Wohnungsräumung in Emden und Ostfriesland für Übergabe, Mieterwechsel, Verkauf oder Neuvermietung. Besenreine Übergabe zum Festpreis, auf Wunsch mit Fotodokumentation zur Abnahme."
  eyebrow="Wohnungsräumung"
  title="Wohnungsräumung für die Übergabe"
  heroText="Wenn eine Wohnung zu einem festen Termin leer und übergabefähig sein muss, planen wir rückwärts vom Termin - nicht vorwärts von der Auslastung."
  image="/images/categories/wohnungsraeumung.png"
  imageAlt="Besenrein geräumte Wohnung nach Übergabe durch Fixum Objektservice"
  serviceType="Wohnungsräumung"
  areaTitle="Wohnungsräumung in Emden und Ostfriesland"
  lead="Für Vermieter, Hausverwaltungen, Eigentümer und Mieter, die aus einer Wohnung eine übergabefähige Einheit machen müssen - meist unter Zeitdruck und mit einem Abnahmetermin im Kalender."
  included={[
    "Vollständige Räumung von Wohnung, Keller, Dachboden und Nebenräumen",
    "Demontage von Einbauschränken, Lampen, Bodenbelägen und Regalen",
    "Sortenreine Trennung und Entsorgung nach Fraktionen",
    "Besenreine Übergabe im vereinbarten Zustand",
    "Fotodokumentation vor, während und nach der Räumung auf Wunsch",
    "Terminplanung rückwärts vom festen Übergabetermin",
    "Auf Wunsch direkt anschließend Rückbau, Trockenbau oder Bodenverlegung",
  ]}
  process={[
    [
      "Termin melden",
      "Sie nennen den Übergabetermin und den Zustand der Wohnung. Wir prüfen sofort, ob der Tag machbar ist - und sagen ab, wenn nicht.",
    ],
    [
      "Aufnahme und Festpreis",
      "Wir dokumentieren den Ist-Zustand, klären Demontagen und halten im Angebot fest, was besenrein hier konkret bedeutet.",
    ],
    [
      "Räumung",
      "Räumung, Demontage von Einbauten und Bodenbelägen, sortenreine Entsorgung - eine durchschnittliche Wohnung an einem Tag.",
    ],
    [
      "Abnahme",
      "Besenreine Übergabe zum vereinbarten Termin, auf Wunsch mit Fotodokumentation als Grundlage für die Abnahme.",
    ],
  ]}
  facts={[
    ["Dauer", "Eine durchschnittliche Wohnung an einem Tag."],
    ["Termine", "Rückwärts vom Übergabetermin geplant."],
    ["Nachweis", "Fotodokumentation für die Abnahme auf Wunsch."],
    ["Anschluss", "Rückbau und Ausbau direkt danach möglich."],
  ]}
  noteTitle="Besenrein ist nicht gleich renoviert"
  noteText="Besenrein heißt: vollständig leer, grob gefegt und übergabefähig. Feuchtreinigung, Fensterputz, Malerarbeiten oder Bodenerneuerung sind nicht automatisch enthalten - lassen sich aber dazubuchen. Was genau vereinbart ist, steht im Angebot, damit es bei der Abnahme keine Diskussion mit dem Vermieter gibt."
  faq={serviceFaq[current]}
/>
