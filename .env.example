# Anfrageformular (api/anfrage.ts) - Versand über das IONOS-Postfach.
# In Vercel unter Settings -> Environment Variables setzen (Production und
# Preview), danach neu deployen. Lokal nur zum Testen nötig.
SMTP_HOST=smtp.ionos.de
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=465
# optional: true/false - ohne Angabe true bei Port 465
SMTP_SECURE=
SMTP_USER=info@fixum-objektservice.de
SMTP_PASS=
CONTACT_TO=info@fixum-objektservice.de
CONTACT_FROM="Fixum Objektservice <info@fixum-objektservice.de>"
